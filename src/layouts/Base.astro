---
import { Font } from 'astro:assets';
import Seo from '@/components/Seo.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import WhatsAppFloat from '@/components/ui/WhatsAppFloat.astro';
import ScrollWidgets from '@/components/ui/ScrollWidgets.astro';
import CookieBanner from '@/components/ui/CookieBanner.astro';
import { site } from '@/config/site';
import { graph } from '@/lib/schema';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  schema?: object[];
  overlay?: boolean;
  preloadFont?: boolean;
}

const { schema = [], overlay = false, preloadFont = false, ...seo } = Astro.props;
const gtm = `(function(w,d,i){w.dataLayer=w.dataLayer||[];var ev=['scroll','pointerdown','keydown','touchstart','mousemove'],done=false;function load(){if(done)return;done=true;ev.forEach(function(e){w.removeEventListener(e,load)});w.dataLayer.push({'gtm.start':new Date().getTime(),event:'gtm.js'});var j=d.createElement('script');j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i;d.head.appendChild(j)}ev.forEach(function(e){w.addEventListener(e,load,{passive:true})});w.addEventListener('load',function(){setTimeout(load,5000)})})(window,document,'${site.gtmId}');`;
const loadGtm = import.meta.env.PROD;
// Google Consent Mode v2, antes de cargar Google Tag Manager: las cookies de medición y publicidad
// empiezan desactivadas para todos y solo se activan si la persona acepta (la elección guardada se aplica al instante).
const consent = `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}window.gtag=gtag;var D='denied',G='granted';gtag('consent','default',{ad_storage:D,ad_user_data:D,ad_personalization:D,analytics_storage:D,wait_for_update:500});gtag('set','ads_data_redaction',true);try{var c=localStorage.getItem('cc-consent');if(c){var v=c==='all'?G:D;gtag('consent','update',{ad_storage:v,ad_user_data:v,ad_personalization:v,analytics_storage:v})}}catch(e){}`;
import { pageKey } from '@/lib/page';
---

<!doctype html>
<html lang={site.lang} data-page={pageKey(Astro.url.pathname)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js');setTimeout(function(){var r=document.documentElement;if(!r.hasAttribute('data-reveal-ready'))r.classList.remove('js')},2500);</script>
    <meta name="theme-color" content={site.themeColor} />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {loadGtm && <link rel="dns-prefetch" href="https://www.googletagmanager.com" />}
    {preloadFont ? <Font cssVariable="--font-literata" preload={[{ style: 'normal' }]} /> : <Font cssVariable="--font-literata" />}
    <Seo {...seo} />
    <script type="application/ld+json" set:html={graph(schema)} />
    <script is:inline set:html={consent} />
    {loadGtm && <script is:inline set:html={gtm} />}
    <slot name="head" />
  </head>
  <body>
    {loadGtm && (
      <noscript>
        <iframe src={`https://www.googletagmanager.com/ns.html?id=${site.gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe>
      </noscript>
    )}
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header overlay={overlay} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <ScrollWidgets />
    <CookieBanner />
    <script>
      import '@/scripts/reveal';
      import '@/scripts/track';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    inset-block-start: var(--space-xs);
    inset-inline-start: var(--page-margin);
    z-index: var(--z-dialog);
    padding: var(--space-2xs) var(--space-s);
    background-color: var(--color-field);
    color: var(--color-on-field);
    transform: translateY(-200%);
  }
  .skip-link:focus-visible { transform: none; }
  main:focus { outline: none; }
</style>
