---
import Base from '@/layouts/Base.astro';
import FormCard from '@/components/forms/FormCard.astro';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';
import AdvisoryVideo from '@/components/sections/AdvisoryVideo.astro';
import { Image } from 'astro:assets';
import officeImg from '@/assets/images/otros/asesores-tesis-peru-cientifica.jpg';
import PageHero from '@/components/ui/PageHero.astro';
import { fullAddress, site } from '@/config/site';
import { planNames, planRows } from '@/data/plans';
import { advisoryVideo, breadcrumb } from '@/lib/schema';
import { capitalize } from '@/lib/format';

const address = fullAddress;
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${address}, Perú`)}`;
const schema = [breadcrumb([{ name: 'Inicio', path: '/' }, { name: 'Contáctanos', path: '/contactanos.html' }]), advisoryVideo()];
---

<Base
  preloadFont
  title="Asesoría de Tesis Personalizada | Contáctanos Hoy"
  description="Escríbenos para recibir asesoría profesional en tesis de pregrado, maestría o doctoral. Te respondemos en menos de 24 horas."
  schema={schema}
>
  <PageHero tone="field" title="¿Necesitas una asesoría de tesis en Lima? Contáctanos" crumb="Contáctanos" lede={`Te guiamos en tu tesis de pregrado, maestría, doctorado o segunda especialización. Escríbenos y te respondemos en ${site.replyTime}.`}>
    <div class="alt">
      <WhatsAppButton />
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <FormCard slot="media" title="¡Logra el sueño de graduarte con éxito!" subject="Web Principal - Contacto" />
  </PageHero>

  <section class="section-wide" aria-labelledby="planes">
    <div class="page stack stack-xl">
      <header class="split split-end" data-reveal>
        <h2 id="planes">Nuestros planes</h2>
        <p class="text-lead">Dos formas de trabajar tu tesis completa. Escríbenos y te enviamos un presupuesto según tu caso.</p>
      </header>
      <ul class="plans" role="list" data-reveal="stagger">
        {planNames.map((name, i) => (
          <li class:list={['plan', { featured: i === 1 }]}>
            <h3>{name}</h3>
            <ul class="features" role="list">
              {planRows.filter((r) => r.values[i] !== '—').map((r) => (
                <li><span class="feature-name">{r.feature}</span>{r.values[i]}</li>
              ))}
            </ul>
            <WhatsAppButton message={`Hola, quiero información sobre el ${name}.`} label="Quiero este plan" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="theme-surface section-wide" aria-labelledby="video">
    <div class="page stack stack-xl">
      <h2 id="video" data-reveal>Te guiamos paso a paso en tu proyecto de tesis</h2>
      <div class="video-frame"><AdvisoryVideo /></div>
    </div>
  </section>

  <section class="section-wide" aria-labelledby="horarios">
    <div class="page stack stack-xl">
      <h2 id="horarios" data-reveal>Horarios de atención y ubicación</h2>
      <div class="visit" data-reveal="stagger">
        <div class="visit-card">
          <h3>Horarios de atención</h3>
          <dl class="hours">
            {site.hours.map((h) => (
              <div>
                <dt>{h.days}</dt>
                <dd>{h.label}</dd>
              </div>
            ))}
          </dl>
        </div>
        <address class="visit-card">
          <h3>Ubicación</h3>
          <p>{address}</p>
          <p class="text-soft">{capitalize(site.address.reference)}. Atención presencial previa cita.</p>
          <a href={mapUrl} target="_blank" rel="noopener">Ver en Google Maps</a>
        </address>
        <Image src={officeImg} alt="Oficina de Científica Consultores en Los Olivos" widths={[480, 720, 960]} sizes="(min-width: 64em) 34vw, 100vw" class="office" />
      </div>
    </div>
  </section>
</Base>

<style>
  .alt { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-m); }
  .plans { display: grid; gap: var(--space-m); }
  .plan { display: grid; gap: var(--space-l); align-content: start; justify-items: start; padding: var(--space-xl) var(--space-l); background-color: var(--color-surface); border-radius: var(--radius-card); }
  .plan.featured { background-color: var(--navy-600); color: var(--paper-0); }
  .plan h3 { font-size: var(--step-head); line-height: var(--leading-head); font-weight: var(--weight-medium); letter-spacing: var(--tracking-head); }
  .features { display: grid; gap: var(--space-s); }
  .features li { display: grid; gap: var(--space-3xs); padding-inline-start: 1.75rem; position: relative; }
  .features li::before { content: ''; position: absolute; inset-inline-start: 0; inset-block-start: 0.35em; inline-size: 1rem; block-size: 1rem; border-radius: 50%; background-color: var(--orange-500); }
  .feature-name { font-size: var(--step-small); font-weight: var(--weight-semibold); color: var(--color-text-soft); }
  .featured .feature-name { color: var(--navy-100); }
  .video-frame { max-inline-size: 60rem; }
  .visit { display: grid; gap: var(--space-m); }
  .visit-card { display: grid; gap: var(--space-s); align-content: start; justify-items: start; padding: var(--space-l); background-color: var(--color-surface); border-radius: var(--radius-card); font-style: normal; }
  .visit-card h3 { font-size: var(--step-title); font-weight: var(--weight-medium); }
  .hours { display: grid; gap: var(--space-s); }
  .hours dt { color: var(--color-text-soft); font-size: var(--step-small); }
  .hours dd { font-size: var(--step-lead); }
  .office { inline-size: 100%; block-size: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-card); }

  @media (min-width: 48em) {
    .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .visit { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
