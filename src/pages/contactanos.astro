---
import Base from '@/layouts/Base.astro';
import LeadForm from '@/components/forms/LeadForm.astro';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';
import PhotoBand from '@/components/sections/PhotoBand.astro';
import AdvisoryVideo from '@/components/sections/AdvisoryVideo.astro';
import { Image } from 'astro:assets';
import officeImg from '@/assets/images/otros/asesores-tesis-peru-cientifica.jpg';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import { fullAddress, site } from '@/config/site';
import { planNames, planRows } from '@/data/plans';
import { breadcrumb } from '@/lib/schema';
import { capitalize } from '@/lib/format';

const address = fullAddress;
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${address}, Perú`)}`;
const schema = [breadcrumb([{ name: 'Inicio', path: '/' }, { name: 'Contáctanos', path: '/contactanos.html' }])];
---

<Base
  title="Asesoría de Tesis Personalizada | Contáctanos Hoy"
  description="Escríbenos para recibir asesoría profesional en tesis de pregrado, maestría o doctoral. Te respondemos en menos de 24 horas."
  schema={schema}
>
  <section class="section page hero" aria-labelledby="titulo">
    <div class="text">
      <Breadcrumbs current="Contáctanos" />
      <h1 id="titulo">Asesoría de tesis en Lima</h1>
      <p class="text-lead">Te guiamos en tu tesis de pregrado, maestría, doctorado o segunda especialización. Escríbenos y te respondemos en {site.replyTime}.</p>
      <div class="alt">
        <WhatsAppButton />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
    <div class="form theme-surface">
      <h2 class="text-lead text-strong">Envíanos un mensaje</h2>
      <LeadForm subject="Web Principal - Contacto" />
    </div>
  </section>

  <section class="section page plans" aria-labelledby="planes">
    <header class="head" data-reveal>
      <h2 id="planes">Nuestros planes</h2>
      <p>Dos formas de trabajar tu tesis completa. Escríbenos y te enviamos un presupuesto según tu caso.</p>
    </header>
    <div class="table-wrap" data-reveal>
      <table>
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Característica</span></th>
            {planNames.map((n) => <th scope="col">{n}</th>)}
          </tr>
        </thead>
        <tbody>
          {planRows.map((row) => (
            <tr>
              <th scope="row">{row.feature}</th>
              {row.values.map((v, i) => <td data-plan={planNames[i]}>{v}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section page watch" aria-label="Video de una asesoría">
    <AdvisoryVideo />
  </section>

  <PhotoBand omit={['office']} />

  <section class="section page visit" aria-labelledby="horarios">
    <h2 id="horarios" data-reveal>Horarios y ubicación</h2>
    <dl class="hours" data-reveal="stagger">
      {site.hours.map((h) => (
        <div>
          <dt>{h.days}</dt>
          <dd>{h.label}</dd>
        </div>
      ))}
    </dl>
    <address data-reveal>
      <p>{address}</p>
      <p class="text-soft">{capitalize(site.address.reference)}. Atención presencial previa cita.</p>
      <a href={mapUrl} target="_blank" rel="noopener">Ver en Google Maps</a>
    </address>
    <Image data-reveal src={officeImg} alt="Oficina de Científica Consultores en Los Olivos" widths={[480, 720]} sizes="(min-width: 64em) 30vw, 100vw" class="office" />
  </section>
</Base>

<style>
  .hero { display: grid; gap: var(--space-xl); }
  .text { display: grid; gap: var(--space-m); align-content: start; }
  .alt { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-m); }
  .alt a:not(.button) { overflow-wrap: anywhere; }
  .form { display: grid; gap: var(--space-m); padding: var(--space-m); align-content: start; }

  .plans { display: grid; gap: var(--space-l); }
  .head { display: grid; gap: var(--space-s); }
  table { inline-size: 100%; border-collapse: collapse; font-size: var(--step-body); line-height: var(--leading-small); }
  th, td { padding: var(--space-s); text-align: start; vertical-align: top; border-block-end: 1px solid var(--color-surface-strong); }
  thead th { font-size: var(--step-lead); line-height: var(--leading-lead); font-weight: var(--weight-semibold); }
  tbody th { font-weight: var(--weight-semibold); inline-size: 28%; }
  .office { inline-size: 100%; aspect-ratio: 4 / 3; object-fit: cover; }

  @media (max-width: 47.99em) {
    thead { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); }
    tr { display: grid; padding-block: var(--space-s); border-block-end: 1px solid var(--color-surface-strong); }
    th, td { display: block; padding: var(--space-3xs) 0; border: 0; inline-size: auto; }
    tbody th { inline-size: auto; }
    td::before { content: attr(data-plan); display: block; font-size: var(--step-small); color: var(--color-text-soft); }
  }

  .watch { display: grid; }
  @media (min-width: 64em) {
    .watch { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .watch :global(.video) { grid-column: calc(var(--axis) + 1) / -1; }
  }
  .visit { display: grid; gap: var(--space-l); }
  .hours { display: grid; gap: var(--space-s); }
  .hours dt { color: var(--color-text-soft); font-size: var(--step-small); }
  .hours dd { font-size: var(--step-lead); }
  address { font-style: normal; display: grid; gap: var(--space-2xs); justify-items: start; }

  @media (min-width: 64em) {
    .hero { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .text { grid-column: 1 / span 6; }
    .form { grid-column: 8 / -1; }
    .plans, .visit { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start; }
    .head, .visit h2 { grid-column: 1 / span 4; }
    .table-wrap { grid-column: 5 / -1; }
    .hours { grid-column: 5 / span 3; }
    address { grid-column: 8 / span 2; }
    .office { grid-column: 10 / -1; }
  }
</style>
