---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import FormCard from '@/components/forms/FormCard.astro';
import FormButton from '@/components/ui/FormButton.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import BrandPhoto from '@/components/ui/BrandPhoto.astro';
import Icon from '@/components/ui/Icon.astro';
import advisorImg from '@/assets/images/banner/asesora-de-tesis-Cientifica-Consultores.jpg';
import sessionImg from '@/assets/images/otros/equipo-de-asesores-en-reunion.jpg';
import { fullAddress, site, whatsappUrl } from '@/config/site';
import { planNames, planRows } from '@/data/plans';
import { advisoryVideo, breadcrumb } from '@/lib/schema';
import { capitalize } from '@/lib/format';

const address = fullAddress;
const mapQuery = encodeURIComponent(`${address}, Perú`);
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
const mapEmbed = `https://www.google.com/maps?q=${mapQuery}&z=16&output=embed`;
const telHref = `tel:${site.phone.e164}`;

const channels = [
  { icon: 'whatsapp', title: 'WhatsApp', text: site.phone.display, note: 'Respuesta más rápida', href: whatsappUrl(), cls: 'wa', external: true },
  { icon: 'mail', title: 'Correo', text: site.email, note: `Respondemos en ${site.replyTime}`, href: `mailto:${site.email}`, cls: 'mail', external: false },
  { icon: 'phone', title: 'Llamada', text: site.phone.display, note: 'Lunes a sábado', href: telHref, cls: 'call', external: false },
  { icon: 'map', title: 'Oficina', text: `${site.address.district}, Lima`, note: 'Atención previa cita', href: '#horarios', cls: 'office', external: false },
] as const;

const steps = [
  { title: 'Nos escribes', text: 'Por WhatsApp, correo o el formulario, con tu universidad y tu fecha.' },
  { title: 'Diagnóstico gratis', text: 'Revisamos tu tema, tus avances y el reglamento de tu facultad.' },
  { title: 'Presupuesto claro', text: 'Te enviamos una propuesta con alcances, plazos y forma de pago.' },
  { title: 'Tu asesor', text: 'Te asignamos un especialista de tu carrera y empezamos.' },
];

// Días del horario para marcar el de hoy y mostrar si está abierto ahora (hora de Lima)
const week = [
  { day: 'Lunes', d: 1, open: '09:00', close: '18:00' },
  { day: 'Martes', d: 2, open: '09:00', close: '18:00' },
  { day: 'Miércoles', d: 3, open: '09:00', close: '18:00' },
  { day: 'Jueves', d: 4, open: '09:00', close: '18:00' },
  { day: 'Viernes', d: 5, open: '09:00', close: '18:00' },
  { day: 'Sábado', d: 6, open: '09:00', close: '13:00' },
  { day: 'Domingo', d: 0, open: '', close: '' },
];
const label = (t: string) => { const [h, m] = t.split(':').map(Number); return `${((h + 11) % 12) + 1}:${String(m).padStart(2, '0')} ${h < 12 ? 'a. m.' : 'p. m.'}`; };

const schema = [breadcrumb([{ name: 'Inicio', path: '/' }, { name: 'Contáctanos', path: '/contactanos.html' }]), advisoryVideo()];
---

<Base
  preloadFont
  title="Contacto: Asesoría de Tesis en Lima | Científica Consultores"
  description="Escríbenos por WhatsApp, correo o formulario y recibe tu primera asesoría de tesis gratis. Oficina en Los Olivos, Lima, y atención online en 24 horas."
  schema={schema}
>
  <section class="c-hero custom-hero" aria-labelledby="titulo">
    <div class="page ch-grid">
      <div class="ch-copy">
        <Breadcrumbs current="Contáctanos" inline />
        <h1 id="titulo">Hablemos de <span class="ch-accent">tu tesis</span></h1>
        <p class="ch-lede">Escríbenos por el canal que prefieras. Un asesor te responde en {site.replyTime} y la primera asesoría es gratis.</p>
        <p class="ch-status" data-open-status><span class="dot" aria-hidden="true"></span><span data-open-text>Horario de atención</span></p>
        <ul class="channels" role="list">
          {channels.map((c) => (
            <li>
              <a class:list={['channel', c.cls]} href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener' : undefined}>
                <span class="ch-icon" aria-hidden="true"><Icon name={c.icon} size="1.1rem" /></span>
                <span class="ch-name">{c.title}<small>{c.note}</small></span>
                <span class="ch-value">{c.text}</span>
                <span class="ch-go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="ch-desk">
        <div class="advisor">
          <span class="advisor-ph"><Image src={advisorImg} alt="" width={480} class="advisor-img" /></span>
          <p><strong>Te atiende un asesor de tu carrera</strong><span>Déjanos tus datos y te escribimos por WhatsApp</span></p>
        </div>
        <FormCard title="Cuéntanos tu caso" subject="Web Principal - Contacto" variant="short" submitLabel="Quiero mi asesoría gratis" hint="Ej.: estudio Enfermería en la UPN, tengo el proyecto avanzado y sustento en julio." />
        <p class="desk-foot"><Icon name="shield" size="0.95rem" />Tus datos solo los usa tu asesor.</p>
      </div>
    </div>
  </section>

  <section class="section-wide" aria-labelledby="planes">
    <div class="page stack stack-xl">
      <header class="section-head center" data-reveal>
        <span class="eyebrow">Planes</span>
        <h2 id="planes">Elige cómo trabajar tu tesis</h2>
        <p>Dos planes de acompañamiento completo. Te enviamos el presupuesto según tu caso.</p>
      </header>

      <div class="compare" data-reveal>
        <div class="cmp-head">
          <div class="cmp-corner">Incluye</div>
          {planNames.map((name, i) => (
            <div class:list={['cmp-plan', { featured: i === 1 }]}>
              {i === 1 && <span class="badge">Recomendado</span>}
              <span class="cmp-name">{name}</span>
              <span class="cmp-sub">{i === 0 ? 'Lo esencial para titularte' : 'Acompañamiento total y equipo especialista'}</span>
            </div>
          ))}
        </div>
        <ul class="cmp-rows" role="list">
          {planRows.map((r) => (
            <li class="cmp-row">
              <span class="cmp-feature">{r.feature}</span>
              {r.values.map((v, i) => (
                <span class:list={['cmp-cell', { featured: i === 1, none: v === '—' }]}>
                  <span class="cmp-mobile">{planNames[i]}</span>
                  {v === '—' ? <span class="cmp-no" aria-label="No incluido">—</span> : <><span class="cmp-yes" aria-hidden="true"><Icon name="check" size="0.85rem" /></span><span>{v}</span></>}
                </span>
              ))}
            </li>
          ))}
        </ul>
        <div class="cmp-foot">
          <div class="cmp-corner"></div>
          <div class="cmp-cta"><FormButton label="Quiero este plan" /></div>
          <div class="cmp-cta featured"><FormButton label="Quiero este plan" icon /></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-wide" aria-labelledby="guia">
    <div class="page guide">
      <div data-reveal><BrandPhoto src={sessionImg} alt="Sesión de asesoría de tesis con el equipo de Científica Consultores" caption="Así trabajamos" ratio="4/3" /></div>
      <div class="guide-copy">
        <header data-reveal>
          <span class="eyebrow">Cómo empezamos</span>
          <h2 id="guia">Te guiamos paso a paso en tu proyecto de <a href="/tesis.html">tesis</a></h2>
        </header>
        <ol class="timeline" role="list" data-reveal="stagger">
          {steps.map((s, i) => (
            <li><span class="t-num">{i + 1}</span><div><h3>{s.title}</h3><p>{s.text}</p></div></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section-wide" aria-labelledby="horarios" id="horarios">
    <div class="page stack stack-xl">
      <header class="section-head center" data-reveal>
        <span class="eyebrow">Visítanos</span>
        <h2>Horarios de atención y ubicación</h2>
      </header>
      <div class="visit" data-reveal>
        <div class="map-box">
          <iframe src={mapEmbed} title={`Mapa: ${address}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        </div>
        <div class="visit-card">
          <div class="status" data-open-status><span class="dot" aria-hidden="true"></span><span data-open-text>Horario de atención</span></div>
          <ul class="week" role="list" data-week>
            {week.map((w) => (
              <li data-day={w.d} data-open={w.open} data-close={w.close}>
                <span>{w.day}</span>
                <span>{w.open ? `${label(w.open)} – ${label(w.close)}` : 'Cerrado'}</span>
              </li>
            ))}
          </ul>
          <address class="addr">
            <Icon name="map" size="1.1rem" />
            <span><strong>{address}</strong><small>{capitalize(site.address.reference)}. Atención presencial previa cita.</small></span>
          </address>
          <div class="visit-actions">
            <a class="v-btn primary" href={mapUrl} target="_blank" rel="noopener"><Icon name="map" size="1rem" />Cómo llegar</a>
            <a class="v-btn" href={whatsappUrl('Hola, quiero agendar una cita presencial en su oficina.')} target="_blank" rel="noopener"><Icon name="whatsapp" size="1rem" />Agendar cita</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Marca el día de hoy y si la oficina está abierta, con la hora de Lima
  const week = document.querySelector<HTMLElement>('[data-week]');
  const statuses = document.querySelectorAll<HTMLElement>('[data-open-status]');
  if (week && statuses.length) {
    const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Lima', weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date());
    const get = (t: string) => parts.find((p) => p.type === t)?.value ?? '';
    const day = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(get('weekday'));
    const now = `${get('hour').replace('24', '00')}:${get('minute')}`;
    const today = week.querySelector<HTMLElement>(`[data-day="${day}"]`);
    if (today) {
      today.classList.add('today');
      const { open = '', close = '' } = today.dataset;
      const isOpen = open !== '' && now >= open && now < close;
      statuses.forEach((status) => {
        status.classList.add(isOpen ? 'open' : 'closed');
        status.querySelector('[data-open-text]')!.textContent = isOpen ? `Abierto ahora · cierra a las ${close}` : 'Cerrado ahora · escríbenos y te respondemos';
      });
    }
  }
</script>

<style>
  /* Esta página ya tiene su propio mapa: el del pie no se repite */
  :global(body:has(#horarios .map-box) .footer .visit) { display: none; }
  /* Banner de contacto: claro, como un directorio de atención (estado en vivo + canales en lista) y un escritorio azul con el formulario */
  .c-hero { padding-block: var(--space-l) var(--space-xl); background-color: var(--paper-0); border-block-end: 1px solid var(--paper-2); }
  .ch-grid { display: grid; gap: var(--space-l); align-items: start; }
  .ch-copy { display: grid; gap: var(--space-s); justify-items: start; padding-block-start: var(--space-xs); }
  .ch-copy :global(.crumb-bar.inline ol) { background-color: var(--navy-50); box-shadow: none; }
  .ch-copy :global(.crumb-bar.inline a) { color: var(--navy-600); }
  .ch-copy :global(.crumb-bar.inline [aria-current='page']) { color: var(--navy-700); }
  .ch-copy :global(.crumb-bar.inline .sep), .ch-copy :global(.crumb-bar.inline a svg) { color: var(--orange-500); }
  .ch-copy h1 { color: var(--navy-700); font-size: clamp(2.4rem, 1.3rem + 2.2vw, 3.6rem); line-height: 1.02; letter-spacing: -0.03em; }
  .ch-accent { color: var(--orange-500); }
  .ch-lede { color: var(--ink-600); font-size: var(--step-lead); max-inline-size: 44ch; }
  .ch-status { display: inline-flex; align-items: center; gap: 0.5em; padding: 0.35rem 0.8rem; border-radius: var(--radius-pill); background-color: var(--orange-50); color: var(--orange-600); font-size: var(--step-small); font-weight: var(--weight-bold); }
  .ch-status .dot { inline-size: 0.5rem; block-size: 0.5rem; border-radius: 50%; background-color: currentColor; }
  .ch-status.open { background-color: rgb(37 211 102 / 0.12); color: #128c4a; }

  /* Canales como filas de un directorio, separadas por líneas */
  .channels { inline-size: 100%; margin-block-start: var(--space-xs); border-block-start: 1px solid var(--paper-2); }
  .channels li { border-block-end: 1px solid var(--paper-2); }
  .channel { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; column-gap: var(--space-s); padding: 0.85rem 0.25rem; border-radius: 0.6rem; color: var(--ink-900); text-decoration: none; transition: background-color var(--duration-ui) ease, padding var(--duration-ui) var(--ease-out); }
  .ch-icon { grid-row: span 2; display: grid; place-items: center; inline-size: 2.4rem; block-size: 2.4rem; border-radius: 0.75rem; color: var(--paper-0); }
  .wa .ch-icon { background-color: var(--whatsapp-500); color: var(--ink-900); }
  .mail .ch-icon { background-image: var(--gradient-brand); }
  .call .ch-icon { background-image: var(--gradient-warm); color: var(--ink-900); }
  .office .ch-icon { background-color: var(--navy-50); color: var(--navy-600); }
  .ch-name { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.6rem; font-weight: var(--weight-bold); }
  .ch-name small { color: var(--orange-600); font-size: 0.75rem; }
  .ch-value { grid-column: 2; overflow: hidden; color: var(--ink-600); font-size: var(--step-small); text-overflow: ellipsis; white-space: nowrap; }
  .ch-go { grid-column: 3; grid-row: 1 / span 2; color: var(--navy-600); font-weight: var(--weight-bold); transition: transform var(--duration-ui) var(--ease-out); }

  /* Escritorio de atención: panel azul con la asesora y el formulario blanco dentro */
  .ch-desk { display: grid; gap: var(--space-s); padding: var(--space-s); border-radius: calc(var(--radius-card) + 0.75rem); background-image: var(--gradient-brand); box-shadow: 0 40px 70px -40px rgb(20 31 102 / 0.7); }
  .advisor { display: flex; align-items: center; gap: var(--space-s); padding: var(--space-2xs) var(--space-xs) 0; color: var(--paper-0); }
  .advisor-ph { position: relative; flex-shrink: 0; overflow: hidden; inline-size: 3rem; block-size: 3rem; border-radius: 50%; box-shadow: 0 0 0 3px var(--orange-500); }
  .advisor-ph :global(.advisor-img) { position: absolute; inset-block-start: -0.2rem; inset-inline-start: -8.3rem; block-size: 7.8rem; inline-size: auto; max-inline-size: none; }
  .advisor p { display: grid; gap: 0.1rem; font-size: var(--step-ui); line-height: 1.3; }
  .advisor p > span { color: var(--navy-100); font-size: var(--step-small); }
  .ch-desk :global(.form-card) { max-inline-size: none; padding: var(--space-m); border-radius: var(--radius-card); background-color: var(--paper-0); color: var(--ink-900); box-shadow: none; }
  .ch-desk :global(.form-card > h2) { font-family: var(--font-display); font-size: var(--step-title); }
  .ch-desk :global(.form-card .button[type='submit']) { min-block-size: 3.2rem; border-radius: var(--radius-pill); background-image: var(--gradient-warm); color: var(--ink-900); font-weight: var(--weight-bold); }
  .desk-foot { display: flex; align-items: center; justify-content: center; gap: 0.45em; padding-block-end: var(--space-3xs); color: var(--navy-100); font-size: var(--step-small); }
  .desk-foot :global(svg) { color: var(--gold-400); }
  @media (min-width: 64em) {
    .ch-grid { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: var(--space-xl); }
    .ch-desk { padding: var(--space-m); }
  }

  /* Comparativa de planes */
  .compare { overflow: hidden; border-radius: calc(var(--radius-card) + 0.35rem); background-color: var(--paper-0); box-shadow: var(--shadow-card); }
  .cmp-head, .cmp-row, .cmp-foot { display: grid; grid-template-columns: minmax(0, 1fr); }
  .cmp-corner { display: none; }
  .cmp-plan { position: relative; display: grid; gap: 0.25rem; padding: var(--space-m); }
  .cmp-plan.featured { background-image: var(--gradient-brand); color: var(--paper-0); }
  .badge { position: absolute; inset-block-start: var(--space-s); inset-inline-end: var(--space-s); padding: 0.3em 0.8em; border-radius: var(--radius-pill); background-color: var(--orange-500); color: var(--ink-900); font-size: var(--step-small); font-weight: var(--weight-bold); }
  .cmp-name { font-family: var(--font-display); font-size: var(--step-title); font-weight: var(--weight-semibold); }
  .cmp-sub { color: var(--color-text-soft); font-size: var(--step-small); }
  .featured .cmp-sub { color: var(--navy-100); }
  .cmp-row { border-block-start: 1px solid var(--paper-2); }
  .cmp-feature { padding: var(--space-s) var(--space-m) 0; color: var(--navy-600); font-size: var(--step-ui); font-weight: var(--weight-bold); }
  .cmp-cell { display: flex; gap: 0.6rem; align-items: flex-start; padding: 0.6rem var(--space-m); font-size: var(--step-ui); line-height: 1.45; color: var(--ink-600); }
  .cmp-cell.featured { background-color: rgb(29 45 140 / 0.04); color: var(--ink-900); }
  .cmp-mobile { flex-shrink: 0; min-inline-size: 6.5rem; color: var(--color-text-soft); font-size: var(--step-small); font-weight: var(--weight-semibold); }
  .cmp-yes { display: grid; place-items: center; flex-shrink: 0; inline-size: 1.35rem; block-size: 1.35rem; border-radius: 50%; background-color: var(--orange-50); color: var(--orange-600); }
  .featured .cmp-yes { background-image: var(--gradient-warm); color: var(--ink-900); }
  .cmp-no { color: var(--paper-2); font-weight: var(--weight-bold); }
  .cmp-foot { border-block-start: 1px solid var(--paper-2); }
  .cmp-cta { padding: var(--space-m); }
  .cmp-cta :global(.button) { inline-size: 100%; border-radius: var(--radius-pill); gap: 0.5em; }
  .cmp-cta:not(.featured) :global(.button) { background-color: var(--paper-0); background-image: none; color: var(--navy-700); box-shadow: inset 0 0 0 1.5px var(--navy-600); }
  .cmp-cta.featured { background-color: rgb(29 45 140 / 0.04); }
  @media (min-width: 48em) {
    .cmp-head, .cmp-row, .cmp-foot { grid-template-columns: minmax(0, 3fr) minmax(0, 4fr) minmax(0, 4fr); }
    .cmp-corner { display: block; padding: var(--space-m); color: var(--color-text-soft); font-size: var(--step-small); font-weight: var(--weight-bold); letter-spacing: 0.06em; text-transform: uppercase; align-self: end; }
    .cmp-feature { padding: var(--space-s) var(--space-m); align-self: center; }
    .cmp-cell { padding: var(--space-s) var(--space-m); }
    .cmp-mobile { display: none; }
    .cmp-plan { padding: var(--space-l) var(--space-m) var(--space-m); }
  }

  /* Cómo empezamos */
  .guide { display: grid; gap: var(--space-l) var(--gutter); align-items: center; }
  .guide-copy { display: grid; gap: var(--space-m); }
  .guide-copy h2 { font-size: var(--step-head); margin-block-start: var(--space-2xs); }
  .guide-copy h2 a { color: var(--orange-600); text-decoration: none; }
  .timeline { position: relative; display: grid; gap: var(--space-s); }
  .timeline::before { content: ''; position: absolute; inset: 1rem auto 1rem 1.05rem; inline-size: 2px; background-image: linear-gradient(var(--orange-500), var(--navy-600)); }
  .timeline li { position: relative; display: flex; gap: var(--space-s); align-items: flex-start; }
  .t-num { position: relative; display: grid; place-items: center; flex-shrink: 0; inline-size: 2.2rem; block-size: 2.2rem; border-radius: 50%; background-color: var(--paper-0); color: var(--navy-700); font-weight: var(--weight-bold); box-shadow: 0 0 0 3px var(--orange-500); }
  .timeline h3 { font-size: var(--step-body); }
  .timeline p { color: var(--color-text-soft); font-size: var(--step-ui); }
  @media (min-width: 64em) { .guide { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); } }

  /* Horarios y ubicación */
  .visit { display: grid; overflow: hidden; border-radius: calc(var(--radius-card) + 0.35rem); background-color: var(--paper-0); box-shadow: var(--shadow-card); }
  .map-box { position: relative; min-block-size: 18rem; background-color: var(--navy-50); }
  .map-box iframe { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; border: 0; }
  .visit-card { display: grid; gap: var(--space-s); align-content: start; padding: var(--space-l); }
  .status { display: inline-flex; align-items: center; gap: 0.55em; inline-size: fit-content; padding: 0.45em 0.95em; border-radius: var(--radius-pill); background-color: var(--paper-1); color: var(--ink-600); font-size: var(--step-small); font-weight: var(--weight-bold); }
  .status .dot { inline-size: 0.55rem; block-size: 0.55rem; border-radius: 50%; background-color: var(--ink-600); }
  .status.open { background-color: #d9fdd3; color: #0b6b3a; }
  .status.open .dot { background-color: var(--whatsapp-500); box-shadow: 0 0 0 4px rgb(37 211 102 / 0.25); }
  .status.closed { background-color: var(--orange-50); color: var(--orange-600); }
  .status.closed .dot { background-color: var(--orange-500); }
  .week { display: grid; gap: 0.15rem; }
  .week li { display: flex; justify-content: space-between; gap: var(--space-s); padding: 0.45rem 0.7rem; border-radius: 0.6rem; font-size: var(--step-ui); color: var(--ink-600); }
  .week li span:last-child { font-variant-numeric: tabular-nums; }
  .week li.today { background-color: var(--navy-50); color: var(--navy-700); font-weight: var(--weight-bold); }
  .addr { display: flex; gap: 0.6rem; padding-block-start: var(--space-s); border-block-start: 1px solid var(--paper-2); font-style: normal; }
  .addr :global(svg) { flex-shrink: 0; margin-block-start: 0.15rem; color: var(--orange-500); }
  .addr span { display: grid; gap: 0.15rem; }
  .addr small { color: var(--color-text-soft); font-size: var(--step-small); }
  .visit-actions { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
