---
import Base from '@/layouts/Base.astro';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';
---

<Base
  title="Asesoría de Tesis Online con Expertos | Científica Consultores"
  description="Asesoría de tesis online para pregrado, maestría, doctorado y TSP. Un asesor especialista te acompaña desde el proyecto hasta la sustentación."
  noindex
>
  <section class="section page grid">
    <div class="before-axis">
      <h1>Asesoría de tesis online</h1>
    </div>
    <div class="on-axis flow flow-l">
      <p class="text-lead">Un asesor especialista te acompaña en tu tesis de pregrado, maestría, doctorado o TSP, desde el proyecto hasta la sustentación.</p>
      <WhatsAppButton />
      <p class="text-soft">Portada provisional de la Fase 3. La portada completa se construye en la Fase 4.</p>
    </div>
  </section>
</Base>
