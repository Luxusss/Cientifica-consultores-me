---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/home/Hero.astro';
import ServiceRows from '@/components/home/ServiceRows.astro';
import Process from '@/components/home/Process.astro';
import About from '@/components/home/About.astro';
import Universities from '@/components/home/Universities.astro';
import TestimonialQuote from '@/components/home/TestimonialQuote.astro';
import Stages from '@/components/home/Stages.astro';
import Guides from '@/components/home/Guides.astro';
import FaqText from '@/components/sections/FaqText.astro';
import ContactBand from '@/components/sections/ContactBand.astro';
import { homeFaq } from '@/data/faq';
import { testimonials } from '@/data/proof';
import { faqPage } from '@/lib/schema';
---

<Base
  title="Asesoría de Tesis Online con Expertos | Científica Consultores"
  description="Asesoría de tesis online con expertos en investigación. Apoyo en metodología, análisis y redacción para estudiantes de Latinoamérica y España."
  image="/og/cientifica-consultores.jpg"
  schema={[faqPage(homeFaq)]}
  overlay
>
  <Hero />
  <ServiceRows />
  <Process />
  <Universities />
  <About />
  <TestimonialQuote testimonials={testimonials.slice(0, 4)} />
  <Stages />
  <Guides />
  <FaqText items={homeFaq} />
  <ContactBand />
</Base>
