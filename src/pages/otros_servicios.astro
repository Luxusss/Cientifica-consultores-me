---
import { Image, Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/ui/PageHero.astro';
import FormButton from '@/components/ui/FormButton.astro';
import Icon from '@/components/ui/Icon.astro';
import ContactBand from '@/components/sections/ContactBand.astro';
import { otherServices } from '@/data/otherServices';
import { breadcrumb } from '@/lib/schema';
import { site, whatsappUrl } from '@/config/site';
import heroImg from '@/assets/images/banner/asesora-de-tesis-Cientifica-Consultores.jpg';

const schema = [
  breadcrumb([{ name: 'Inicio', path: '/' }, { name: 'Otros servicios', path: '/otros_servicios.html' }]),
  ...otherServices.map((g) => ({ '@type': 'Service', name: g.name, description: g.summary, provider: { '@id': `${site.url}/#organizacion` } })),
];
---

<Base
  title="Otros servicios de investigación | Científica Consultores"
  description="Revisiones sistemáticas, metaanálisis, planes de negocio, proyectos, trabajo de campo, análisis estadístico y corrección de estilo para tu investigación."
  schema={schema}
>
  <PageHero title="Otros servicios" crumb="Otros servicios" lede="Más allá de la tesis: apoyo en cada parte de tu investigación, de la idea al documento final." balance="photo" tint>
    <Fragment slot="title"><span class="h1-main">Otros</span> <span class="h1-tail">servicios</span></Fragment>
    <nav class="index" aria-label="Grupos de servicios">
      <ul role="list">
        {otherServices.map((g, i) => (
          <li>
            <a href={`#${g.id}`}>
              <span class:list={['idx-icon', i % 2 ? 'tone-6' : 'tone-1']} aria-hidden="true"><Icon name={g.icon} size="1.05rem" /></span>
              <span class="idx-text"><strong>{g.name}</strong><span>{g.items.length} servicios</span></span>
              <span class="idx-go" aria-hidden="true">↓</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <Picture slot="media" formats={['avif', 'webp']} quality={80} src={heroImg} alt="Asesora de tesis de Científica Consultores" widths={[960, 1280, 1570]} sizes="100vw" loading="eager" fetchpriority="high" />
  </PageHero>

  {otherServices.map((g, i) => (
    <section class="section-wide group" aria-labelledby={g.id}>
      <div class="page stack stack-xl">
        <header class="g-head" data-reveal>
          <div class="g-title">
            <span class:list={['g-icon', i % 2 ? 'tone-6' : 'tone-1']} aria-hidden="true"><Icon name={g.icon} size="1.5rem" /></span>
            <div>
              <span class="eyebrow">Servicio {String(i + 1).padStart(2, '0')} · {g.items.length} opciones</span>
              <h2 id={g.id}>{g.name}</h2>
            </div>
          </div>
          <div class="g-copy">
            <p class="summary">{g.summary}</p>
            <p class="for"><Icon name="user" size="1rem" />{g.forWho}</p>
          </div>
        </header>
        <ul class:list={['cards', `n-${g.items.length}`]} role="list" data-reveal="stagger">
          {g.items.map((item, k) => (
            <li class:list={['card', (i + k) % 2 ? 'tone-6' : 'tone-1']}>
              <div class="frame">
                <Image src={item.image} alt={item.alt} widths={[360, 540, 720]} sizes="(min-width: 64em) 30vw, (min-width: 40em) 45vw, 100vw" class="photo" />
                <span class="num">{String(k + 1).padStart(2, '0')}</span>
              </div>
              <div class="body">
                <h3>{item.name}</h3>
                <p>{item.text}</p>
                <div class="actions">
                  <a class="quote" href={whatsappUrl(`Hola, quiero cotizar el servicio de ${item.name.toLowerCase()} (${g.name.toLowerCase()}).`)} target="_blank" rel="noopener" data-analytics="cotizar_otro_servicio">
                    <Icon name="whatsapp" size="1rem" /> Cotizar
                  </a>
                  {item.href && <a class="more" href={item.href}>Ver servicio →</a>}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <ContactBand />
</Base>

<style>
  /* Índice del banner: tarjetas de vidrio con ícono y cantidad de servicios */
  .index ul { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr)); gap: var(--space-2xs); }
  .index a { display: flex; align-items: center; gap: 0.7rem; padding: 0.6rem 0.9rem 0.6rem 0.6rem; border-radius: var(--radius-card); background-color: rgb(255 255 255 / 0.08); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16); color: var(--paper-0); text-decoration: none; backdrop-filter: blur(8px); transition: background-color var(--duration-hover) ease, transform var(--duration-hover) var(--ease-out); }
  .idx-icon { display: grid; place-items: center; flex-shrink: 0; inline-size: 2.4rem; block-size: 2.4rem; border-radius: 0.8rem; background-image: var(--tone-grad); color: var(--paper-0); }
  .idx-text { display: grid; gap: 0.05rem; flex: 1; line-height: 1.2; }
  .idx-text strong { font-size: var(--step-ui); }
  .idx-text span { color: var(--navy-100); font-size: var(--step-small); }
  .idx-go { color: var(--gold-400); font-weight: var(--weight-bold); transition: transform var(--duration-hover) var(--ease-out); }

  /* Cada grupo: encabezado a todo el ancho y los servicios debajo, cada uno con su botón de cotizar */
  .g-head { display: grid; gap: var(--space-s) var(--gutter); align-items: end; padding-block-end: var(--space-m); border-block-end: 1px solid color-mix(in srgb, var(--navy-600) 14%, transparent); }
  .g-title { display: flex; align-items: center; gap: var(--space-s); }
  .g-icon { display: grid; place-items: center; flex-shrink: 0; inline-size: 3.6rem; block-size: 3.6rem; border-radius: 1.1rem; background-image: var(--tone-grad); color: var(--paper-0); box-shadow: 0 12px 24px -12px var(--tone); }
  .g-title h2 { font-size: var(--step-head); line-height: 1.1; margin-block-start: 0.35rem; }
  .g-copy { display: grid; gap: var(--space-xs); justify-items: start; }
  .summary { color: var(--color-text-soft); font-size: var(--step-lead); line-height: var(--leading-lead); max-inline-size: 62ch; }
  .for { display: inline-flex; align-items: center; gap: 0.5em; padding: 0.45em 0.9em; border-radius: var(--radius-pill); background-color: var(--orange-50); color: var(--orange-600); font-size: var(--step-small); font-weight: var(--weight-bold); }

  .cards { display: grid; gap: var(--space-m); grid-template-columns: 1fr; }
  .card { position: relative; isolation: isolate; display: grid; grid-template-rows: auto 1fr; border-radius: var(--radius-card); background-color: var(--paper-0); box-shadow: var(--shadow-card); transition: opacity var(--duration-reveal) var(--ease-expo), transform var(--duration-reveal) var(--ease-expo), translate var(--duration-ui) var(--ease-out), box-shadow var(--duration-ui) ease; }
  .frame { position: relative; overflow: hidden; border-start-start-radius: var(--radius-card); border-start-end-radius: var(--radius-card); }
  .photo { display: block; inline-size: 100%; aspect-ratio: 16 / 10; object-fit: cover; transition: transform var(--duration-reveal) var(--ease-out); }
  .num { position: absolute; inset-block-start: var(--space-xs); inset-inline-start: var(--space-xs); display: grid; place-items: center; inline-size: 2.3rem; block-size: 2.3rem; border-radius: 0.75rem; background-image: var(--tone-grad); color: var(--paper-0); font-size: var(--step-small); font-weight: var(--weight-bold); box-shadow: 0 8px 16px -8px rgb(0 0 0 / 0.5); }
  .body { display: grid; grid-template-rows: auto 1fr auto; gap: var(--space-2xs); padding: var(--space-m); }
  .body h3 { font-size: var(--step-title); line-height: 1.25; }
  .body p { color: var(--color-text-soft); font-size: var(--step-ui); line-height: var(--leading-body); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-s); margin-block-start: var(--space-xs); padding-block-start: var(--space-s); border-block-start: 1px solid var(--paper-2); }
  .quote { display: inline-flex; align-items: center; gap: 0.45em; padding: 0.55em 1.1em; border-radius: var(--radius-pill); background-color: var(--whatsapp-500); color: var(--ink-900); font-size: var(--step-small); font-weight: var(--weight-bold); text-decoration: none; transition: background-color var(--duration-hover) ease, transform var(--duration-hover) var(--ease-out); }
  .more { color: var(--tone); font-size: var(--step-small); font-weight: var(--weight-bold); text-decoration: none; }

  @media (min-width: 40em) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64em) {
    .g-head { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .cards.n-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .cards.n-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    /* Índice del banner: ocupa el ancho libre del banner */
    :global(.photo-hero .text) > .index.index { grid-column: 1 / -1; }
    .index ul { grid-template-columns: repeat(3, minmax(0, 1fr)); max-inline-size: 58rem; }
  }
  @media (hover: hover) and (pointer: fine) {
    .index a:hover { background-color: rgb(255 255 255 / 0.16); transform: translateY(-2px); }
    .index a:hover .idx-go { transform: translateY(3px); }
    .card:hover { translate: 0 -5px; box-shadow: var(--shadow-lift); }
    .card:hover .photo { transform: scale(1.05); }
    .quote:hover { background-color: var(--whatsapp-600); color: var(--ink-900); transform: translateY(-1px); }
  }
</style>
