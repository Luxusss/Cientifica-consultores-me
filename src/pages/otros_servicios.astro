---
import { Image, Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/ui/PageHero.astro';
import FormCard from '@/components/forms/FormCard.astro';
import Icon from '@/components/ui/Icon.astro';
import ContactBand from '@/components/sections/ContactBand.astro';
import { otherServices } from '@/data/otherServices';
import { breadcrumb } from '@/lib/schema';
import { site, whatsappUrl } from '@/config/site';
import heroImg from '@/assets/images/banner/asesora-de-tesis-Cientifica-Consultores.jpg';

const schema = [
  breadcrumb([{ name: 'Inicio', path: '/' }, { name: 'Otros servicios', path: '/otros_servicios.html' }]),
  ...otherServices.map((g) => ({ '@type': 'Service', name: g.name, description: g.summary, provider: { '@id': `${site.url}/#organizacion` } })),
];
import BrandMark from '@/components/ui/BrandMark.astro';
---

<Base
  title="Otros servicios de investigación | Científica Consultores"
  description="Revisiones sistemáticas, metaanálisis, planes de negocio, proyectos, trabajo de campo, análisis estadístico y corrección de estilo para tu investigación."
  schema={schema}
>
  <PageHero title="Otros servicios" crumb="Otros servicios" lede="Revisiones, proyectos, datos y corrección: un solo equipo para cada parte de tu trabajo, con tu primera asesoría gratis." balance="photo" tint>
    <Fragment slot="title"><span class="h1-main">Otros servicios para</span> <span class="h1-tail">tu investigación</span></Fragment>
    <ul class="trust" role="list">
      <li><span class="trust-ico"><Icon name="users" size="0.95rem" /></span>15 servicios en 5 áreas</li>
      <li><span class="trust-ico"><Icon name="user" size="0.95rem" /></span>Asesor de tu especialidad</li>
      <li><span class="trust-ico"><Icon name="clock" size="0.95rem" /></span>Respuesta en menos de 24 h</li>
    </ul>
    <FormCard title="¡Cotiza tu servicio gratis!" subject="Nuevo lead - Otros servicios" variant="short" submitLabel="Quiero mi cotización" hint="Ej.: necesito una revisión sistemática sobre salud mental para un artículo, con entrega en junio." />
    <Picture slot="media" formats={['avif', 'webp']} quality={80} src={heroImg} alt="Asesora de tesis de Científica Consultores" widths={[960, 1280, 1570]} sizes="100vw" loading="eager" fetchpriority="high" />
  </PageHero>

  <section class="section quick" aria-label="Áreas de servicio">
    <div class="page">
      <nav class="index" aria-label="Grupos de servicios">
        <ul role="list">
          {otherServices.map((g, i) => (
            <li>
              <a href={`#${g.id}`}>
                <span class:list={['idx-icon', i % 2 ? 'tone-6' : 'tone-1']} aria-hidden="true"><Icon name={g.icon} size="1.05rem" /></span>
                <span class="idx-text"><strong>{g.name}</strong><span>{g.items.length} servicios</span></span>
                <span class="idx-go" aria-hidden="true">↓</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  {otherServices.map((g, i) => (
    <section class="section-wide group" aria-labelledby={g.id}>
      <div class="page stack stack-xl">
        <header class="section-head center g-head" data-reveal>
          <span class:list={['g-icon', i % 2 ? 'tone-6' : 'tone-1']} aria-hidden="true"><Icon name={g.icon} size="1.5rem" /></span>
          <span class="eyebrow">Servicio {String(i + 1).padStart(2, '0')} · {g.items.length} opciones</span>
          <h2 id={g.id}>{g.name}</h2>
          <p>{g.summary}</p>
          <p class="for"><Icon name="user" size="1rem" />{g.forWho}</p>
        </header>
        <ul class:list={['cards', `n-${g.items.length}`]} role="list" data-reveal="stagger">
          {g.items.map((item, k) => (
            <li class:list={['card', (i + k) % 2 ? 'tone-6' : 'tone-1']}>
              <div class="brand-frame frame"><BrandMark tone="light" />
                <Image src={item.image} alt={item.alt} widths={[360, 540, 720]} sizes="(min-width: 64em) 30vw, (min-width: 40em) 45vw, 100vw" class:list={['photo', item.focus && `fx-${item.focus}`]} />
                <span class="num">{String(k + 1).padStart(2, '0')}</span>
              </div>
              <div class="body">
                <h3>{item.name}</h3>
                <p>{item.text}{item.href && <> <a class="more" href={item.href}>Ver servicio →</a></>}</p>
                <div class="actions">
                  <a class="quote" href={whatsappUrl(`Hola, quiero cotizar el servicio de ${item.name.toLowerCase()} (${g.name.toLowerCase()}).`)} target="_blank" rel="noopener" data-analytics="cotizar_otro_servicio">
                    <Icon name="whatsapp" size="1.1rem" />
                    <span>Solicitar cotización gratis</span>
                    <span class="q-arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <ContactBand />
</Base>

<style>
  /* Accesos rápidos a cada área, debajo del banner */
  .quick { padding-block: var(--space-m); }
  .index ul { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(13rem, 100%), 1fr)); gap: var(--space-xs); }
  .index li { display: grid; }
  .index a { block-size: 100%; display: flex; align-items: center; gap: 0.7rem; padding: 0.7rem 0.9rem 0.7rem 0.7rem; border-radius: var(--radius-card); background-color: var(--paper-0); box-shadow: var(--shadow-card); color: var(--ink-900); text-decoration: none; transition: box-shadow var(--duration-hover) ease, transform var(--duration-hover) var(--ease-out); }
  .idx-icon { display: grid; place-items: center; flex-shrink: 0; inline-size: 2.5rem; block-size: 2.5rem; border-radius: 0.8rem; background-image: var(--tone-grad); color: var(--paper-0); }
  .idx-text { display: grid; gap: 0.05rem; flex: 1; line-height: 1.2; }
  .idx-text strong { font-size: var(--step-ui); text-wrap: balance; }
  .idx-text span { color: var(--color-text-soft); font-size: var(--step-small); }
  .idx-go { color: var(--orange-500); font-weight: var(--weight-bold); transition: transform var(--duration-hover) var(--ease-out); }

  /* Encabezado de cada grupo, centrado como en el resto de la web */
  .g-head { justify-items: center; }
  .g-icon { display: grid; place-items: center; inline-size: 3.6rem; block-size: 3.6rem; margin-block-end: var(--space-2xs); border-radius: 1.1rem; background-image: var(--tone-grad); color: var(--paper-0); box-shadow: 0 12px 24px -12px var(--tone); }
  .for { display: inline-flex; align-items: center; gap: 0.5em; padding: 0.45em 0.95em; border-radius: var(--radius-pill); background-color: var(--orange-50); color: var(--orange-600) !important; font-size: var(--step-small) !important; font-weight: var(--weight-bold); }

  .cards { display: grid; gap: var(--space-m); grid-template-columns: 1fr; }
  .card { position: relative; isolation: isolate; display: grid; grid-template-rows: auto 1fr; border-radius: var(--radius-card); background-color: var(--paper-0); box-shadow: var(--shadow-card); transition: opacity var(--duration-reveal) var(--ease-expo), transform var(--duration-reveal) var(--ease-expo), translate var(--duration-ui) var(--ease-out), box-shadow var(--duration-ui) ease; }
  .frame { position: relative; overflow: hidden; border-start-start-radius: var(--radius-card); border-start-end-radius: var(--radius-card); }
  /* Misma altura de foto en todos los grupos, sin importar cuántas tarjetas tenga */
  /* Encuadre de cada foto: deja a la vista a la persona y a quien la acompaña cuando la tarjeta recorta los lados */
  .photo.fx-35 { object-position: 35% 50%; }
  .photo.fx-65 { object-position: 65% 50%; }
  .photo.fx-70 { object-position: 70% 50%; }
  .photo.fx-75 { object-position: 75% 50%; }
  .photo.fx-80 { object-position: 80% 50%; }
  .photo.fx-85 { object-position: 85% 50%; }
  .photo { display: block; inline-size: 100%; block-size: 13.5rem; object-fit: cover; transition: transform var(--duration-reveal) var(--ease-out); }
  .num { position: absolute; inset-block-start: var(--space-xs); inset-inline-start: var(--space-xs); display: grid; place-items: center; inline-size: 2.3rem; block-size: 2.3rem; border-radius: 0.75rem; background-image: var(--tone-grad); color: var(--paper-0); font-size: var(--step-small); font-weight: var(--weight-bold); box-shadow: 0 8px 16px -8px rgb(0 0 0 / 0.5); }
  .body { display: grid; grid-template-rows: auto 1fr auto; gap: var(--space-2xs); padding: var(--space-m); }
  .body h3 { font-size: var(--step-title); line-height: 1.25; }
  .body p { color: var(--color-text-soft); font-size: var(--step-ui); line-height: var(--leading-body); }
  .actions { display: grid; gap: var(--space-2xs); margin-block-start: var(--space-xs); }
  .quote { display: flex; align-items: center; gap: 0.55em; inline-size: 100%; padding: 0.55em 0.55em 0.55em 1.1em; border-radius: var(--radius-pill); background-color: var(--whatsapp-500); color: var(--ink-900); font-size: var(--step-ui); font-weight: var(--weight-bold); text-decoration: none; box-shadow: 0 10px 22px -14px rgb(37 211 102 / 0.9); transition: background-color var(--duration-hover) ease, transform var(--duration-hover) var(--ease-out); }
  .quote > span:not(.q-arrow) { flex: 1; }
  .q-arrow { display: grid; place-items: center; inline-size: 2rem; block-size: 2rem; border-radius: 50%; background-color: rgb(19 24 61 / 0.9); color: var(--paper-0); transition: transform var(--duration-hover) var(--ease-out); }
  .more { color: var(--tone); font-size: var(--step-small); font-weight: var(--weight-bold); text-decoration: none; }

  @media (min-width: 40em) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64em) {
    .cards.n-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    /* Con 2 servicios, las tarjetas mantienen el tamaño de las de 3 y van centradas */
    .cards.n-2 { grid-template-columns: repeat(2, minmax(0, calc((100% - 2 * var(--space-m)) / 3))); justify-content: center; }
    .cards.n-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .index ul { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }
  @media (hover: hover) and (pointer: fine) {
    .index a:hover { box-shadow: var(--shadow-lift); transform: translateY(-2px); }
    .index a:hover .idx-go { transform: translateY(3px); }
    .card:hover { translate: 0 -5px; box-shadow: var(--shadow-lift); }
    .card:hover .photo { transform: scale(1.05); }
    .quote:hover { background-color: var(--whatsapp-600); color: var(--ink-900); transform: translateY(-1px); }
    .quote:hover .q-arrow { transform: translateX(3px); }
  }
</style>
