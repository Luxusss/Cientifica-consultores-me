---
import { Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/ui/PageHero.astro';
import FormCard from '@/components/forms/FormCard.astro';
import Icon from '@/components/ui/Icon.astro';
import PointsBlock from '@/components/sections/PointsBlock.astro';
import ListBlock from '@/components/sections/ListBlock.astro';
import ContactBand from '@/components/sections/ContactBand.astro';
import type { Block } from '@/data/servicePages';
import { breadcrumb } from '@/lib/schema';
import { site } from '@/config/site';
import heroImg from '@/assets/images/banner/asesor-de-articulo-cientifico.jpg';
import fromThesis from '@/assets/images/articulos_cientificos/articulo-desde-una-tesis.jpg';
import bookChapter from '@/assets/images/articulos_cientificos/capitulo-de-libro.jpg';
import fromScratch from '@/assets/images/articulos_cientificos/empezando-desde-cero-un-articulo.jpg';

const trust = [
  { icon: 'search', text: 'Revistas indexadas' },
  { icon: 'pen', text: 'Estructura IMRyD' },
  { icon: 'chat', text: 'Respuesta a revisores' },
] as const;

// Tres puntos de partida, con la foto completa de fondo
const routes: Block = {
  id: 'partida',
  title: 'Artículos científicos: ¿cómo iniciamos?',
  intro: 'Elige tu punto de partida y te acompañamos hasta la publicación.',
  variant: 'overlay',
  points: [
    { title: 'Desde cero', tag: 'Investigación nueva', image: fromScratch, imageAlt: 'Artículo científico desde cero', text: 'Tú realizas el trabajo de campo (datos, experimentos o entrevistas) y te guiamos en el diseño, el análisis y la redacción del artículo.' },
    { title: 'Desde una tesis', tag: 'Tesis aprobada', image: fromThesis, imageAlt: 'Artículo científico a partir de una tesis', text: 'Partimos de tu tesis aprobada, evaluamos si es viable como artículo y te ayudamos a adaptarla a una revista.' },
    { title: 'Capítulo de libro', tag: 'Publicación en libro', image: bookChapter, imageAlt: 'Capítulo de libro académico', text: 'Con los datos que recolectas, te acompañamos a escribir un capítulo de libro académico con rigor y buenas citas.' },
  ],
};

const commitments = [
  'Monitoreo constante en cada paso',
  'Protección de tus datos y tu manuscrito',
  'Más de 10 años en publicaciones académicas',
  'Estándares de calidad hasta la publicación',
];

const schema = [
  breadcrumb([{ name: 'Inicio', path: '/' }, { name: 'Artículos científicos', path: '/articulos_cientificos.html' }]),
  { '@type': 'Service', name: 'Asesoría de artículos científicos', provider: { '@id': `${site.url}/#organizacion` }, areaServed: site.countries },
];
---

<Base
  preloadFont
  image="/og/articulos.jpg"
  title="Artículos Científicos | Científica Consultores"
  description="Asesoría para publicar tu artículo científico: desde cero, desde tu tesis o como capítulo de libro, hasta su envío a revistas indexadas."
  schema={schema}
>
  <PageHero title="Asesoría de artículos científicos" crumb="Artículos científicos" lede="Convierte tu investigación en una publicación: desde cero, desde tu tesis o como capítulo de libro." balance="photo">
    <Fragment slot="title"><span class="h1-main">Asesoría de</span> <span class="h1-tail">artículos científicos</span></Fragment>
    <ul class="trust" role="list">
      {trust.map((t) => <li><span class="trust-ico"><Icon name={t.icon} size="0.95rem" /></span>{t.text}</li>)}
    </ul>
    <FormCard title="¡Obtén tu primera asesoría gratis!" subject="Nuevo lead - Artículo Científico" variant="short" submitLabel="Quiero asesoría" hint="Ej.: tengo mi tesis de maestría aprobada en Psicología y quiero publicarla en una revista indexada." />
    <Picture slot="media" formats={['avif', 'webp']} quality={80} src={heroImg} alt="Asesoría de artículos científicos" widths={[960, 1280, 1570]} sizes="100vw" loading="eager" fetchpriority="high" />
  </PageHero>

  <PointsBlock block={routes} eyebrow="Tu punto de partida" />
  <ListBlock id="compromiso" title="Nuestro compromiso contigo" items={commitments} eyebrow="Compromiso" variant="icons" />
  <ContactBand />
</Base>
