---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import LeadForm from '@/components/forms/LeadForm.astro';
import ContactBand from '@/components/sections/ContactBand.astro';
import { breadcrumb } from '@/lib/schema';
import { site } from '@/config/site';
import heroImg from '@/assets/images/otros/asesora-de-articulos-cientificos.jpg';
import fromThesis from '@/assets/images/articulos_cientificos/articulo-desde-una-tesis.jpg';
import bookChapter from '@/assets/images/articulos_cientificos/capitulo-de-libro.jpg';
import fromScratch from '@/assets/images/tesis/metodologica_img.jpg';

const routes = [
  { title: 'Desde cero', image: fromScratch, text: 'Tú te encargas del trabajo de campo (recolección de datos, experimentos, entrevistas) y nosotros te acompañamos en la estructura, el análisis y la redacción hasta la publicación.' },
  { title: 'Desde una tesis', image: fromThesis, text: 'Necesitamos tu tesis aprobada para evaluar si puede convertirse en artículo.' },
  { title: 'Capítulo de libro', image: bookChapter, text: 'Tú realizas la recolección de datos y las acciones de campo; nosotros te asesoramos en el resto.' },
];

const commitments = ['Seguimiento detallado en cada paso', 'Manejo confidencial del manuscrito', 'Más de 10 años en publicaciones académicas', 'Claridad y rigor hasta la publicación'];

const schema = [
  breadcrumb([{ name: 'Inicio', path: '/' }, { name: 'Artículos científicos', path: '/articulos_cientificos.html' }]),
  { '@type': 'Service', name: 'Asesoría de artículos científicos', provider: { '@id': `${site.url}/#organizacion` }, areaServed: site.countries },
];
---

<Base
  title="Artículos Científicos | Científica Consultores"
  description="Asesoría para publicar tu artículo científico: desde cero, desde tu tesis o como capítulo de libro, hasta su envío a revistas indexadas."
  schema={schema}
>
  <section class="section page hero" aria-labelledby="titulo">
    <div class="text">
      <Breadcrumbs current="Artículos científicos" />
      <h1 id="titulo">Asesoría de artículos científicos</h1>
      <p class="text-lead">Convierte tu investigación en una publicación: desde cero, desde tu tesis o como capítulo de libro.</p>
      <div class="form theme-surface">
        <h2 class="text-lead text-strong">Pide tu primera asesoría gratis</h2>
        <LeadForm subject="Nuevo lead - Artículo Científico" variant="short" submitLabel="Quiero asesoría" />
      </div>
    </div>
    <Image src={heroImg} alt="Asesora de artículos científicos de Científica Consultores" widths={[480, 720, 960]} sizes="(min-width: 64em) 40vw, 100vw" loading="eager" fetchpriority="high" class="photo" />
  </section>

  <section class="section page routes" aria-labelledby="partida">
    <h2 id="partida">Tres puntos de partida</h2>
    <ul class="list" role="list" data-reveal="stagger">
      {routes.map((r) => (
        <li>
          <Image src={r.image} alt="" widths={[360, 540, 720]} sizes="(min-width: 64em) 30vw, 100vw" class="route-img" />
          <h3>{r.title}</h3>
          <p>{r.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="commit theme-surface" aria-labelledby="compromiso">
    <div class="page grid">
      <h2 id="compromiso">Nuestro compromiso</h2>
      <ul class="items" role="list" data-reveal="stagger">
        {commitments.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <ContactBand />
</Base>

<style>
  .hero { display: grid; gap: var(--space-l); }
  @media (max-width: 47.99em) {
    .hero h1 { font-size: var(--step-head); line-height: var(--leading-head); letter-spacing: var(--tracking-head); }
  }
  .text { display: grid; gap: var(--space-m); align-content: start; }
  .form { display: grid; gap: var(--space-m); padding: var(--space-m); max-inline-size: 34rem; }
  .photo { inline-size: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 20%; grid-row: 1; }

  .routes { display: grid; gap: var(--space-xl); }
  .list { display: grid; gap: var(--space-xl); }
  .list li { display: grid; gap: var(--space-s); align-content: start; }
  .route-img { inline-size: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .list h3 { font-weight: var(--weight-semibold); }

  .commit { padding-block: var(--section-gap); }
  .commit h2 { grid-column: 1 / -1; }
  .items { grid-column: 1 / -1; display: grid; gap: var(--space-s); margin-block-start: var(--space-l); }
  .items li { font-size: var(--step-lead); line-height: var(--leading-lead); }

  @media (min-width: 64em) {
    .hero { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start; }
    .text { grid-column: 1 / span 7; }
    .photo { grid-column: 8 / -1; grid-row: 1; aspect-ratio: 4 / 5; }
    .list { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--gutter); }
    .commit h2 { grid-column: 1 / span var(--axis); }
    .items { grid-column: calc(var(--axis) + 1) / -1; margin-block-start: 0; }
  }
</style>
