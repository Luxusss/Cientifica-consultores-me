---
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import ContactBand from '@/components/sections/ContactBand.astro';
import { captureKinds, captures } from '@/data/captures';
import { testimonials } from '@/data/proof';
import { stats } from '@/data/stats';
import { whatsappUrl } from '@/config/site';
import { breadcrumb } from '@/lib/schema';
import logoSvg from '@/assets/brand/logo.svg?raw';

const files = import.meta.glob<{ default: ImageMetadata }>('@/assets/images/fotos_testimonios/*.png', { eager: true });
const img = (n: number) => Object.entries(files).find(([k]) => k.endsWith(`/TESTIMONIO${n}.png`))?.[1].default;
const items = captures.map((c) => ({ ...c, src: img(c.n) })).filter((c) => c.src);
const total = items.length;
const sust = items.filter((c) => c.kind === 'sustentacion').length;

const schema = [
  breadcrumb([{ name: 'Inicio', path: '/' }, { name: 'Testimonios', path: '/testimonios.html' }]),
  { '@type': 'CollectionPage', name: 'Testimonios de tesistas', about: { '@id': 'https://cientificaconsultores.com/#organizacion' }, hasPart: { '@type': 'ItemList', numberOfItems: items.length, itemListElement: items.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: `${c.tag}: ${c.preview}` })) } },
];
---

<Base
  title="Testimonios de Tesistas Aprobados | Científica Consultores"
  description="Mensajes reales de nuestros clientes: tesis aprobadas, sustentaciones y recomendaciones de quienes se titularon con la asesoría de Científica Consultores."
  schema={schema}
>
  <section class="t-hero custom-hero" aria-labelledby="titulo">
    <div class="th-bubbles" aria-hidden="true">
      <span class="bb in b1"><b>Silvia</b>¡Aprobé! 🎓<i>1:16 p. m.</i></span>
      <span class="bb in b2"><b>Daniel</b>Nos aprobaron con 15<i>10:46 p. m.</i></span>
      <span class="bb out b3">¡Felicidades! Desde la familia Científica Consultores te deseamos muchos éxitos<i>4:54 p. m. ✓✓</i></span>
      <span class="bb in b4"><b>Sergio</b>Fue aprobada por unanimidad<i>8:01 a. m.</i></span>
      <span class="bb in b5"><b>Angelo</b>Me aprobaron mi tesis<i>4:49 p. m.</i></span>
      <span class="bb out b6">¡Qué buena noticia! 👏<i>3:03 p. m. ✓✓</i></span>
    </div>
    <div class="page th-top">
      <span class="eyebrow th-eyebrow">Testimonios reales</span>
      <h1 id="titulo">Lo que nos escriben <span class="th-accent">nuestros tesistas</span></h1>
      <p class="th-lede">Mensajes reales que nos enviaron al aprobar su plan, su tesis o su sustentación. Los compartimos con su autorización.</p>
      <ul class="th-stats" role="list">
        <li><strong>+{stats.clients}</strong><span>tesistas asesorados</span></li>
        <li><strong>{sust}</strong><span>sustentaciones en capturas</span></li>
        <li><strong>+{stats.universities}</strong><span>universidades</span></li>
      </ul>
      <a class="th-cta" href="#mensajes"><Icon name="whatsapp" size="1.1rem" />Ver las conversaciones <span aria-hidden="true">↓</span></a>
    </div>
  </section>
  <Breadcrumbs current="Testimonios" />

  <section class="section-wide" aria-labelledby="mensajes">
    <div class="page stack stack-xl">
      <header class="section-head center" data-reveal>
        <span class="eyebrow">{total} conversaciones reales</span>
        <h2 id="mensajes">Elige un chat y léelo tal como nos llegó</h2>
        <p>Así celebramos con cada tesista cuando aprueba su plan, su tesis o su sustentación.</p>
      </header>

      <div class="wa" data-wa data-reveal>
        <aside class="wa-side">
          <div class="wa-top">
            <span class="wa-me" aria-hidden="true"><Fragment set:html={logoSvg} /></span>
            <span class="wa-title">Chats de tesistas</span>
          </div>
          <div class="wa-filters" role="group" aria-label="Filtrar conversaciones">
            {captureKinds.map((k, i) => <button type="button" class="wa-filter" data-filter={k.id} aria-pressed={i === 0 ? 'true' : 'false'}>{k.label}</button>)}
          </div>
          <ul class="wa-list" role="list">
            {items.map((c, i) => (
              <li data-kind={c.kind}>
                <button type="button" class="wa-chat" data-chat={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="wa-view">
                  <span class:list={['wa-av', i % 2 ? 'tone-6' : 'tone-1']} aria-hidden="true">{c.name.charAt(0)}</span>
                  <span class="wa-meta">
                    <span class="wa-row"><strong>{c.name}</strong><span class="wa-tag">{c.tag}</span></span>
                    <span class="wa-prev"><Icon name="check" size="0.85rem" />{c.preview}</span>
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </aside>

        <div class="wa-main" id="wa-view" aria-live="polite">
          <div class="wa-head">
            <span class="wa-av tone-1" data-view-av aria-hidden="true">{items[0].name.charAt(0)}</span>
            <span class="wa-who"><strong data-view-name>{items[0].name}</strong><span data-view-tag>{items[0].tag}</span></span>
            <span class="wa-verified"><Icon name="badge" size="0.95rem" />Captura real</span>
          </div>
          <div class="wa-stage">
            <button type="button" class="wa-nav prev" data-prev aria-label="Conversación anterior">‹</button>
            <div class="wa-shot-box">
              {items.map((c, i) => (
                <Image src={c.src!} alt={`Captura de WhatsApp de ${c.name}: ${c.preview}`} widths={[363]} sizes="363px" class="wa-shot" data-shot={i} loading={i === 0 ? 'eager' : 'lazy'} hidden={i !== 0} />
              ))}
            </div>
            <div class="wa-info">
              <span class="wa-result" data-view-result>{items[0].tag}</span>
              <p class="wa-quote" data-view-quote>“{items[0].preview}”</p>
              <ul class="wa-facts" role="list">
                <li><Icon name="badge" size="1rem" />Captura real de WhatsApp</li>
                <li><Icon name="shield" size="1rem" />Compartida con autorización</li>
                <li><Icon name="lock" size="1rem" />Datos personales ocultos</li>
              </ul>
              <a class="wa-next-me" href={whatsappUrl('Hola, vi los testimonios y quiero empezar mi asesoría de tesis.')} target="_blank" rel="noopener"><Icon name="whatsapp" size="1.05rem" />Quiero ser el siguiente</a>
            </div>
            <button type="button" class="wa-nav next" data-next aria-label="Conversación siguiente">›</button>
          </div>
          <p class="wa-count"><span data-count>1</span> de {total} · <span class="wa-note">Nombres, números y archivos ocultos para proteger a nuestros clientes</span></p>
        </div>
      </div>
    </div>
  </section>

  <ContactBand title="¿Quieres ser el próximo en titularte?" />
</Base>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-wa]')) {
    const chats = [...root.querySelectorAll<HTMLButtonElement>('[data-chat]')];
    const shots = [...root.querySelectorAll<HTMLElement>('[data-shot]')];
    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const name = root.querySelector<HTMLElement>('[data-view-name]')!;
    const tag = root.querySelector<HTMLElement>('[data-view-tag]')!;
    const av = root.querySelector<HTMLElement>('[data-view-av]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const result = root.querySelector<HTMLElement>('[data-view-result]')!;
    const quote = root.querySelector<HTMLElement>('[data-view-quote]')!;
    const info = root.querySelector<HTMLElement>('.wa-info')!;
    const who = root.querySelector<HTMLElement>('.wa-who')!;
    const calm = matchMedia('(prefers-reduced-motion: reduce)');
    const MOVES = ['enter-next', 'enter-prev', 'leave-next', 'leave-prev'];
    let current = 0;
    let token = 0;
    const visible = () => chats.filter((c) => !(c.parentElement as HTMLElement).hidden).map((c) => Number(c.dataset.chat));
    const warm = (i: number) => {
      const list = visible(); const k = list.indexOf(i);
      for (const j of [list[(k + 1) % list.length], list[(k - 1 + list.length) % list.length]]) {
        const img = shots[j] as HTMLImageElement | undefined;
        if (img && img.loading === 'lazy') img.loading = 'eager';
      }
    };
    const replay = (el: HTMLElement, cls: string) => { el.classList.remove(cls); void el.offsetWidth; el.classList.add(cls); };
    const show = async (i: number, scroll = false, dir = 0) => {
      const run = ++token;
      const prev = shots[current];
      const next = shots[i] as HTMLImageElement;
      if (!dir) { const list = visible(); dir = list.indexOf(i) >= list.indexOf(current) ? 1 : -1; }
      current = i;
      chats.forEach((c) => c.setAttribute('aria-pressed', String(Number(c.dataset.chat) === i)));
      if (next.loading === 'lazy') next.loading = 'eager';
      next.hidden = false;
      try { await next.decode(); } catch {}
      if (run !== token) return;
      shots.forEach((s) => { if (s !== next && s !== prev) { s.hidden = true; s.classList.remove(...MOVES); } });
      next.classList.remove(...MOVES);
      if (!calm.matches && prev && prev !== next) {
        prev.classList.remove(...MOVES); void prev.offsetWidth;
        prev.classList.add(dir > 0 ? 'leave-next' : 'leave-prev');
        next.classList.add(dir > 0 ? 'enter-next' : 'enter-prev');
        const done = () => { if (shots[current] !== prev) prev.hidden = true; prev.classList.remove(...MOVES); if (run === token) next.classList.remove(...MOVES); };
        prev.addEventListener('animationend', done, { once: true });
        setTimeout(done, 650);
        replay(info, 'swap'); replay(who, 'swap');
      } else if (prev && prev !== next) {
        prev.hidden = true;
      }
      warm(i);
      const chat = chats[i];
      name.textContent = chat.querySelector('strong')!.textContent;
      tag.textContent = chat.querySelector('.wa-tag')!.textContent;
      result.textContent = tag.textContent;
      quote.textContent = `“${chat.querySelector('.wa-prev')!.textContent!.trim()}”`;
      av.textContent = chat.querySelector('.wa-av')!.textContent;
      av.className = chat.querySelector('.wa-av')!.className;
      const list = visible();
      count.textContent = String(list.indexOf(i) + 1);
      count.nextSibling!.textContent = ` de ${list.length} · `;
      if (scroll) chat.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
    };
    const step = (d: number) => { const list = visible(); const k = list.indexOf(current); show(list[(k + d + list.length) % list.length], true, d); };
    warm(0);
    chats.forEach((c) => c.addEventListener('click', () => show(Number(c.dataset.chat))));
    root.querySelector('[data-prev]')!.addEventListener('click', () => step(-1));
    root.querySelector('[data-next]')!.addEventListener('click', () => step(1));
    root.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') step(1); if (e.key === 'ArrowLeft') step(-1); });
    filters.forEach((f) => f.addEventListener('click', () => {
      filters.forEach((x) => x.setAttribute('aria-pressed', String(x === f)));
      chats.forEach((c) => { const li = c.parentElement as HTMLElement; li.hidden = f.dataset.filter !== 'todos' && li.dataset.kind !== f.dataset.filter; });
      const list = visible();
      if (list.length) show(list.includes(current) ? current : list[0]);
    }));
  }
</script>

<style>
  .t-hero { position: relative; overflow: hidden; isolation: isolate; padding-block: var(--space-2xl); background-color: #efeae2; background-image: radial-gradient(circle at 20% 20%, rgb(29 45 140 / 0.07) 0 2px, transparent 3px), radial-gradient(circle at 70% 60%, rgb(37 211 102 / 0.08) 0 2px, transparent 3px); background-size: 34px 34px, 46px 46px; color: var(--ink-900); }
  .t-hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(34rem 20rem at 50% 50%, rgb(239 234 226 / 0.96) 40%, transparent 75%); }
  .th-top { position: relative; z-index: 1; display: grid; justify-items: center; gap: var(--space-s); text-align: center; }
  .th-eyebrow { background-color: #d9fdd3; color: #0b6b3a; }
  .th-top h1 { color: var(--navy-700); font-size: clamp(2.4rem, 1.3rem + 2.1vw, 3.4rem); line-height: 1.04; letter-spacing: -0.03em; max-inline-size: 18ch; }
  .th-accent { display: block; color: var(--orange-500); }
  .th-lede { color: var(--ink-600); font-size: var(--step-lead); max-inline-size: 50ch; }
  .th-stats { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-xs) var(--space-l); margin-block-start: var(--space-2xs); }
  .th-stats li { display: grid; justify-items: center; gap: 0.1rem; }
  .th-stats strong { font-family: var(--font-display); font-size: clamp(1.6rem, 1.3rem + 0.9vw, 2.2rem); line-height: 1; color: var(--navy-600); }
  .th-stats li:nth-child(2) strong { color: var(--orange-500); }
  .th-stats span { color: var(--ink-600); font-size: var(--step-small); font-weight: var(--weight-semibold); }
  .th-cta { display: inline-flex; align-items: center; gap: 0.5em; margin-block-start: var(--space-xs); padding: 0.75em 1.4em; border-radius: var(--radius-pill); background-color: var(--whatsapp-500); color: var(--ink-900); font-weight: var(--weight-bold); text-decoration: none; box-shadow: 0 14px 30px -14px rgb(37 211 102 / 0.8); transition: transform var(--duration-ui) var(--ease-out); }

  .th-bubbles { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .bb { position: absolute; display: grid; gap: 0.15rem; max-inline-size: 15rem; padding: 0.5em 0.8em 0.4em; border-radius: 0.9rem; background-color: #fff; color: #111b21; font-size: 0.82rem; line-height: 1.35; box-shadow: 0 1px 1px rgb(0 0 0 / 0.08), 0 14px 30px -18px rgb(0 0 0 / 0.35); }
  .bb b { color: #e5576b; font-size: 0.72rem; }
  .bb i { justify-self: end; color: #667781; font-size: 0.66rem; font-style: normal; }
  .bb.in { border-start-start-radius: 0.2rem; }
  .bb.out { background-color: #d9fdd3; border-start-end-radius: 0.2rem; }
  .bb.out i { color: #53bdeb; }
  .b1 { inset-block-start: 14%; inset-inline-start: 6%; }
  .b2 { inset-block-start: 44%; inset-inline-start: 3%; }
  .b3 { inset-block-start: 70%; inset-inline-start: 9%; }
  .b4 { inset-block-start: 16%; inset-inline-end: 6%; }
  .b5 { inset-block-start: 46%; inset-inline-end: 3%; }
  .b6 { inset-block-start: 72%; inset-inline-end: 9%; }
  @media (max-width: 63.99em) { .th-bubbles { display: none; } }
  @media (prefers-reduced-motion: no-preference) {
    .bb { animation: bb-in 700ms var(--ease-out) both, bb-float 7s ease-in-out 700ms infinite; }
    .b2 { animation-delay: 120ms, 1.2s; } .b3 { animation-delay: 240ms, 2s; } .b4 { animation-delay: 360ms, 0.8s; } .b5 { animation-delay: 480ms, 1.6s; } .b6 { animation-delay: 600ms, 2.4s; }
    @keyframes bb-in { from { opacity: 0; transform: translateY(12px) scale(0.95); } }
    @keyframes bb-float { 50% { translate: 0 -6px; } }
  }
  @media (hover: hover) and (pointer: fine) { .th-cta:hover { transform: translateY(-2px); color: var(--ink-900); } }

  .wa { display: grid; grid-template-columns: minmax(0, 1fr); overflow: hidden; border-radius: calc(var(--radius-card) + 0.5rem); background-color: var(--paper-0); box-shadow: 0 40px 80px -40px rgb(20 31 102 / 0.55), 0 0 0 1px rgb(0 0 0 / 0.05); }
  .wa-side { display: grid; grid-template-rows: auto auto 1fr; min-inline-size: 0; border-block-end: 1px solid var(--paper-2); background-color: var(--paper-0); }
  .wa-top { display: flex; align-items: center; gap: 0.7rem; padding: 0.8rem 1rem; background-image: var(--gradient-brand); color: var(--paper-0); }
  .wa-me { display: block; inline-size: 5.5rem; color: var(--paper-0); }
  .wa-me :global(svg) { display: block; inline-size: 100%; block-size: auto; }
  .wa-title { margin-inline-start: auto; font-size: var(--step-small); font-weight: var(--weight-bold); opacity: 0.85; }
  .wa-filters { display: flex; gap: 0.35rem; padding: 0.7rem 0.8rem; overflow-x: auto; scrollbar-width: none; border-block-end: 1px solid var(--paper-2); }
  .wa-filter { flex-shrink: 0; padding: 0.4em 0.85em; border: 0; border-radius: var(--radius-pill); background-color: var(--paper-1); color: var(--ink-600); font: inherit; font-size: var(--step-small); font-weight: var(--weight-semibold); cursor: pointer; transition: background-color var(--duration-hover) ease, color var(--duration-hover) ease; }
  .wa-filter[aria-pressed='true'] { background-color: #d9fdd3; color: #0b6b3a; }
  .wa-list { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; }
  .wa-list li[hidden] { display: none; }
  .wa-chat { display: flex; align-items: center; gap: 0.7rem; inline-size: 100%; min-inline-size: min(16rem, 78vw); padding: 0.75rem 1rem; border: 0; border-block-end: 1px solid var(--paper-1); background: transparent; color: var(--ink-900); font: inherit; text-align: start; cursor: pointer; scroll-snap-align: start; transition: background-color var(--duration-hover) ease; }
  .wa-chat[aria-pressed='true'] { background-color: #eef3ff; box-shadow: inset 4px 0 0 var(--orange-500); }
  .wa-av { display: grid; place-items: center; flex-shrink: 0; inline-size: 2.7rem; block-size: 2.7rem; border-radius: 50%; background-image: var(--tone-grad); color: var(--paper-0); font-weight: var(--weight-bold); }
  .wa-meta { display: grid; gap: 0.2rem; min-inline-size: 0; flex: 1; }
  .wa-row { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .wa-row strong { font-size: var(--step-ui); }
  .wa-tag { flex-shrink: 0; padding: 0.15em 0.55em; border-radius: var(--radius-pill); background-color: var(--orange-50); color: var(--orange-600); font-size: 0.68rem; font-weight: var(--weight-bold); }
  .wa-prev { display: flex; align-items: center; gap: 0.3em; overflow: hidden; color: var(--color-text-soft); font-size: var(--step-small); white-space: nowrap; text-overflow: ellipsis; }
  .wa-prev :global(svg) { flex-shrink: 0; color: #53bdeb; }

  .wa-main { display: grid; grid-template-rows: auto 1fr auto; min-inline-size: 0; background-color: #efeae2; background-image: radial-gradient(circle at 20% 20%, rgb(29 45 140 / 0.06) 0 2px, transparent 3px), radial-gradient(circle at 70% 60%, rgb(254 143 1 / 0.07) 0 2px, transparent 3px); background-size: 34px 34px, 46px 46px; }
  .wa-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem; padding: 0.7rem 1rem; background-color: #f0f2f5; border-block-end: 1px solid rgb(0 0 0 / 0.06); }
  .wa-who { display: grid; line-height: 1.2; }
  .wa-who span { color: var(--color-text-soft); font-size: var(--step-small); }
  .wa-verified { display: inline-flex; align-items: center; gap: 0.4em; margin-inline-start: auto; padding: 0.35em 0.8em; border-radius: var(--radius-pill); background-color: #d9fdd3; color: #0b6b3a; font-size: var(--step-small); font-weight: var(--weight-bold); }
  .wa-stage { display: flex; align-items: center; justify-content: center; gap: var(--space-s); padding: var(--space-m) var(--space-s); }
  .wa-shot-box { display: grid; flex-shrink: 1; min-inline-size: 0; inline-size: min(17rem, 62vw); }
  .wa-shot-box :global(.wa-shot) { grid-area: 1 / 1; }
  .wa-shot-box :global(.wa-shot) { display: block; inline-size: 100%; block-size: auto; border-radius: 2.1rem; box-shadow: 0 30px 60px -28px rgb(0 0 0 / 0.55); }
  .wa-shot-box :global(.wa-shot[hidden]) { display: none; }
  .wa-info { display: none; gap: var(--space-s); align-content: center; justify-items: start; max-inline-size: 19rem; padding: var(--space-m); border-radius: var(--radius-card); background-color: rgb(255 255 255 / 0.85); box-shadow: var(--shadow-card); backdrop-filter: blur(6px); }
  .wa-result { padding: 0.35em 0.85em; border-radius: var(--radius-pill); background-color: #d9fdd3; color: #0b6b3a; font-size: var(--step-small); font-weight: var(--weight-bold); }
  .wa-quote { font-family: var(--font-display); font-size: var(--step-title); line-height: 1.3; color: var(--ink-900); }
  .wa-facts { display: grid; gap: 0.45rem; }
  .wa-facts li { display: flex; align-items: center; gap: 0.5em; color: var(--ink-600); font-size: var(--step-small); font-weight: var(--weight-semibold); }
  .wa-facts :global(svg) { color: var(--orange-500); }
  .wa-next-me { display: inline-flex; align-items: center; gap: 0.5em; padding: 0.6em 1.1em; border-radius: var(--radius-pill); background-color: var(--whatsapp-500); color: var(--ink-900); font-size: var(--step-ui); font-weight: var(--weight-bold); text-decoration: none; }
  @media (max-width: 47.99em) { .wa-nav { inline-size: 2.2rem; block-size: 2.2rem; font-size: 1.3rem; } .wa-stage { gap: 0.4rem; padding-inline: 0.4rem; } }
  .wa-nav { display: grid; place-items: center; flex-shrink: 0; inline-size: 2.8rem; block-size: 2.8rem; border: 0; border-radius: 50%; background-color: var(--paper-0); color: var(--navy-700); font-size: 1.6rem; line-height: 1; cursor: pointer; box-shadow: var(--shadow-card); transition: transform var(--duration-hover) var(--ease-out), background-color var(--duration-hover) ease; }
  .wa-count { padding: 0 var(--space-m) var(--space-m); color: var(--ink-600); font-size: var(--step-small); font-weight: var(--weight-semibold); text-align: center; max-inline-size: none; }
  .wa-note { font-weight: var(--weight-regular); }

  @media (min-width: 64em) {
    .wa { grid-template-columns: 24rem minmax(0, 1fr); block-size: 44rem; }
    .wa-side { border-block-end: 0; border-inline-end: 1px solid var(--paper-2); min-block-size: 0; }
    .wa-list { display: block; overflow-y: auto; overflow-x: hidden; scroll-snap-type: none; }
    .wa-chat { min-inline-size: 0; }
    .wa-stage { min-block-size: 0; }
    .wa-stage { gap: var(--space-l); }
    .wa-shot-box { inline-size: auto; block-size: 100%; max-block-size: 34rem; }
    .wa-shot-box :global(.wa-shot) { block-size: 100%; max-block-size: 34rem; inline-size: auto; }
