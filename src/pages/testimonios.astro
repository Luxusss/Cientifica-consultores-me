---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/ui/PageHero.astro';
import ContactBand from '@/components/sections/ContactBand.astro';
import { testimonials } from '@/data/proof';
import { breadcrumb } from '@/lib/schema';

const captures = Object.entries(import.meta.glob<{ default: ImageMetadata }>('@/assets/images/fotos_testimonios/*.png', { eager: true }))
  .sort(([a], [b]) => Number(b.match(/(\d+)\.png$/)?.[1]) - Number(a.match(/(\d+)\.png$/)?.[1]))
  .map(([, mod]) => mod.default);

const schema = [breadcrumb([{ name: 'Inicio', path: '/' }, { name: 'Testimonios', path: '/testimonios.html' }])];
---

<Base
  title="Testimonios de Clientes | Científica Consultores"
  description="Lee los testimonios de nuestros clientes satisfechos que han obtenido excelentes resultados con la asesoría de tesis de Científica Consultores."
  schema={schema}
>
  <PageHero tone="field" title="Testimonios de nuestros clientes" crumb="Testimonios" lede="Cada logro de nuestros trabajos académicos nos recuerda el sentido de nuestro origen. Agradecemos a nuestros clientes que, por propia iniciativa, autorizan que compartamos sus casos de éxito." />

  <section class="section-wide" aria-labelledby="historias">
    <div class="page stack stack-xl">
      <header class="split split-end" data-reveal>
        <h2 id="historias">Lo que dicen nuestros clientes</h2>
        <p class="text-lead">Historias reales de personas que lograron titularse con nuestro apoyo.</p>
      </header>
      <ul class="cards" role="list" data-reveal="stagger">
        {testimonials.map((t) => (
          <li class="card">
            <figure>
              <span class="mark" aria-hidden="true">“</span>
              <blockquote><p>{t.quote}</p></blockquote>
              <figcaption>
                <span class="avatar" aria-hidden="true">{t.name.charAt(0)}</span>
                <span class="who"><strong>{t.name}</strong><span>{t.university}, {t.country}</span></span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="theme-surface section-wide" aria-labelledby="mensajes">
    <div class="page stack stack-l">
      <h2 id="mensajes">Mensajes de nuestros clientes</h2>
      <ul class="gallery" role="list" data-reveal="stagger">
        {captures.map((src, i) => (
          <li><Image src={src} alt={`Captura del mensaje de un cliente, testimonio ${i + 1}`} widths={[320, 480, 640]} sizes="(min-width: 64em) 25vw, (min-width: 48em) 33vw, 50vw" class="shot" /></li>
        ))}
      </ul>
    </div>
  </section>

  <ContactBand />
</Base>

<style>
  .cards { columns: 3 20rem; column-gap: var(--space-m); }
  .card { break-inside: avoid; margin-block-end: var(--space-m); padding: var(--space-l); background-color: var(--color-surface); border-radius: var(--radius-card); }
  figure { display: grid; gap: var(--space-s); }
  .mark { font-size: 3rem; line-height: 0.5; color: var(--orange-500); block-size: 1.25rem; }
  blockquote p { font-size: var(--step-body); line-height: var(--leading-body); }
  figcaption { display: flex; align-items: center; gap: var(--space-xs); margin-block-start: var(--space-2xs); }
  .avatar { display: grid; place-items: center; inline-size: 2.75rem; block-size: 2.75rem; border-radius: 50%; background-color: var(--navy-600); color: var(--paper-0); font-weight: var(--weight-semibold); flex-shrink: 0; }
  .who { display: grid; line-height: var(--leading-small); }
  .who span { color: var(--color-text-soft); font-size: var(--step-small); }
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(11rem, 45%), 1fr)); gap: var(--space-s); }
  .shot { inline-size: 100%; block-size: auto; border-radius: var(--radius-card); }
</style>
