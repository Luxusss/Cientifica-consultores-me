---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/ui/PageHero.astro';
import ContactBand from '@/components/sections/ContactBand.astro';
import { testimonials } from '@/data/proof';
import { breadcrumb } from '@/lib/schema';

const captures = Object.entries(import.meta.glob<{ default: ImageMetadata }>('@/assets/images/fotos_testimonios/*.png', { eager: true }))
  .sort(([a], [b]) => Number(b.match(/(\d+)\.png$/)?.[1]) - Number(a.match(/(\d+)\.png$/)?.[1]))
  .map(([, mod]) => mod.default);

const schema = [breadcrumb([{ name: 'Inicio', path: '/' }, { name: 'Testimonios', path: '/testimonios.html' }])];
---

<Base
  title="Testimonios de Clientes | Científica Consultores"
  description="Lee los testimonios de nuestros clientes satisfechos que han obtenido excelentes resultados con la asesoría de tesis de Científica Consultores."
  schema={schema}
>
  <PageHero tone="field" title="Testimonios de nuestros clientes" crumb="Testimonios" lede="Agradecemos a quienes, por iniciativa propia, autorizan que compartamos su caso." />

  <section class="section page split stories" aria-labelledby="historias">
    <h2 id="historias">Historias de quienes sustentaron</h2>
    <ul class="list" role="list" data-reveal="stagger">
      {testimonials.map((t) => (
        <li>
          <figure>
            <blockquote><p>“{t.quote}”</p></blockquote>
            <figcaption><strong>{t.name}</strong><span>{t.university}, {t.country}</span></figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>

  <section class="theme-surface section-wide" aria-labelledby="mensajes">
    <div class="page stack stack-l">
      <h2 id="mensajes">Mensajes de nuestros clientes</h2>
      <ul class="gallery" role="list" data-reveal="stagger">
        {captures.map((src, i) => (
          <li><Image src={src} alt={`Captura del mensaje de un cliente, testimonio ${i + 1}`} widths={[320, 480, 640]} sizes="(min-width: 64em) 25vw, (min-width: 48em) 33vw, 50vw" class="shot" /></li>
        ))}
      </ul>
    </div>
  </section>

  <ContactBand />
</Base>

<style>
  .stories { --axis: 6; }
  .list { display: grid; gap: var(--space-xl) var(--gutter); }
  figure { display: grid; gap: var(--space-s); }
  blockquote p { font-size: var(--step-lead); line-height: var(--leading-lead); }
  figcaption { display: grid; gap: var(--space-3xs); }
  figcaption span { color: var(--color-text-soft); }
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(12rem, 45%), 1fr)); gap: var(--space-s); }
  .shot { inline-size: 100%; block-size: auto; }
  @media (min-width: 64em) {
    .list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
