---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import ContactBand from '@/components/sections/ContactBand.astro';
import { testimonials } from '@/data/proof';
import { breadcrumb } from '@/lib/schema';

const captures = Object.entries(import.meta.glob<{ default: ImageMetadata }>('@/assets/images/fotos_testimonios/*.png', { eager: true }))
  .sort(([a], [b]) => Number(b.match(/(\d+)\.png$/)?.[1]) - Number(a.match(/(\d+)\.png$/)?.[1]))
  .map(([, mod]) => mod.default);

const schema = [breadcrumb([{ name: 'Inicio', path: '/' }, { name: 'Testimonios', path: '/testimonios.html' }])];
---

<Base
  title="Testimonios de Clientes | Científica Consultores"
  description="Lee los testimonios de nuestros clientes satisfechos que han obtenido excelentes resultados con la asesoría de tesis de Científica Consultores."
  schema={schema}
>
  <section class="section page hero" aria-labelledby="titulo">
    <Breadcrumbs current="Testimonios" />
    <h1 id="titulo">Testimonios de nuestros clientes</h1>
    <p class="text-lead">Agradecemos a quienes, por iniciativa propia, autorizan que compartamos su caso.</p>
  </section>

  <section class="section page voices" aria-labelledby="historias">
    <h2 id="historias">Historias de quienes sustentaron</h2>
    <ul class="list" role="list">
      {testimonials.map((t) => (
        <li>
          <figure>
            <blockquote><p>“{t.quote}”</p></blockquote>
            <figcaption><strong>{t.name}</strong><span>{t.university}, {t.country}</span></figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>

  <section class="captures theme-surface" aria-labelledby="mensajes">
    <div class="page">
      <h2 id="mensajes">Mensajes de nuestros clientes</h2>
      <ul class="gallery" role="list">
        {captures.map((src, i) => (
          <li><Image src={src} alt={`Captura del mensaje de un cliente, testimonio ${i + 1}`} widths={[320, 480, 640]} sizes="(min-width: 64em) 25vw, (min-width: 48em) 33vw, 50vw" class="shot" /></li>
        ))}
      </ul>
    </div>
  </section>

  <ContactBand />
</Base>

<style>
  .hero { display: grid; gap: var(--space-m); }

  .voices { display: grid; gap: var(--space-xl); }
  .list { display: grid; gap: var(--space-xl); }
  figure { display: grid; gap: var(--space-s); }
  blockquote p { font-size: var(--step-lead); line-height: var(--leading-lead); }
  figcaption { display: grid; gap: var(--space-3xs); }
  figcaption span { color: var(--color-text-soft); }

  .captures { padding-block: var(--section-gap); }
  .gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-s); margin-block-start: var(--space-l); }
  .shot { inline-size: 100%; block-size: auto; }

  @media (min-width: 48em) { .gallery { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 64em) {
    .voices { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start; }
    .voices h2 { grid-column: 1 / span var(--axis); position: sticky; inset-block-start: calc(var(--header-height) + var(--space-l)); }
    .list { grid-column: calc(var(--axis) + 1) / -1; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--gutter); }
    .gallery { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
