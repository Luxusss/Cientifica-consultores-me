---
import Base from '@/layouts/Base.astro';
import { breadcrumb } from '@/lib/schema';
import Field from '@/components/ui/Field.astro';
import Button from '@/components/ui/Button.astro';
import LegalHero from '@/components/legal/LegalHero.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/config/site';
import { endpoints, formsubmit } from '@/config/forms';

const next = `${site.url}/libro-de-reclamaciones.html?enviado=1`;
---

<Base schema={[breadcrumb([{ name: 'Inicio', path: '/' }, { name: 'Libro de reclamaciones', path: '/libro-de-reclamaciones.html' }])]}
  title="Libro de Reclamaciones | Científica Consultores"
  description="Registra tu reclamo o queja sobre nuestros servicios. Te respondemos en un plazo máximo de 15 días hábiles, según la normativa de INDECOPI."
>
  <LegalHero
    heading="Libro de reclamaciones"
    eyebrow="Libro de reclamaciones virtual"
    icon="pen"
    description="Conforme al Código de Protección y Defensa del Consumidor, ponemos a tu disposición nuestro Libro de Reclamaciones virtual. Registra aquí tu reclamo o queja."
    meta={[
      { icon: 'institution', text: 'Ley N.° 29571 · Código del Consumidor' },
      { icon: 'clock', text: 'Respuesta en máx. 15 días hábiles' },
      { icon: 'mail', text: 'Te respondemos por correo' },
    ]}
  />

  <section class="page l-body" aria-label="Registro de reclamo o queja">
    <aside class="l-side">
      <div class="card provider-card">
        <p class="side-title"><Icon name="institution" size="1rem" />Datos del proveedor</p>
        <dl class="provider">
          <div><dt>Razón social</dt><dd>{site.legalName}</dd></div>
          <div><dt>RUC</dt><dd>{site.ruc}</dd></div>
          <div><dt>Domicilio</dt><dd>{site.legalAddress}</dd></div>
        </dl>
      </div>
      <div class="card">
        <p class="side-title"><Icon name="list" size="1rem" />Cómo funciona</p>
        <ol class="how" role="list">
          <li><span>1</span><p><strong>Completa el formulario</strong> con tus datos y el detalle de tu caso.</p></li>
          <li><span>2</span><p><strong>Lo revisamos</strong> y te contactamos si necesitamos más información.</p></li>
          <li><span>3</span><p><strong>Te respondemos</strong> por correo en un plazo máximo de 15 días hábiles.</p></li>
        </ol>
      </div>
      <p class="sent" role="status" hidden data-sent><Icon name="check" size="1rem" />Tu reclamo o queja se envió correctamente. Lo estamos revisando y te responderemos por correo electrónico.</p>
    </aside>

    <div class="sheet">
    <form class="form" method="POST" action={formsubmit(endpoints.claims)} enctype="multipart/form-data">
      <input type="hidden" name="_subject" value="Libro de Reclamaciones - Nuevo registro" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_next" value={next} />
      <div class="visually-hidden" aria-hidden="true">
        <label for="lr-honey">No llenar</label>
        <input id="lr-honey" type="text" name="_honey" tabindex="-1" autocomplete="off" />
      </div>

      <fieldset>
        <legend>1. Identificación del consumidor reclamante</legend>
        <div class="cols">
          <Field label="DNI" name="dni" placeholder="Ej.: 45678912" inputmode="numeric" pattern="\d{8}" maxlength="8" required hint="8 dígitos" error="El DNI debe tener 8 dígitos." />
          <Field label="Nombres" name="nombres" placeholder="Ej.: María Fernanda" autocomplete="given-name" required error="Escribe tus nombres." />
          <Field label="Apellidos" name="apellidos" placeholder="Ej.: Quispe Rojas" autocomplete="family-name" required error="Escribe tus apellidos." />
          <Field label="Correo electrónico" name="email" type="email" placeholder="Ej.: maria.quispe@gmail.com" autocomplete="email" required error="Revisa el formato del correo." />
          <Field label="Teléfono" name="telefono" placeholder="Ej.: 987 654 321" type="tel" autocomplete="tel" inputmode="tel" pattern="[0-9 +()-]{7,20}" required hint="De 7 a 15 dígitos; puedes incluir +" error="Escribe un teléfono válido." />
          <Field label="Dirección" name="direccion" placeholder="Ej.: Av. Universitaria 1234, Los Olivos, Lima" autocomplete="street-address" required error="Escribe tu dirección." />
        </div>
      </fieldset>

      <fieldset>
        <legend>2. Identificación del servicio contratado</legend>
        <div class="cols">
          <Field label="Monto reclamado (S/)" name="monto_reclamado" placeholder="Ej.: 350.00" type="number" step="0.01" min="0" inputmode="decimal" />
          <Field label="Descripción del servicio contratado" name="servicio_descripcion" placeholder="Ej.: Asesoría de tesis de pregrado, plan Tesis Completa" />
        </div>
      </fieldset>

      <fieldset>
        <legend>3. Detalle de la reclamación y pedido del consumidor</legend>
        <div class="radios" role="radiogroup" aria-describedby="tipo-ayuda">
          <label><input type="radio" name="tipo" value="Reclamo" required /> Reclamo</label>
          <label><input type="radio" name="tipo" value="Queja" /> Queja</label>
        </div>
        <dl class="defs" id="tipo-ayuda">
          <div><dt>Reclamo</dt><dd>Disconformidad relacionada con los productos o servicios.</dd></div>
          <div><dt>Queja</dt><dd>Disconformidad no relacionada con los productos o servicios, o malestar respecto a la atención al público.</dd></div>
        </dl>
        <Field label="Detalle del inconveniente" name="detalle" placeholder="Cuéntanos qué pasó: fecha, servicio y el inconveniente. Ej.: El 10 de octubre solicité la revisión de mi capítulo 2 y aún no recibo respuesta." type="textarea" required error="Describe el inconveniente." />
        <Field label="Pedido del consumidor" name="pedido" placeholder="Indica qué solución esperas. Ej.: Que me entreguen la revisión del capítulo 2 en un plazo de 5 días." type="textarea" required error="Indica qué solución solicitas." />
        <div class="field-file">
          <label for="lr-adjuntos">Adjuntar archivos (opcional)</label>
          <input id="lr-adjuntos" type="file" name="attachment" multiple accept="image/*,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,video/*" aria-describedby="lr-adjuntos-ayuda" />
          <p id="lr-adjuntos-ayuda" class="text-small text-soft">Puedes adjuntar vouchers, estados de cuenta, imágenes u otros documentos para sustentar tu reclamo. Máx. 5 MB por archivo (10 MB total).</p>
        </div>
      </fieldset>

      <p class="legal">La formulación del reclamo no impide acudir a otras vías de solución de controversias ni es requisito previo para interponer una denuncia ante el INDECOPI. El proveedor debe dar respuesta al reclamo o queja en un plazo no mayor a quince (15) días hábiles, el cual es improrrogable. La respuesta será brindada mediante comunicación electrónica enviada a la dirección que has consignado. Si deseas que la respuesta te sea enviada a tu domicilio, indícalo en el detalle del reclamo o queja.</p>

      <p class="consent">Al enviar, aceptas que usemos tus datos para atender tu reclamo, según nuestra <a href="/politica-privacidad.html">Política de privacidad</a>.</p>
      <Button type="submit">Enviar reclamo</Button>
    </form>
    </div>
  </section>
</Base>

<script>
  if (new URLSearchParams(window.location.search).has('enviado')) {
    const sent = document.querySelector<HTMLElement>('[data-sent]');
    if (sent) sent.hidden = false;
  }
</script>

<style>
  /* Cuerpo: datos del proveedor y pasos a la izquierda, el formulario como hoja a la derecha */
  .l-body { display: grid; gap: var(--space-l); padding-block: var(--space-l) var(--section-gap); }
  .l-side { display: grid; gap: var(--space-s); align-content: start; align-self: start; }
  .card { display: grid; gap: var(--space-s); padding: var(--space-m); border-radius: var(--radius-card); background-color: var(--paper-0); box-shadow: inset 0 0 0 1px var(--paper-2); }
  .provider-card { background-color: var(--navy-50); box-shadow: none; }
  .side-title { display: flex; align-items: center; gap: 0.5em; color: var(--navy-700); font-size: var(--step-small); font-weight: var(--weight-bold); letter-spacing: 0.06em; text-transform: uppercase; }
  .side-title :global(svg) { color: var(--orange-500); }
  .provider { display: grid; gap: var(--space-xs); }
  .provider dt { color: var(--ink-600); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .provider dd { color: var(--navy-700); font-weight: var(--weight-semibold); }
  .how { display: grid; gap: var(--space-s); }
  .how li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-xs); align-items: start; font-size: var(--step-small); color: var(--ink-600); }
  .how span { display: grid; place-items: center; inline-size: 1.6rem; block-size: 1.6rem; border-radius: 50%; background-image: var(--gradient-warm); color: var(--ink-900); font-size: 0.8rem; font-weight: var(--weight-bold); }
  .how strong { color: var(--navy-700); }
  .sent { display: flex; gap: 0.5em; padding: var(--space-s) var(--space-m); border-radius: var(--radius-card); background-color: rgb(37 211 102 / 0.12); color: #128c4a; font-weight: var(--weight-semibold); }
  .sent[hidden] { display: none; }

  .sheet { min-inline-size: 0; padding: var(--space-m); border-radius: calc(var(--radius-card) + 0.4rem); background-color: var(--paper-0); box-shadow: 0 30px 60px -40px rgb(20 31 102 / 0.45), inset 0 0 0 1px var(--paper-2); }
  .form { display: grid; gap: var(--space-l); }
  fieldset { display: grid; gap: var(--space-m); border: 0; padding: 0; margin: 0; min-inline-size: 0; }
  legend { inline-size: 100%; padding: 0; }
  fieldset + fieldset legend { padding-block-start: var(--space-l); border-block-start: 1px solid var(--paper-2); }
  legend { margin-block-end: var(--space-s); color: var(--navy-700); font-family: var(--font-display); font-size: clamp(1.25rem, 1.1rem + 0.4vw, 1.5rem); line-height: var(--leading-head); }
  .cols { display: grid; gap: var(--space-m) var(--gutter); grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }

  /* Reclamo o queja como dos opciones grandes */
  .radios { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-s); }
  .radios label { display: flex; align-items: center; gap: var(--space-xs); min-block-size: 3.2rem; padding-inline: var(--space-s); border-radius: var(--radius-card); background-color: var(--paper-1); color: var(--navy-700); font-weight: var(--weight-bold); box-shadow: inset 0 0 0 1.5px var(--paper-2); cursor: pointer; transition: box-shadow var(--duration-hover) ease, background-color var(--duration-hover) ease; }
  .radios label:has(input:checked) { background-color: var(--orange-50); box-shadow: inset 0 0 0 2px var(--orange-500); }
  .radios input { inline-size: 1.15rem; block-size: 1.15rem; accent-color: var(--orange-500); }
  .defs { display: grid; gap: var(--space-2xs); padding: var(--space-s) var(--space-m); border-inline-start: 4px solid var(--orange-500); border-radius: 0 var(--radius-card) var(--radius-card) 0; background-color: var(--paper-1); font-size: var(--step-small); }
  .defs dt { display: inline; color: var(--navy-700); font-weight: var(--weight-bold); }
  .defs dt::after { content: ': '; }
  .defs dd { display: inline; color: var(--ink-600); }

  .field-file { display: grid; gap: var(--space-2xs); padding: var(--space-s); border: 1.5px dashed color-mix(in srgb, var(--navy-600) 35%, transparent); border-radius: var(--radius-card); background-color: var(--paper-1); }
  .field-file label { font-size: var(--step-small); font-weight: var(--weight-semibold); color: var(--navy-700); }
  .field-file input { font-size: var(--step-small); }

  .legal { padding: var(--space-s) var(--space-m); border-radius: var(--radius-card); background-color: var(--navy-50); color: var(--ink-600); font-size: var(--step-small); line-height: 1.6; max-inline-size: none; }
  .consent { margin-block-end: calc(-1 * var(--space-s)); color: var(--ink-600); font-size: var(--step-small); }
  .consent a { color: var(--navy-600); font-weight: var(--weight-semibold); }
  .form :global(.button) { justify-self: start; min-block-size: 3.2rem; padding-inline: 2rem; border-radius: var(--radius-pill); background-image: var(--gradient-warm); color: var(--ink-900); font-weight: var(--weight-bold); }

  @media (min-width: 48em) { .sheet { padding: var(--space-l) var(--space-xl); } }
  @media (min-width: 64em) {
    .l-body { grid-template-columns: minmax(0, 18rem) minmax(0, 1fr); gap: var(--space-xl); }
    .l-side { position: sticky; inset-block-start: calc(var(--header-height) + var(--space-m)); }
  }
</style>
