---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Prose from '@/components/ui/Prose.astro';
import { breadcrumb } from '@/lib/schema';
import { formatDate, isoDate } from '@/lib/dates';
import { site } from '@/config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const related = (await getCollection('blog')).filter((p) => p.id !== post.id).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const url = `${site.url}/blog/${post.id}.html`;
const schema = [
  breadcrumb([
    { name: 'Inicio', path: '/' },
    { name: 'Blog', path: '/blog.html' },
    { name: post.data.heading, path: `/blog/${post.id}.html` },
  ]),
  {
    '@type': 'BlogPosting',
    headline: post.data.heading,
    description: post.data.description,
    datePublished: isoDate(post.data.date),
    inLanguage: 'es',
    mainEntityOfPage: url,
    image: new URL(post.data.cover.src, site.url).href,
    author: { '@id': `${site.url}/#organizacion` },
    publisher: { '@id': `${site.url}/#organizacion` },
  },
];
---

<Base title={post.data.title} description={post.data.description} type="article" image={post.data.cover.src} schema={schema}>
  <article class="section page article">
    <Image src={post.data.cover} alt="" widths={[640, 960, 1280]} sizes="(min-width: 90rem) 88rem, 100vw" loading="eager" fetchpriority="high" class="cover" />
    <header class="head">
      <Breadcrumbs trail={[{ label: 'Blog', href: '/blog.html' }]} />
      <h1>{post.data.heading}</h1>
      <p class="meta"><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time></p>
    </header>
    <Prose><Content /></Prose>
    <aside class="cta theme-surface" aria-label="Asesoría" data-reveal>
      <p class="text-lead">¿Necesitas ayuda con tu tesis? Un asesor especialista te acompaña desde el proyecto hasta la sustentación.</p>
      <WhatsAppButton />
    </aside>
  </article>

  <section class="section page related" aria-labelledby="relacionados">
    <h2 id="relacionados" data-reveal>Sigue leyendo</h2>
    <ul role="list" data-reveal="stagger">
      {related.map((r) => (
        <li>
          <a href={`/blog/${r.id}.html`} class="rel-link">
            <Image src={r.data.cover} alt="" widths={[360, 540, 720]} sizes="(min-width: 64em) 30vw, 100vw" class="rel-img" />
            <h3>{r.data.heading}</h3>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .article { display: grid; gap: var(--space-l); justify-items: center; }
  .head { inline-size: 100%; max-inline-size: 60rem; }
  .cta { inline-size: 100%; max-inline-size: 42rem; }
  .head { display: grid; gap: var(--space-s); }
  .head h1 { max-inline-size: none; font-size: var(--step-lead); line-height: var(--leading-head); letter-spacing: var(--tracking-head); }
  @media (min-width: 48em) {
    .head h1 { font-size: min(var(--step-head), 2.5rem); }
  }
  .meta { color: var(--color-text-soft); font-size: var(--step-small); }
  .cover { inline-size: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  @media (min-width: 64em) {
    .cover { aspect-ratio: 21 / 9; }
  }


  .related { display: grid; gap: var(--space-l); }
  .related h2 { font-size: var(--step-head); }
  .related ul { display: grid; gap: var(--space-l); }
  .rel-link { display: grid; gap: var(--space-s); color: var(--color-text); text-decoration: none; }
  .rel-img { inline-size: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .rel-link h3 { font-size: var(--step-lead); line-height: var(--leading-lead); }
  @media (hover: hover) and (pointer: fine) {
    .rel-link:hover h3 { text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 0.07em; }
  }
  @media (min-width: 64em) {
    .related ul { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--gutter); }
  }
  .cta { display: grid; gap: var(--space-m); justify-items: start; padding: var(--space-l); margin-block-start: var(--space-l); }
</style>
