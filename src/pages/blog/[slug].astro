---
import { Picture } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import FormButton from '@/components/ui/FormButton.astro';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Prose from '@/components/ui/Prose.astro';
import Icon from '@/components/ui/Icon.astro';
import logoSvg from '@/assets/brand/logo.svg?raw';
import { breadcrumb } from '@/lib/schema';
import { formatDate, isoDate } from '@/lib/dates';
import { categoryLabel, categoryOf, readingMinutes } from '@/lib/blog';
import { site } from '@/config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const all = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const num = String(all.findIndex((p) => p.id === post.id) + 1).padStart(2, '0');
const related = (await getCollection('blog')).filter((p) => p.id !== post.id).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const url = `${site.url}/blog/${post.id}.html`;
const category = categoryLabel(categoryOf(post.id));
const minutes = readingMinutes(post.body);
const toc = headings.filter((h) => h.depth === 2);
const cube = logoSvg.replace(/viewBox="[^"]*"/, 'viewBox="0 0 1240 1236"');
const share = [
  { name: 'WhatsApp', icon: 'whatsapp', href: `https://wa.me/?text=${encodeURIComponent(`${post.data.heading} ${url}`)}` },
  { name: 'Facebook', icon: 'facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}` },
  { name: 'LinkedIn', icon: 'linkedin', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}` },
] as const;
const schema = [
  breadcrumb([
    { name: 'Inicio', path: '/' },
    { name: 'Blog', path: '/blog.html' },
    { name: post.data.heading, path: `/blog/${post.id}.html` },
  ]),
  {
    '@type': 'BlogPosting',
    headline: post.data.heading,
    description: post.data.description,
    datePublished: isoDate(post.data.date),
    inLanguage: 'es',
    mainEntityOfPage: url,
    image: new URL(post.data.cover.src, site.url).href,
    timeRequired: `PT${minutes}M`,
    articleSection: category,
    author: { '@id': `${site.url}/#organizacion` },
    publisher: { '@id': `${site.url}/#organizacion` },
  },
];
---

<Base title={post.data.title} description={post.data.description} type="article" image={post.data.cover.src} schema={schema}>
  <header class="a-hero custom-hero">
    <div class="page a-hero-grid">
      <div class="a-head">
        <Breadcrumbs trail={[{ label: 'Blog', href: '/blog.html' }]} current={category} inline />
        <div class="a-kicker">
          <span class="a-num" aria-hidden="true">{num}</span>
          <span class="a-kicker-text"><span class="a-tag">{category}</span><span class="a-issue">Artículo n.º {num} · Blog Científica</span></span>
        </div>
        <h1>{post.data.heading}</h1>
        <p class="a-lede">{post.data.description}</p>
        <div class="a-meta">
          <span class="a-author">
            <span class="a-avatar" aria-hidden="true"><Fragment set:html={cube} /></span>
            <span><strong>Equipo Científica Consultores</strong><small>Asesores de tesis e investigación</small></span>
          </span>
          <span class="a-facts">
            <span><Icon name="calendar" size="0.95rem" /><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time></span>
            <span><Icon name="clock" size="0.95rem" />{minutes} min de lectura</span>
          </span>
        </div>
      </div>
      <figure class="a-cover">
        <Picture src={post.data.cover} formats={['avif', 'webp']} quality={72} alt={post.data.heading} widths={[640, 960, 1280]} sizes="(min-width: 64em) 44vw, 100vw" loading="eager" fetchpriority="high" class="a-cover-img" />
      </figure>
    </div>
  </header>

  <div class="a-bar">
    <div class="page a-bar-in">
      <span class="a-bar-num" aria-hidden="true">{num}</span>
      <span class="a-bar-title">{post.data.heading}</span>
      <ul class="a-bar-share" role="list" aria-label="Compartir">
        {share.map((s) => <li><a class={`sh sh-${s.icon}`} href={s.href} target="_blank" rel="noopener" aria-label={`Compartir en ${s.name}`} title={s.name}><Icon name={s.icon} size="1rem" /></a></li>)}
        <li><button type="button" class="sh sh-copy" data-copy={url} aria-label="Copiar enlace" title="Copiar enlace"><Icon name="document" size="1rem" /></button></li>
      </ul>
    </div>
  </div>

  <div class="page a-body">
    <article class="a-article">
      {toc.length >= 2 && (
        <nav class="a-toc" aria-label="En este artículo">
          <p class="a-toc-title">En este artículo</p>
          <ol role="list">
            {toc.map((h, i) => <li><a href={`#${h.slug}`}><span class="toc-n">{String(i + 1).padStart(2, '0')}</span><span>{h.text}</span></a></li>)}
          </ol>
        </nav>
      )}

      <Prose><Content /></Prose>

      <div class="a-end-share">
        <p><strong>¿Te sirvió este artículo?</strong> Compártelo con alguien que esté haciendo su tesis.</p>
        <ul role="list">
          {share.map((s) => <li><a class={`sh sh-${s.icon}`} href={s.href} target="_blank" rel="noopener" aria-label={`Compartir en ${s.name}`} title={s.name}><Icon name={s.icon} size="1.05rem" /></a></li>)}
          <li><button type="button" class="sh sh-copy" data-copy={url} aria-label="Copiar enlace" title="Copiar enlace"><Icon name="document" size="1.05rem" /></button></li>
        </ul>
      </div>

      <aside class="a-cta" aria-label="Asesoría de tesis">
        <span class="a-cta-bg" aria-hidden="true"><span class="a-cta-cube"><Fragment set:html={cube} /></span></span>
        <div class="a-cta-copy">
          <span class="a-cta-tag"><span class="dot" aria-hidden="true"></span>Primera asesoría gratis</span>
          <p class="a-cta-title">¿Necesitas ayuda con <span>tu tesis</span>?</p>
          <p class="a-cta-text">Un asesor especialista de tu carrera te acompaña desde el proyecto hasta la sustentación.</p>
          <ul class="a-cta-perks" role="list">
            <li><Icon name="check" size="0.85rem" />Diagnóstico gratis de tu avance</li>
            <li><Icon name="check" size="0.85rem" />Asesor de tu misma carrera</li>
            <li><Icon name="check" size="0.85rem" />Respuesta en {site.replyTime}</li>
          </ul>
          <div class="a-cta-actions">
            <FormButton label="Quiero mi asesoría gratis" />
            <WhatsAppButton label="Escríbenos" message={`Hola, leí el artículo "${post.data.heading}" y quiero una asesoría.`} />
          </div>
        </div>
      </aside>
    </article>
  </div>

  {related.length > 0 && (
    <section class="a-related" aria-labelledby="relacionados">
      <div class="page">
        <header class="rel-head" data-reveal>
          <span class="eyebrow">Sigue leyendo</span>
          <h2 id="relacionados">Más artículos para ti</h2>
        </header>
        <ul class="rel-list" role="list" data-reveal="stagger">
          {related.map((r) => (
            <li>
              <a href={`/blog/${r.id}.html`} class="rel-card">
                <span class="rel-body">
                  <span class="rel-tag">{categoryLabel(categoryOf(r.id))}</span>
                  <span class="rel-title">{r.data.heading}</span>
                  <span class="rel-meta">{formatDate(r.data.date)} · {readingMinutes(r.body)} min</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<script>
  const live = document.createElement('p');
  live.className = 'visually-hidden'; live.setAttribute('role', 'status'); document.body.append(live);
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      let ok = true;
      try { await navigator.clipboard.writeText(btn.dataset.copy!); }
      catch {
        const t = document.createElement('textarea');
        t.value = btn.dataset.copy!; t.setAttribute('readonly', ''); t.className = 'visually-hidden';
        document.body.append(t); t.select();
        ok = document.execCommand('copy'); t.remove();
      }
      btn.dataset.tip = ok ? '¡Enlace copiado!' : 'No se pudo copiar';
      btn.classList.add('is-tip');
      live.textContent = btn.dataset.tip;
      setTimeout(() => btn.classList.remove('is-tip'), 1800);
    });
  });
</script>

<style>
  .a-hero { position: relative; overflow: hidden; isolation: isolate; padding-block: var(--space-l) var(--space-xl); background-color: var(--color-band, #e8edf9); }
  .a-hero::after { content: ''; position: absolute; z-index: -1; inset-block: 0; inset-inline-end: 0; inline-size: 38%; background-image: linear-gradient(160deg, #0f1650, var(--navy-700) 60%, #3b2fb0); border-start-start-radius: 0; }
  .a-hero-grid { display: grid; gap: var(--space-l); align-items: center; }
  .a-head { display: grid; gap: var(--space-s); justify-items: start; }
  .a-head :global(.crumb-bar.inline ol) { background-color: var(--paper-0); box-shadow: 0 6px 16px -10px rgb(15 22 80 / 0.4); }
  .a-head :global(.crumb-bar.inline a) { color: var(--navy-600); }
  .a-head :global(.crumb-bar.inline [aria-current='page']) { color: var(--navy-700); }
  .a-head :global(.crumb-bar.inline .sep), .a-head :global(.crumb-bar.inline a svg) { color: var(--orange-500); }
  .a-kicker { display: flex; align-items: center; gap: var(--space-s); }
  .a-num { font-family: var(--font-display); font-size: clamp(3.5rem, 2.6rem + 3vw, 5.5rem); font-weight: var(--weight-bold); line-height: 0.85; color: transparent; -webkit-text-stroke: 2px var(--orange-500); }
  .a-kicker-text { display: grid; gap: 0.35rem; justify-items: start; }
  .a-tag { padding: 0.3em 0.85em; border-radius: var(--radius-pill); background-color: var(--navy-700); color: var(--paper-0); font-size: var(--step-small); font-weight: var(--weight-bold); }
  .a-issue { color: var(--ink-600); font-size: 0.75rem; font-weight: var(--weight-semibold); letter-spacing: 0.06em; text-transform: uppercase; }
  .a-head h1 { max-inline-size: 22ch; color: var(--navy-700); font-size: clamp(2rem, 1.2rem + 2.4vw, 3.2rem); line-height: 1.08; letter-spacing: -0.02em; text-wrap: balance; }
  .a-lede { max-inline-size: 52ch; color: var(--ink-600); font-size: var(--step-lead); text-wrap: pretty; }
  .a-meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-s) var(--space-l); margin-block-start: var(--space-xs); padding-block-start: var(--space-s); border-block-start: 1px solid rgb(29 45 140 / 0.12); inline-size: 100%; }
  .a-author { display: inline-flex; align-items: center; gap: 0.6rem; }
  .a-author strong { display: block; color: var(--navy-700); font-size: var(--step-small); }
  .a-author small { display: block; color: var(--ink-600); font-size: 0.75rem; }
  .a-avatar { display: grid; place-items: center; inline-size: 2.4rem; block-size: 2.4rem; padding: 0.45rem; border-radius: 50%; background-color: var(--navy-700); color: var(--paper-0); box-shadow: 0 0 0 2px var(--orange-500); }
  .a-avatar :global(svg), .a-cta-cube :global(svg) { display: block; inline-size: 100%; block-size: auto; }
  .a-facts { display: inline-flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-s); color: var(--ink-600); font-size: var(--step-small); }
  .a-facts > span { display: inline-flex; align-items: center; gap: 0.4em; }
  .a-facts :global(svg) { color: var(--orange-500); }

  .a-cover { position: relative; margin: 0; }
  .a-cover::before { content: ''; position: absolute; z-index: -1; inset: 1.25rem -1.25rem -1.25rem 1.25rem; border-radius: calc(var(--radius-card) + 0.5rem); background-image: var(--gradient-warm); }
  .a-cover :global(.a-cover-img) { display: block; inline-size: 100%; block-size: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: calc(var(--radius-card) + 0.5rem); box-shadow: 0 40px 70px -35px rgb(5 10 50 / 0.7); }

  .a-bar { position: sticky; z-index: 5; inset-block-start: var(--header-height); background-color: rgb(250 251 255 / 0.92); backdrop-filter: saturate(1.4) blur(10px); border-block-end: 1px solid var(--paper-2); }
  .a-bar-in { display: flex; align-items: center; gap: var(--space-s); min-block-size: 3.4rem; }
  .a-bar-num { font-family: var(--font-display); font-size: 1.6rem; font-weight: var(--weight-bold); line-height: 1; color: transparent; -webkit-text-stroke: 1.2px var(--orange-ink); }
  .a-bar-title { flex: 1; min-inline-size: 0; overflow: hidden; color: var(--navy-700); font-size: var(--step-small); font-weight: var(--weight-semibold); text-overflow: ellipsis; white-space: nowrap; }
  .a-bar-share, .a-end-share ul { display: flex; gap: 0.35rem; }
  .sh { display: grid; place-items: center; inline-size: 2.3rem; block-size: 2.3rem; padding: 0; border: 0; border-radius: 50%; background-color: var(--paper-0); box-shadow: inset 0 0 0 1px var(--paper-2); cursor: pointer; transition: transform var(--duration-hover) var(--ease-out), box-shadow var(--duration-hover) ease; }
  .sh-whatsapp { color: #1fa855; }
  .sh-facebook { color: #1877f2; }
  .sh-linkedin { color: #0a66c2; }
  .sh-copy { color: var(--navy-600); }

  .a-body { padding-block: var(--space-xl) var(--section-gap); }
  .a-article { display: grid; gap: var(--space-xl); max-inline-size: 58rem; margin-inline: auto; min-inline-size: 0; }
  .a-toc { padding: var(--space-m) var(--space-l); border-radius: calc(var(--radius-card) + 0.25rem); background-color: var(--orange-50); box-shadow: inset 0 0 0 1px rgb(254 143 1 / 0.25); }
  .a-toc-title { margin-block-end: var(--space-s); color: var(--orange-ink); font-size: var(--step-small); font-weight: var(--weight-bold); letter-spacing: 0.08em; text-transform: uppercase; }
  .a-toc ol { display: grid; gap: var(--space-xs) var(--space-l); }
  .a-toc a { display: grid; grid-template-columns: 2.4rem minmax(0, 1fr); align-items: baseline; gap: 0.2rem; color: var(--navy-700); font-weight: var(--weight-semibold); line-height: 1.35; text-decoration: none; }
  .toc-n { font-family: var(--font-display); font-size: 1.3rem; font-weight: var(--weight-bold); line-height: 1; color: transparent; -webkit-text-stroke: 1px var(--orange-ink); }
  .a-end-share { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-s) var(--space-m); padding: var(--space-s) var(--space-m); border-radius: calc(var(--radius-card) + 0.25rem); background-color: var(--paper-0); box-shadow: inset 0 0 0 1px var(--paper-2); color: var(--ink-600); font-size: var(--step-small); }
  .a-end-share p { max-inline-size: none; }
  .a-end-share strong { color: var(--navy-700); }
  .sh-copy { position: relative; }
  .sh-copy::after { content: attr(data-tip); position: absolute; inset-block-end: calc(100% + 0.5rem); inset-inline-start: 50%; translate: -50% 0.25rem; padding: 0.35rem 0.7rem; border-radius: var(--radius-pill); background-color: var(--navy-700); color: var(--paper-0); font-size: 0.75rem; font-weight: var(--weight-bold); white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity 180ms ease, translate 180ms var(--ease-out); }
  .a-bar .sh-copy::after { inset-block: calc(100% + 0.5rem) auto; }
  .sh-copy.is-tip { box-shadow: inset 0 0 0 1.5px #1fa855; color: #1fa855; }
  .sh-copy.is-tip::after { opacity: 1; translate: -50% 0; }

  .a-article { display: grid; gap: var(--space-xl); min-inline-size: 0; }
  .a-article :global(.prose) { max-inline-size: none; color: var(--ink-700, var(--ink-600)); font-size: 1.125rem; line-height: 1.8; }
  .a-article :global(.prose :is(p, li)) { max-inline-size: none; }
  .a-article :global(.prose > p:has(> img) img) { inline-size: 100%; max-block-size: 34rem; object-fit: cover; }
  .a-article :global(.prose > p:first-child) { color: var(--ink-900); font-size: var(--step-lead); line-height: 1.65; }
  .a-article :global(.prose h2) { position: relative; scroll-margin-block-start: calc(var(--header-height) + 4.5rem); margin-block-start: var(--space-s); padding-inline-start: 1rem; color: var(--navy-700); font-family: var(--font-display); font-size: clamp(1.5rem, 1.25rem + 0.8vw, 2rem); font-weight: var(--weight-semibold, 600); line-height: 1.2; }
  .a-article :global(.prose h2::before) { content: ''; position: absolute; inset-block: 0.15em; inset-inline-start: 0; inline-size: 4px; border-radius: 4px; background-image: var(--gradient-warm); }
  .a-article :global(.prose h3) { margin-block-start: var(--space-2xs); color: var(--navy-700); font-size: var(--step-lead); font-weight: var(--weight-bold); }
  .a-article :global(.prose strong) { color: var(--navy-700); }
  .a-article :global(.prose a) { color: var(--navy-600); font-weight: var(--weight-semibold); text-decoration: underline; text-decoration-color: var(--orange-500); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .a-article :global(.prose ul) { list-style: none; padding-inline-start: 0; gap: var(--space-xs); }
  .a-article :global(.prose ul > li) { position: relative; padding-inline-start: 2rem; }
  .a-article :global(.prose ul > li::before) { content: '✓'; position: absolute; inset-inline-start: 0; inset-block-start: 0.2em; display: grid; place-items: center; inline-size: 1.35rem; block-size: 1.35rem; border-radius: 50%; background-color: var(--orange-50); color: var(--orange-600); font-size: 0.75rem; font-weight: 800; line-height: 1; }
  .a-article :global(.prose ol > li::marker) { color: var(--orange-600); font-weight: var(--weight-bold); }
  .a-article :global(.prose img) { margin-block: var(--space-s); border-radius: calc(var(--radius-card) + 0.25rem); box-shadow: 0 24px 50px -30px rgb(15 22 80 / 0.5); }
  .a-article :global(.prose table) { display: table; inline-size: 100%; border-collapse: separate; overflow-wrap: normal; word-break: normal; border-spacing: 0; border-radius: var(--radius-card); box-shadow: inset 0 0 0 1px var(--paper-2); font-size: var(--step-small); }
  .a-article :global(.prose caption) { caption-side: top; padding-block-end: var(--space-xs); color: var(--ink-600); font-size: 0.8rem; font-weight: var(--weight-semibold); text-align: start; }
  .a-article :global(.prose thead th) { padding: 0.85rem 1rem; background-color: var(--navy-700); color: var(--paper-0); font-weight: var(--weight-bold); border: 0; }
  .a-article :global(.prose thead th:first-child) { border-start-start-radius: var(--radius-card); }
  .a-article :global(.prose thead th:last-child) { border-start-end-radius: var(--radius-card); }
  .a-article :global(.prose tbody td) { padding: 0.85rem 1rem; border-block-end: 1px solid var(--paper-2); }
  .a-article :global(.prose tbody tr:nth-child(even) td) { background-color: var(--paper-1); }
  .a-article :global(.prose tbody td:first-child) { color: var(--navy-700); font-weight: var(--weight-bold); }
  .a-article :global(.prose blockquote) { margin: 0; padding: var(--space-s) var(--space-m); border-inline-start: 4px solid var(--orange-500); border-radius: 0 var(--radius-card) var(--radius-card) 0; background-color: var(--paper-1); color: var(--ink-900); }

  .a-cta { position: relative; isolation: isolate; display: grid; gap: var(--space-l); padding: var(--space-l) var(--space-m); border-radius: calc(var(--radius-card) + 0.75rem); color: var(--paper-0); box-shadow: 0 40px 70px -40px rgb(15 22 80 / 0.75); }
  .a-cta-bg { position: absolute; z-index: -1; inset: 0; overflow: hidden; border-radius: inherit; background-image: radial-gradient(circle at 85% 30%, rgb(254 143 1 / 0.28), transparent 45%), linear-gradient(150deg, #0f1650, var(--navy-700) 55%, #3b2fb0); }
  .a-cta-bg::before { content: ''; position: absolute; inset: 0 0 auto; block-size: 4px; background-image: linear-gradient(90deg, var(--orange-500), var(--gold-400), var(--sky-500)); }
  .a-cta-cube { position: absolute; inset-block-end: -5rem; inset-inline-start: -4rem; inline-size: 20rem; color: rgb(255 255 255 / 0.05); }
  .a-cta-cube :global(svg) { display: block; inline-size: 100%; block-size: auto; }
  .a-cta-copy { display: grid; gap: var(--space-xs); justify-items: start; align-content: center; }
  .a-cta-tag { display: inline-flex; align-items: center; gap: 0.5em; padding: 0.3em 0.8em; border-radius: var(--radius-pill); background-color: rgb(255 255 255 / 0.1); color: var(--gold-400); font-size: var(--step-small); font-weight: var(--weight-bold); letter-spacing: 0.06em; text-transform: uppercase; }
  .a-cta-tag .dot { inline-size: 0.5rem; block-size: 0.5rem; border-radius: 50%; background-color: var(--whatsapp-500); box-shadow: 0 0 0 3px rgb(37 211 102 / 0.25); }
  .a-cta-title { font-family: var(--font-display); font-size: clamp(1.7rem, 1.3rem + 1.4vw, 2.4rem); line-height: 1.1; }
  .a-cta-title span { color: var(--orange-500); }
  .a-cta-text { color: var(--navy-100); max-inline-size: 40ch; }
  .a-cta-perks { display: grid; gap: 0.45rem; margin-block: var(--space-2xs); }
  .a-cta-perks li { display: flex; align-items: center; gap: 0.55em; font-size: var(--step-small); font-weight: var(--weight-semibold); }
  .a-cta-perks :global(svg) { flex-shrink: 0; inline-size: 1.3rem; block-size: 1.3rem; padding: 0.22rem; border-radius: 50%; background-image: var(--gradient-warm); color: var(--ink-900); }
