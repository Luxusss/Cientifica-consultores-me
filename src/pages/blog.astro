---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import ContactBand from '@/components/sections/ContactBand.astro';
import { breadcrumb } from '@/lib/schema';
import { formatDate, isoDate } from '@/lib/dates';
import { site } from '@/config/site';
import { categories, categoryLabel, categoryOf, readingMinutes } from '@/lib/blog';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const label = categoryLabel;
const minutes = readingMinutes;

const schema = [
  breadcrumb([{ name: 'Inicio', path: '/' }, { name: 'Blog', path: '/blog.html' }]),
  {
    '@type': 'CollectionPage',
    name: 'Guías para tu tesis',
    url: `${site.url}/blog.html`,
    hasPart: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.heading, url: `${site.url}/blog/${p.id}.html`, datePublished: isoDate(p.data.date) })),
  },
];
---

<Base
  title="Blog de asesoría en tesis | Científica Consultores"
  description="Guías, consejos y recursos para hacer tu tesis de pregrado, maestría o doctorado. Asesoramiento académico experto de Científica Consultores."
  schema={schema}
>
  <section class="mag custom-hero" aria-labelledby="titulo" data-blog>
    <div class="page mag-inner">
      <header class="mag-head">
        <div class="mag-title">
          <span class="eyebrow mag-eyebrow">Blog académico · {posts.length} artículos</span>
          <h1 id="titulo">Tu guía para la tesis, <span class="mag-accent">paso a paso</span></h1>
          <p class="mag-lede">Guías prácticas y consejos de nuestros asesores para avanzar tu tesis sin bloquearte.</p>
        </div>
        <div class="mag-tools">
          <label class="mag-search">
            <Icon name="search" size="1.1rem" />
            <input type="search" aria-label="Buscar en el blog" placeholder="Busca un tema: proyecto, TSP, marco teórico…" autocomplete="off" data-blog-search />
          </label>
          <div class="chips" role="group" aria-label="Filtrar por categoría">
            {categories.map((c, i) => <button type="button" class="chip" data-cat={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>{c.label}</button>)}
          </div>
        </div>
      </header>

      <ul class="mag-grid" role="list">
        {posts.map((post, i) => (
          <li class:list={['post', { lead: i === 0 }]} data-cat={categoryOf(post.id)} data-text={`${post.data.heading} ${post.data.description}`.toLowerCase()}>
            <a href={`/blog/${post.id}.html`} class="post-link">
              <span class="cover-box">
                <Image src={post.data.cover} alt={post.data.title} widths={i === 0 ? [720, 1080, 1440] : [360, 540, 720]} sizes={i === 0 ? '(min-width: 48em) 50vw, 100vw' : '(min-width: 48em) 40vw, 100vw'} loading={i < 3 ? 'eager' : 'lazy'} class="cover" />
              </span>
              <span class="post-body">
                <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="post-tag">{i === 0 ? 'Último artículo · ' : ''}{label(categoryOf(post.id))}</span>
                <h2 class="post-title">{post.data.heading}</h2>
                <span class="excerpt">{post.data.description}</span>
                <span class="post-meta"><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time> · {minutes(post.body)} min de lectura</span>
                <span class="read">Leer artículo <span class="arrow" aria-hidden="true">→</span></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="empty" hidden data-empty>No encontramos artículos con ese tema. Escríbenos y te orientamos.</p>
    </div>
  </section>
  <Breadcrumbs current="Blog" />

  <ContactBand title="¿Prefieres que un asesor te guíe?" />
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-blog]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('[data-blog-search]');
    const posts = [...root.querySelectorAll<HTMLElement>('.post')];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('button[data-cat]')];
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const fold = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    let cat = 'todos';
    const apply = () => {
      const q = fold(input?.value.trim() ?? '');
      let shown = 0;
      for (const p of posts) {
        const ok = (cat === 'todos' || p.dataset.cat === cat) && (!q || fold(p.dataset.text ?? '').includes(q));
        p.hidden = !ok;
        if (ok) shown++;
      }
      empty.hidden = shown > 0;
    };
    chips.forEach((c) => c.addEventListener('click', () => {
      cat = c.dataset.cat ?? 'todos';
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
      apply();
    }));
    input?.addEventListener('input', apply);
  }
</script>

<style>
  /* Blog como lista editorial: fondo claro azulado de principio a fin, cada artículo en una fila */
  .mag { padding-block: var(--space-xl) var(--space-2xl); background-color: var(--color-band); color: var(--ink-900); }
  .mag-inner { display: grid; gap: var(--space-l); }
  .mag-head { display: grid; gap: var(--space-m) var(--gutter); align-items: end; padding-block-end: var(--space-m); border-block-end: 2px solid var(--navy-600); }
  .mag-title { display: grid; gap: var(--space-xs); justify-items: start; }
  .mag-eyebrow { background-color: var(--paper-0); color: var(--orange-600); }
  .mag-title h1 { color: var(--navy-700); font-size: clamp(2.2rem, 1.3rem + 1.9vw, 3.2rem); line-height: 1.05; letter-spacing: -0.03em; max-inline-size: none; }
  .mag-accent { color: var(--orange-500); }
  .mag-lede { color: var(--ink-600); font-size: var(--step-lead); max-inline-size: 48ch; }
  .mag-tools { display: grid; gap: var(--space-xs); }
  .mag-search { display: flex; align-items: center; gap: 0.6rem; padding: 0.35rem 0.5rem 0.35rem 1rem; border-radius: var(--radius-pill); background-color: var(--paper-0); color: var(--navy-600); box-shadow: var(--shadow-card); }
  .mag-search:focus-within { box-shadow: 0 0 0 2px var(--orange-500), var(--shadow-card); }
  .mag-search input { flex: 1; min-inline-size: 0; min-block-size: 2.6rem; border: 0; background: transparent; color: var(--ink-900); font: inherit; font-size: var(--step-ui); outline: none; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip { padding: 0.5em 1em; border: 0; border-radius: var(--radius-pill); background-color: var(--paper-0); color: var(--ink-600); font: inherit; font-size: var(--step-small); font-weight: var(--weight-semibold); cursor: pointer; box-shadow: var(--shadow-card); transition: background-color var(--duration-hover) ease, color var(--duration-hover) ease; }
  .chip[aria-pressed='true'] { background-image: var(--gradient-brand); color: var(--paper-0); }

  .mag-grid { display: grid; gap: var(--space-m); }
  .post[hidden] { display: none; }
  .post-link { display: grid; overflow: hidden; border-radius: calc(var(--radius-card) + 0.25rem); background-color: var(--paper-0); color: var(--ink-900); text-decoration: none; box-shadow: var(--shadow-card); transition: translate var(--duration-ui) var(--ease-out), box-shadow var(--duration-ui) ease; }
  .cover-box { display: block; overflow: hidden; background-color: var(--navy-50); }
  .cover { display: block; inline-size: 100%; block-size: 100%; aspect-ratio: 16 / 9; object-fit: cover; transition: transform var(--duration-reveal) var(--ease-out); }
  .post-body { display: grid; align-content: center; gap: var(--space-xs); padding: var(--space-m); }
  .post-tag { inline-size: fit-content; padding: 0.3em 0.8em; border-radius: var(--radius-pill); background-color: var(--orange-50); color: var(--orange-600); font-size: 0.72rem; font-weight: var(--weight-bold); letter-spacing: 0.03em; text-transform: uppercase; }
  .num { position: absolute; inset-block-start: var(--space-s); inset-inline-end: var(--space-m); font-family: var(--font-display); font-size: clamp(3.5rem, 2.5rem + 3vw, 6rem); font-weight: var(--weight-bold); line-height: 0.9; color: transparent; -webkit-text-stroke: 1.5px rgb(254 143 1 / 0.45); pointer-events: none; }
  .post-body { position: relative; }
  .post-title { max-inline-size: none; font-family: var(--font-display); font-size: var(--step-title); font-weight: var(--weight-semibold); line-height: 1.2; color: var(--navy-700); }
  .excerpt { color: var(--color-text-soft); font-size: var(--step-ui); line-height: var(--leading-body); }
  .post-meta { color: var(--ink-600); font-size: var(--step-small); }
  .read { display: inline-flex; align-items: center; gap: 0.4em; inline-size: fit-content; margin-block-start: var(--space-2xs); color: var(--navy-600); font-size: var(--step-ui); font-weight: var(--weight-bold); }
  .arrow { display: grid; place-items: center; inline-size: 1.9rem; block-size: 1.9rem; border-radius: 50%; background-color: var(--navy-50); transition: transform var(--duration-hover) var(--ease-out), background-color var(--duration-hover) ease; }
  .lead .post-tag { background-color: var(--orange-500); color: var(--ink-900); }
  .lead .post-title { font-size: clamp(1.5rem, 1.1rem + 1.1vw, 2.1rem); }
  .empty { padding: var(--space-l); border-radius: var(--radius-card); background-color: var(--paper-0); color: var(--ink-600); text-align: center; max-inline-size: none; }

  @media (min-width: 48em) {
    .post-link { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .post-body { padding: var(--space-m) var(--space-l); }
    .lead .post-link { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
    /* Zigzag: una fila con la portada a la izquierda y la siguiente a la derecha */
    .post:nth-child(odd):not(.lead) .post-link { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .post:nth-child(odd):not(.lead) .cover-box { order: 2; }
    .post-body { padding-inline-end: calc(var(--space-l) + 4rem); }
  }
  @media (min-width: 64em) {
    .mag-head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .lead .post-body { padding: var(--space-l) var(--space-xl); }
  }
  @media (hover: hover) and (pointer: fine) {
    .post-link:hover { translate: 0 -4px; box-shadow: var(--shadow-lift); }
    .post-link:hover .cover { transform: scale(1.04); }
    .post-link:hover .arrow { transform: translateX(4px); background-color: var(--orange-500); color: var(--ink-900); }
    .chip[aria-pressed='false']:hover { background-color: var(--orange-50); color: var(--orange-600); }
  }
</style>
