---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/ui/PageHero.astro';
import ContactBand from '@/components/sections/ContactBand.astro';
import { breadcrumb } from '@/lib/schema';
import { formatDate, isoDate } from '@/lib/dates';
import { site } from '@/config/site';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const schema = [
  breadcrumb([{ name: 'Inicio', path: '/' }, { name: 'Blog', path: '/blog.html' }]),
  {
    '@type': 'CollectionPage',
    name: 'Guías para tu tesis',
    url: `${site.url}/blog.html`,
    hasPart: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.heading, url: `${site.url}/blog/${p.id}.html`, datePublished: isoDate(p.data.date) })),
  },
];
---

<Base
  title="Blog de asesoría en tesis | Científica Consultores"
  description="Encuentra en nuestro blog guías, consejos y recursos para hacer tu tesis de pregrado, maestría o doctorado. Asesoramiento académico experto de Científica Consultores."
  schema={schema}
>
  <PageHero title="Guías para tu tesis" crumb="Blog" lede="Guías prácticas y recursos para tu tesis de pregrado, maestría o doctorado, escritas por nuestro equipo de asesores." />

  <section class="section page stack stack-l" aria-labelledby="articulos">
    <h2 id="articulos" class="posts-title" data-reveal>Todos los artículos</h2>
    <ul role="list" data-reveal="stagger">
      {posts.map((post, i) => (
        <li class:list={['post', { lead: i === 0 }]}>
          <a href={`/blog/${post.id}.html`} class="post-link">
            <Image src={post.data.cover} alt="" widths={[480, 720, 960]} sizes={i === 0 ? '(min-width: 64em) 58vw, 100vw' : '(min-width: 64em) 30vw, 100vw'} class="cover" />
            <h3 class="post-title">{post.data.heading}</h3>
            <p class="excerpt">{post.data.description}</p>
            <span class="meta"><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <ContactBand />
</Base>

<style>
  .posts-title { font-size: var(--step-head); }
  ul { display: grid; gap: var(--space-2xl); }
  .post-link { display: grid; gap: var(--space-s); color: var(--color-text); text-decoration: none; }
  .cover { inline-size: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .meta { color: var(--color-text-soft); font-size: var(--step-small); }
  .post-title { font-size: var(--step-lead); line-height: var(--leading-lead); max-inline-size: 30ch; }
  .excerpt { color: var(--color-text-soft); }

  @media (hover: hover) and (pointer: fine) {
    .post-link:hover .post-title { text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 0.07em; }
  }

  @media (min-width: 64em) {
    ul { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--gutter); }
    .lead { grid-column: 1 / -1; }
    .lead .post-link { grid-template-columns: 7fr 5fr; column-gap: var(--gutter); align-items: end; }
    .lead .cover { grid-row: 1 / span 3; }
  }
</style>
