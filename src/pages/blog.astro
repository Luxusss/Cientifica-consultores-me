---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import ContactBand from '@/components/sections/ContactBand.astro';
import { breadcrumb } from '@/lib/schema';
import { formatDate, isoDate } from '@/lib/dates';
import { site } from '@/config/site';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryOf = (id: string) => (/tesis|proyecto|suficiencia/.test(id) ? 'guias' : 'comunidad');
const categories = [
  { id: 'todos', label: 'Todos' },
  { id: 'guias', label: 'Guías de tesis' },
  { id: 'comunidad', label: 'Comunidad' },
];
const label = (c: string) => categories.find((x) => x.id === c)?.label ?? '';
const minutes = (body = '') => Math.max(2, Math.round(body.split(/\s+/).length / 200));

const schema = [
  breadcrumb([{ name: 'Inicio', path: '/' }, { name: 'Blog', path: '/blog.html' }]),
  {
    '@type': 'CollectionPage',
    name: 'Guías para tu tesis',
    url: `${site.url}/blog.html`,
    hasPart: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.heading, url: `${site.url}/blog/${p.id}.html`, datePublished: isoDate(p.data.date) })),
  },
];
---

<Base
  title="Blog de asesoría en tesis | Científica Consultores"
  description="Guías, consejos y recursos para hacer tu tesis de pregrado, maestría o doctorado. Asesoramiento académico experto de Científica Consultores."
  schema={schema}
>
  <section class="mag custom-hero" aria-labelledby="titulo" data-blog>
    <div class="page mag-inner">
      <header class="mag-head">
        <div class="mag-title">
          <span class="eyebrow mag-eyebrow">Blog académico · {posts.length} artículos</span>
          <h1 id="titulo">Tu guía para la tesis, <span class="mag-accent">paso a paso</span></h1>
          <p class="mag-lede">Guías prácticas y consejos de nuestros asesores para avanzar tu tesis sin bloquearte.</p>
        </div>
        <div class="mag-tools">
          <label class="mag-search">
            <Icon name="search" size="1.1rem" />
            <input type="search" aria-label="Buscar en el blog" placeholder="Busca un tema: proyecto, TSP, marco teórico…" autocomplete="off" data-blog-search />
          </label>
          <div class="chips" role="group" aria-label="Filtrar por categoría">
            {categories.map((c, i) => <button type="button" class="chip" data-cat={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>{c.label}</button>)}
          </div>
        </div>
      </header>

      <ul class="mag-grid" role="list">
        {posts.map((post, i) => (
          <li class:list={['post', { lead: i === 0 }]} data-cat={categoryOf(post.id)} data-text={`${post.data.heading} ${post.data.description}`.toLowerCase()}>
            <a href={`/blog/${post.id}.html`} class="post-link">
              <span class="cover-box">
                <Image src={post.data.cover} alt={post.data.title} widths={i === 0 ? [720, 1080, 1440] : [360, 540, 720]} sizes={i === 0 ? '(min-width: 64em) 58vw, 100vw' : '(min-width: 64em) 28vw, (min-width: 40em) 45vw, 100vw'} loading={i < 3 ? 'eager' : 'lazy'} class="cover" />
              </span>
              <span class="post-body">
                <span class="post-tag">{i === 0 ? 'Último artículo · ' : ''}{label(categoryOf(post.id))}</span>
                <h2 class="post-title">{post.data.heading}</h2>
                {i === 0 && <span class="excerpt">{post.data.description}</span>}
                <span class="post-meta"><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time> · {minutes(post.body)} min de lectura</span>
                <span class="read">Leer artículo <span class="arrow" aria-hidden="true">→</span></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="empty" hidden data-empty>No encontramos artículos con ese tema. Escríbenos y te orientamos.</p>
    </div>
  </section>
  <Breadcrumbs current="Blog" />

  <ContactBand title="¿Prefieres que un asesor te guíe?" />
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-blog]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('[data-blog-search]');
    const posts = [...root.querySelectorAll<HTMLElement>('.post')];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('button[data-cat]')];
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const fold = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    let cat = 'todos';
    const apply = () => {
      const q = fold(input?.value.trim() ?? '');
      let shown = 0;
      for (const p of posts) {
        const ok = (cat === 'todos' || p.dataset.cat === cat) && (!q || fold(p.dataset.text ?? '').includes(q));
        p.hidden = !ok;
        if (ok) shown++;
      }
      // Con filtro activo, ningún artículo se destaca: todos van del mismo tamaño
      root.classList.toggle('filtered', cat !== 'todos' || q.length > 0);
      empty.hidden = shown > 0;
    };
    chips.forEach((c) => c.addEventListener('click', () => {
      cat = c.dataset.cat ?? 'todos';
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
      apply();
    }));
    input?.addEventListener('input', apply);
  }
</script>

<style>
  /* Blog como revista: fondo azul profundo, el último artículo en grande y el resto alrededor */
  .mag { position: relative; overflow: hidden; isolation: isolate; padding-block: var(--space-xl) var(--space-2xl); background: linear-gradient(180deg, #0f1650 0%, var(--navy-700) 55%, var(--navy-600) 100%); color: var(--paper-0); }
  .mag::before { content: ''; position: absolute; inset: 0 0 auto; z-index: -1; block-size: 4px; background-image: linear-gradient(90deg, var(--orange-500), var(--gold-400)); }
  .mag-inner { display: grid; gap: var(--space-l); }
  .mag-head { display: grid; gap: var(--space-m) var(--gutter); align-items: end; padding-block-end: var(--space-m); border-block-end: 1px solid rgb(255 255 255 / 0.12); }
  .mag-title { display: grid; gap: var(--space-xs); justify-items: start; }
  .mag-eyebrow { background-color: rgb(255 255 255 / 0.1); color: var(--gold-400); }
  .mag-title h1 { color: var(--paper-0); font-size: clamp(2.2rem, 1.3rem + 1.9vw, 3.2rem); line-height: 1.05; letter-spacing: -0.03em; max-inline-size: none; }
  .mag-accent { color: var(--orange-500); }
  .mag-lede { color: var(--navy-100); font-size: var(--step-lead); max-inline-size: 48ch; }
  .mag-tools { display: grid; gap: var(--space-xs); }
  .mag-search { display: flex; align-items: center; gap: 0.6rem; padding: 0.35rem 0.5rem 0.35rem 1rem; border-radius: var(--radius-pill); background-color: var(--paper-0); color: var(--navy-600); box-shadow: 0 14px 30px -16px rgb(0 0 0 / 0.6); }
  .mag-search:focus-within { box-shadow: 0 0 0 3px var(--orange-500), 0 14px 30px -16px rgb(0 0 0 / 0.6); }
  .mag-search input { flex: 1; min-inline-size: 0; min-block-size: 2.6rem; border: 0; background: transparent; color: var(--ink-900); font: inherit; font-size: var(--step-ui); outline: none; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip { padding: 0.5em 1em; border: 0; border-radius: var(--radius-pill); background-color: rgb(255 255 255 / 0.08); color: var(--navy-100); font: inherit; font-size: var(--step-small); font-weight: var(--weight-semibold); cursor: pointer; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16); transition: background-color var(--duration-hover) ease, color var(--duration-hover) ease; }
  .chip[aria-pressed='true'] { background-color: var(--orange-500); color: var(--ink-900); box-shadow: none; }

  .mag-grid { display: grid; gap: var(--space-m); grid-template-columns: 1fr; }
  .post[hidden] { display: none; }
  .post-link { position: relative; display: grid; grid-template-rows: auto 1fr; block-size: 100%; overflow: hidden; border-radius: var(--radius-card); background-color: rgb(255 255 255 / 0.06); color: var(--paper-0); text-decoration: none; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1); transition: translate var(--duration-ui) var(--ease-out), background-color var(--duration-ui) ease, box-shadow var(--duration-ui) ease; }
  .cover-box { display: block; overflow: hidden; }
  .cover { display: block; inline-size: 100%; aspect-ratio: 16 / 9; object-fit: cover; transition: transform var(--duration-reveal) var(--ease-out); }
  .post-body { display: grid; align-content: start; gap: 0.4rem; padding: var(--space-s) var(--space-m) var(--space-m); }
  .post-tag { inline-size: fit-content; padding: 0.25em 0.7em; border-radius: var(--radius-pill); background-color: rgb(254 143 1 / 0.16); color: var(--gold-400); font-size: 0.72rem; font-weight: var(--weight-bold); letter-spacing: 0.03em; text-transform: uppercase; }
  .post-title { font-family: var(--font-text); font-size: var(--step-body); font-weight: var(--weight-semibold); line-height: 1.3; color: var(--paper-0); }
  .post-meta { color: var(--navy-100); font-size: var(--step-small); }
  .excerpt { color: var(--navy-100); font-size: var(--step-ui); line-height: var(--leading-body); }
  .read { margin-block-start: var(--space-2xs); color: var(--orange-500); font-size: var(--step-small); font-weight: var(--weight-bold); }
  .arrow { display: inline-block; transition: transform var(--duration-hover) var(--ease-out); }
  .empty { padding: var(--space-l); border-radius: var(--radius-card); background-color: rgb(255 255 255 / 0.06); color: var(--navy-100); text-align: center; max-inline-size: none; }

  /* Destacado: portada completa (sin recortar su texto) y el contenido debajo, más grande */
  .lead .post-body { gap: var(--space-xs); padding: var(--space-m) var(--space-l) var(--space-l); }
  .lead .post-tag { background-color: var(--orange-500); color: var(--ink-900); }
  .lead .post-title { font-family: var(--font-display); font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem); line-height: 1.15; }
  .lead .read { display: inline-flex; inline-size: fit-content; padding: 0.55em 1.1em; border-radius: var(--radius-pill); background-color: var(--paper-0); color: var(--navy-700); font-size: var(--step-ui); }

  @media (min-width: 40em) { .mag-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .lead { grid-column: 1 / -1; } }
  @media (min-width: 64em) {
    .mag-head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .mag-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; }
    .post:not(.lead) .excerpt { display: none; }
    .lead { grid-column: span 2; grid-row: span 2; }
    .filtered .lead { grid-column: auto; grid-row: auto; }
  }
  @media (hover: hover) and (pointer: fine) {
    .post-link:hover { translate: 0 -4px; background-color: rgb(255 255 255 / 0.1); box-shadow: inset 0 0 0 1px rgb(254 143 1 / 0.6), 0 24px 48px -24px rgb(0 0 0 / 0.6); }
    .post-link:hover .cover { transform: scale(1.05); }
    .post-link:hover .arrow { transform: translateX(4px); }
    .chip[aria-pressed='false']:hover { background-color: rgb(255 255 255 / 0.16); color: var(--paper-0); }
  }
</style>
