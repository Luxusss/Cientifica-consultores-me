---
import { Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import FormCard from '@/components/forms/FormCard.astro';
import PageHero from '@/components/ui/PageHero.astro';
import PointsBlock from '@/components/sections/PointsBlock.astro';
import CareerAreas from '@/components/sections/CareerAreas.astro';
import Stages from '@/components/home/Stages.astro';
import FaqText from '@/components/sections/FaqText.astro';
import ContactBand from '@/components/sections/ContactBand.astro';
import PhotoBand from '@/components/sections/PhotoBand.astro';
import type { ServicePage } from '@/data/servicePages';
import { breadcrumb, faqPage } from '@/lib/schema';
import { site } from '@/config/site';

interface Props {
  page: ServicePage;
}

const { page } = Astro.props;
const schema = [
  breadcrumb([
    { name: 'Inicio', path: '/' },
    { name: page.crumb, path: page.path },
  ]),
  {
    '@type': 'Service',
    name: page.h1,
    description: page.description,
    provider: { '@id': `${site.url}/#organizacion` },
    areaServed: site.countries,
    url: new URL(page.path, site.url).href,
  },
  faqPage(page.faq),
];
---

<Base title={page.title} description={page.description} schema={schema}>
  <PageHero title={page.h1} crumb={page.crumb} subtitle={page.subtitle} lede={page.lede}>
    <FormCard title="Pide tu primera asesoría gratis" subject={page.formSubject} variant="short" submitLabel="Quiero asesoría" />
    <Picture slot="media" formats={['avif', 'webp']} quality={70} src={page.image} alt={page.imageAlt} widths={[480, 720, 960]} sizes="(min-width: 64em) 40vw, 100vw" loading="eager" fetchpriority="high" />
  </PageHero>

  {page.extra?.map((block) => <PointsBlock block={block} />)}
  <PointsBlock block={page.includes} surface />
  <CareerAreas />
  <PhotoBand />
  <Stages initial={page.id} />
  <PointsBlock block={page.why} />
  <FaqText items={page.faq} />
  <ContactBand />
</Base>
