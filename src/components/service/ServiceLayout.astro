---
import { Image, Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import FormCard from '@/components/forms/FormCard.astro';
import PageHero from '@/components/ui/PageHero.astro';
import PointsBlock from '@/components/sections/PointsBlock.astro';
import CareerAreas from '@/components/sections/CareerAreas.astro';
import Stages from '@/components/home/Stages.astro';
import FaqText from '@/components/sections/FaqText.astro';
import ContactBand from '@/components/sections/ContactBand.astro';
import TextBlock from '@/components/sections/TextBlock.astro';
import ListBlock from '@/components/sections/ListBlock.astro';
import CtaBlock from '@/components/sections/CtaBlock.astro';
import type { ServicePage } from '@/data/servicePages';
import { breadcrumb, faqPage } from '@/lib/schema';
import { site, whatsappUrl } from '@/config/site';
import { stats } from '@/data/stats';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  page: ServicePage;
}

const { page } = Astro.props;
// Título en dos partes: la segunda va resaltada ("Asesoría de tesis" + "de pregrado")
const split = page.h1.match(/^(Asesoría de (?:tesis|trabajo))\s+(.+)$/i);
const h1Main = split ? split[1] : page.h1;
const h1Tail = split ? split[2] : '';
const trust = [
  { icon: 'user', text: 'Asesor de tu carrera' },
  { icon: 'shield', text: 'Contrato digital' },
  { icon: 'document', text: 'Originalidad con Turnitin' },
] as const;
// ¿En qué punto estás? Cuatro situaciones; al elegir una se muestra qué hacemos en ese caso
const moments = [
  { icon: 'search', title: 'Empiezo desde cero', lead: 'Te ayudamos a arrancar con un rumbo claro.', steps: ['Elegimos un tema viable y con fuentes', 'Planteamos el problema y los objetivos', 'Armamos el proyecto según tu universidad'] },
  { icon: 'pen', title: 'Estoy redactando', lead: 'Avanzas capítulo por capítulo, sin trabarte.', steps: ['Revisamos tu marco teórico y metodología', 'Te apoyamos en el análisis de tus datos', 'Cuidamos redacción, citas y normas APA'] },
  { icon: 'list', title: 'Me observaron la tesis', lead: 'Convertimos las observaciones en tareas concretas.', steps: ['Te explicamos cada observación del jurado', 'Priorizamos qué corregir primero', 'Revisamos las correcciones antes de entregar'] },
  { icon: 'user', title: 'Voy a sustentar', lead: 'Llegas a la defensa seguro de tu trabajo.', steps: ['Armamos tu presentación y diapositivas', 'Ensayamos las preguntas más probables', 'Te damos técnicas para exponer con calma'] },
] as const;
const eyebrows: Record<string, string> = {
  metodo: 'Nuestro método', 'por-que': 'Por qué elegirnos', incluye: 'Qué incluye', normativa: 'Tu universidad', tipos: 'Tipos de asesoría',
  empezar: 'Para empezar', online: '100 % online', confianza: 'Confianza', etapas: 'Paso a paso',
};
// Fondos alternos: la presentación va en blanco y luego se intercalan franjas azul suave
const rendered = page.sections.filter((sec) => sec.kind !== 'photos');
const band = (sec: (typeof page.sections)[number]) => rendered.indexOf(sec) % 2 === 0;
const schema = [
  breadcrumb([
    { name: 'Inicio', path: '/' },
    { name: page.crumb, path: page.path },
  ]),
  {
    '@type': 'Service',
    name: page.h1,
    description: page.description,
    provider: { '@id': `${site.url}/#organizacion` },
    areaServed: site.countries,
    url: new URL(page.path, site.url).href,
  },
  faqPage(page.faq),
];
---

<Base title={page.title} description={page.description} image={`/og/${page.id}.jpg`} schema={schema}>
  <PageHero title={page.h1} crumb={page.crumb} lede={page.lede} balance="photo">
    <Fragment slot="title">{h1Main}{h1Tail && <> <span class="h1-tail">{h1Tail}</span></>}</Fragment>
    <ul class="trust" role="list">
      {trust.map((t) => <li><span class="trust-ico"><Icon name={t.icon} size="0.95rem" /></span>{t.text}</li>)}
    </ul>
    <FormCard title="¡Obtén tu primera asesoría gratis!" subject={page.formSubject} variant="short" submitLabel="Quiero asesoría" />
    <Picture slot="media" formats={['avif', 'webp']} quality={80} src={page.image} alt={page.imageAlt} widths={[960, 1280, 1570]} sizes="100vw" loading="eager" fetchpriority="high" />
  </PageHero>

  <section class="section-wide standfirst" aria-label="Presentación">
    <div class="page intro">
      <div class="intro-copy" data-reveal>
        <span class="eyebrow">Sobre el servicio</span>
        {page.intro.map((t) => <p>{t}</p>)}
      </div>
      {page.introImage ? (
        <div class="intro-pic" data-reveal>
          <Image src={page.introImage} alt={page.introAlt} widths={[480, 720, 960]} sizes="(min-width: 64em) 40vw, 100vw" class="intro-img" />
        </div>
      ) : (
        <div class="moments-wrap" data-reveal data-moments>
          <p class="moments-title">¿En qué punto estás?</p>
          <div class="m-tabs" role="tablist" aria-label="Elige tu situación">
            {moments.map((m, i) => (
              <button type="button" role="tab" class:list={['m-tab', i % 2 ? 'tone-6' : 'tone-1']} id={`m-tab-${i}`} aria-controls={`m-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-m-tab>
                <span class="m-icon" aria-hidden="true"><Icon name={m.icon} size="1.05rem" /></span>
                {m.title}
              </button>
            ))}
          </div>
          {moments.map((m, i) => (
            <div class:list={['m-panel', i % 2 ? 'tone-6' : 'tone-1']} id={`m-panel-${i}`} role="tabpanel" aria-labelledby={`m-tab-${i}`} hidden={i !== 0} data-m-panel>
              <p class="m-lead">{m.lead}</p>
              <ol class="m-steps" role="list">
                {m.steps.map((st, k) => <li><span class="m-num">{k + 1}</span>{st}</li>)}
              </ol>
              <a class="m-wa" href={whatsappUrl(`Hola, estoy en esta etapa de mi tesis de pregrado: ${m.title.toLowerCase()}. ¿Me pueden orientar?`)} target="_blank" rel="noopener">
                <Icon name="whatsapp" size="1.05rem" /> Cuéntanos tu caso por WhatsApp
              </a>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  {page.sections.map((sec) => {
    if (sec.kind === 'points') return <PointsBlock block={sec} eyebrow={eyebrows[sec.id]} band={band(sec)} />;
    if (sec.kind === 'text') return <TextBlock id={sec.id} title={sec.title} text={sec.text} eyebrow={eyebrows[sec.id]} band={band(sec)} image={sec.image} />;
    if (sec.kind === 'list') return <ListBlock id={sec.id} title={sec.title} intro={sec.intro} items={sec.items} eyebrow={eyebrows[sec.id]} band={band(sec)} />;
    if (sec.kind === 'careers') return <CareerAreas title={sec.title} intro={sec.intro} prefix={sec.prefix} band={band(sec)} />;
    if (sec.kind === 'stages') return <Stages initial={page.id} title={sec.title} band={band(sec)} only />;
    if (sec.kind === 'cta') return <CtaBlock id={sec.id} title={sec.title} text={sec.text} band={band(sec)} />;
    return null;
  })}
  <FaqText items={page.faq} title={page.faqTitle} />
  <ContactBand />
</Base>

<script>
  // Pestañas de "¿En qué punto estás?"
  for (const root of document.querySelectorAll<HTMLElement>('[data-moments]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-m-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-m-panel]')];
    const show = (n: number, focus = false) => {
      const i = (n + tabs.length) % tabs.length;
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(j === i)); t.tabIndex = j === i ? 0 : -1; });
      panels.forEach((p, j) => { p.hidden = j !== i; });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, j) => {
      t.addEventListener('click', () => show(j));
      t.addEventListener('keydown', (e) => {
        const n = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? j + 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? j - 1 : null;
        if (n !== null) { e.preventDefault(); show(n, true); }
      });
    });
  }
</script>

<style>
  /* Hero */
  .h1-tail { display: block; margin-block-start: 0.12em; padding-block-end: 0.12em; font-size: 0.62em; line-height: 1.1; background-image: linear-gradient(90deg, var(--gold-400), var(--orange-500) 60%, #ff7a59); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .trust { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .trust li { display: inline-flex; align-items: center; gap: 0.5em; padding: 0.35em 0.85em 0.35em 0.4em; border-radius: var(--radius-pill); background-color: rgb(255 255 255 / 0.1); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16); color: var(--paper-0); font-size: var(--step-small); font-weight: var(--weight-semibold); backdrop-filter: blur(6px); }
  .trust-ico { display: grid; place-items: center; inline-size: 1.6rem; block-size: 1.6rem; border-radius: 50%; background-color: var(--orange-500); color: var(--ink-900); }

  /* Presentación */
  .intro { display: grid; gap: var(--space-l) var(--gutter); align-items: center; }
  .intro-copy { align-self: stretch; align-content: center; display: grid; gap: var(--space-s); justify-items: start; padding: var(--space-l); border-radius: calc(var(--radius-card) + 0.35rem); background-color: var(--paper-0); box-shadow: var(--shadow-card); border-inline-start: 5px solid var(--orange-500); }
  .intro-copy p { color: var(--color-text-soft); font-size: var(--step-lead); line-height: var(--leading-lead); max-inline-size: 70ch; }
  .moments-wrap { display: grid; gap: var(--space-s); }
  .moments-title { font-family: var(--font-display); font-size: var(--step-title); font-weight: var(--weight-semibold); color: var(--ink-900); }
  .m-tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2xs); }
  .m-tab { display: flex; align-items: center; gap: 0.6em; padding: 0.55rem 0.8rem 0.55rem 0.55rem; border: 0; border-radius: var(--radius-card); background-color: var(--paper-0); color: var(--ink-900); font: inherit; font-size: var(--step-ui); font-weight: var(--weight-semibold); text-align: start; cursor: pointer; box-shadow: var(--shadow-card); transition: background-color var(--duration-ui) ease, color var(--duration-ui) ease, transform var(--duration-ui) var(--ease-out); }
  .m-icon { display: grid; place-items: center; flex-shrink: 0; inline-size: 2.3rem; block-size: 2.3rem; border-radius: 0.75rem; background-color: var(--tone-soft); color: var(--tone); transition: background var(--duration-ui) ease, color var(--duration-ui) ease; }
  .m-tab[aria-selected='true'] { background-image: var(--gradient-brand); color: var(--paper-0); }
  .m-tab[aria-selected='true'] .m-icon { background-image: var(--tone-grad); color: var(--paper-0); }
  .m-tab:focus-visible { outline: var(--focus-ring); outline-offset: 2px; }
  .m-panel { display: grid; gap: var(--space-s); padding: var(--space-m); border-radius: var(--radius-card); background: linear-gradient(150deg, var(--tone-soft), var(--paper-0) 70%); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--tone) 22%, transparent); }
  .m-panel[hidden] { display: none; }
  .m-lead { font-family: var(--font-display); font-size: var(--step-title); font-weight: var(--weight-semibold); color: var(--ink-900); }
  .m-steps { display: grid; gap: 0.5rem; }
  .m-steps li { display: flex; align-items: center; gap: 0.7em; color: var(--ink-600); font-size: var(--step-ui); font-weight: var(--weight-medium); }
  .m-num { display: grid; place-items: center; flex-shrink: 0; inline-size: 1.7rem; block-size: 1.7rem; border-radius: 50%; background-image: var(--tone-grad); color: var(--paper-0); font-size: var(--step-small); font-weight: var(--weight-bold); }
  .m-wa { display: inline-flex; align-items: center; gap: 0.5em; inline-size: fit-content; padding: 0.55em 1.1em; border-radius: var(--radius-pill); background-color: var(--whatsapp-500); color: var(--ink-900); font-size: var(--step-ui); font-weight: var(--weight-bold); text-decoration: none; transition: background-color var(--duration-hover) ease; }
  @media (hover: hover) and (pointer: fine) {
    .m-tab:not([aria-selected='true']):hover { transform: translateY(-2px); background-color: var(--orange-50); }
    .m-wa:hover { background-color: var(--whatsapp-600); color: var(--ink-900); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .m-panel:not([hidden]) { animation: m-in 380ms var(--ease-out); }
    @keyframes m-in { from { opacity: 0; transform: translateY(6px); } }
  }
  .intro-pic { overflow: hidden; border-radius: calc(var(--radius-card) + 0.35rem); box-shadow: var(--shadow-card); }
  .intro-img { display: block; inline-size: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 25%; }

  @media (min-width: 64em) {
    .intro { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  }
</style>
