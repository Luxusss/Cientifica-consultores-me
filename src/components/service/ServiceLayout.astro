---
import { Image, Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import FormCard from '@/components/forms/FormCard.astro';
import PageHero from '@/components/ui/PageHero.astro';
import PointsBlock from '@/components/sections/PointsBlock.astro';
import CareerAreas from '@/components/sections/CareerAreas.astro';
import Stages from '@/components/home/Stages.astro';
import FaqText from '@/components/sections/FaqText.astro';
import ContactBand from '@/components/sections/ContactBand.astro';
import TextBlock from '@/components/sections/TextBlock.astro';
import ListBlock from '@/components/sections/ListBlock.astro';
import CtaBlock from '@/components/sections/CtaBlock.astro';
import type { ServicePage } from '@/data/servicePages';
import { breadcrumb, faqPage } from '@/lib/schema';
import { site } from '@/config/site';
import { stats } from '@/data/stats';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  page: ServicePage;
}

const { page } = Astro.props;
// Título en dos partes: la segunda va resaltada ("Asesoría de tesis" + "de pregrado")
const split = page.h1.match(/^(Asesoría de (?:tesis|trabajo))\s+(.+)$/i);
const h1Main = split ? split[1] : page.h1;
const h1Tail = split ? split[2] : '';
const trust = [
  { icon: 'user', text: 'Asesor de tu carrera' },
  { icon: 'shield', text: 'Contrato digital' },
  { icon: 'document', text: 'Originalidad con Turnitin' },
] as const;
const facts = [
  { value: Number(stats.years), label: 'años de experiencia' },
  { value: Number(stats.clients), label: 'tesistas asesorados' },
  { value: Number(stats.universities), label: 'universidades' },
  { value: Number(stats.countries), label: 'países' },
];
const eyebrows: Record<string, string> = {
  metodo: 'Nuestro método', 'por-que': 'Por qué elegirnos', incluye: 'Qué incluye', normativa: 'Tu universidad', tipos: 'Tipos de asesoría',
  empezar: 'Para empezar', online: '100 % online', confianza: 'Confianza', etapas: 'Paso a paso',
};
// Fondos alternos: la presentación va en blanco y luego se intercalan franjas azul suave
const rendered = page.sections.filter((sec) => sec.kind !== 'photos');
const band = (sec: (typeof page.sections)[number]) => rendered.indexOf(sec) % 2 === 0;
const schema = [
  breadcrumb([
    { name: 'Inicio', path: '/' },
    { name: page.crumb, path: page.path },
  ]),
  {
    '@type': 'Service',
    name: page.h1,
    description: page.description,
    provider: { '@id': `${site.url}/#organizacion` },
    areaServed: site.countries,
    url: new URL(page.path, site.url).href,
  },
  faqPage(page.faq),
];
---

<Base title={page.title} description={page.description} image={`/og/${page.id}.jpg`} schema={schema}>
  <PageHero title={page.h1} crumb={page.crumb} lede={page.lede} balance="photo">
    <Fragment slot="title">{h1Main}{h1Tail && <> <span class="h1-tail">{h1Tail}</span></>}</Fragment>
    <ul class="trust" role="list">
      {trust.map((t) => <li><span class="trust-ico"><Icon name={t.icon} size="0.95rem" /></span>{t.text}</li>)}
    </ul>
    <FormCard title="¡Obtén tu primera asesoría gratis!" subject={page.formSubject} variant="short" submitLabel="Quiero asesoría" />
    <Picture slot="media" formats={['avif', 'webp']} quality={80} src={page.image} alt={page.imageAlt} widths={[960, 1280, 1570]} sizes="100vw" loading="eager" fetchpriority="high" />
  </PageHero>

  <section class="section-wide standfirst" aria-label="Presentación">
    <div class="page intro">
      {page.introImage ? (
        <div class="intro-pic" data-reveal>
          <Image src={page.introImage} alt={page.introAlt} widths={[480, 720, 960]} sizes="(min-width: 64em) 40vw, 100vw" class="intro-img" />
        </div>
      ) : (
        <ul class="facts" role="list" data-reveal="stagger" data-svc-counters>
          {facts.map((f, i) => <li class:list={['fact', i % 2 ? 'tone-6' : 'tone-1']}><strong>+<span data-count={f.value}>{f.value}</span></strong><span>{f.label}</span></li>)}
        </ul>
      )}
      <div class="intro-copy" data-reveal>
        <span class="eyebrow">Sobre el servicio</span>
        {page.intro.map((t) => <p>{t}</p>)}
      </div>
    </div>
  </section>

  {page.sections.map((sec) => {
    if (sec.kind === 'points') return <PointsBlock block={sec} eyebrow={eyebrows[sec.id]} band={band(sec)} />;
    if (sec.kind === 'text') return <TextBlock id={sec.id} title={sec.title} text={sec.text} eyebrow={eyebrows[sec.id]} band={band(sec)} image={sec.image} />;
    if (sec.kind === 'list') return <ListBlock id={sec.id} title={sec.title} intro={sec.intro} items={sec.items} eyebrow={eyebrows[sec.id]} band={band(sec)} />;
    if (sec.kind === 'careers') return <CareerAreas title={sec.title} intro={sec.intro} prefix={sec.prefix} band={band(sec)} />;
    if (sec.kind === 'stages') return <Stages initial={page.id} title={sec.title} band={band(sec)} only />;
    if (sec.kind === 'cta') return <CtaBlock id={sec.id} title={sec.title} text={sec.text} band={band(sec)} />;
    return null;
  })}
  <FaqText items={page.faq} title={page.faqTitle} />
  <ContactBand />
</Base>

<script>
  // Las cifras cuentan desde 0 una sola vez, al quedar a la vista
  const box = document.querySelector<HTMLElement>('[data-svc-counters]');
  if (box && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const nums = [...box.querySelectorAll<HTMLElement>('[data-count]')];
    for (const n of nums) n.textContent = '0';
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const start = performance.now();
      const tick = (now: number) => {
        const k = Math.min(1, (now - start) / 1800);
        const v = 1 - Math.pow(1 - k, 3);
        for (const n of nums) n.textContent = String(Math.round(Number(n.dataset.count) * v));
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, { threshold: 0.6 });
    io.observe(box);
  }
</script>

<style>
  /* Hero */
  .h1-tail { display: block; margin-block-start: 0.12em; padding-block-end: 0.12em; font-size: 0.62em; line-height: 1.1; background-image: linear-gradient(90deg, var(--gold-400), var(--orange-500) 60%, #ff7a59); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .trust { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .trust li { display: inline-flex; align-items: center; gap: 0.5em; padding: 0.35em 0.85em 0.35em 0.4em; border-radius: var(--radius-pill); background-color: rgb(255 255 255 / 0.1); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16); color: var(--paper-0); font-size: var(--step-small); font-weight: var(--weight-semibold); backdrop-filter: blur(6px); }
  .trust-ico { display: grid; place-items: center; inline-size: 1.6rem; block-size: 1.6rem; border-radius: 50%; background-color: var(--orange-500); color: var(--ink-900); }

  /* Presentación */
  .intro { display: grid; gap: var(--space-l) var(--gutter); align-items: center; }
  .intro-copy { display: grid; gap: var(--space-s); justify-items: start; padding: var(--space-l); border-radius: calc(var(--radius-card) + 0.35rem); background-color: var(--paper-0); box-shadow: var(--shadow-card); border-inline-start: 5px solid var(--orange-500); }
  .intro-copy p { color: var(--color-text-soft); font-size: var(--step-lead); line-height: var(--leading-lead); max-inline-size: 70ch; }
  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-s); }
  .fact { display: grid; gap: 0.2rem; justify-items: center; text-align: center; padding: var(--space-m) var(--space-s); border-radius: var(--radius-card); background: linear-gradient(150deg, var(--tone-soft), var(--paper-0) 80%); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--tone) 18%, transparent); }
  .fact strong { font-variant-numeric: tabular-nums; font-family: var(--font-display); font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem); line-height: 1; color: var(--tone); }
  .fact > span { color: var(--ink-600); font-size: var(--step-ui); font-weight: var(--weight-semibold); }
  .intro-pic { overflow: hidden; border-radius: calc(var(--radius-card) + 0.35rem); box-shadow: var(--shadow-card); }
  .intro-img { display: block; inline-size: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 25%; }

  @media (min-width: 64em) {
    .intro { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  }
</style>
