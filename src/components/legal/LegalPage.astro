---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import LegalHero from './LegalHero.astro';
import Prose from '@/components/ui/Prose.astro';
import Icon from '@/components/ui/Icon.astro';
import logoColor from '@/assets/brand/logo-color.png';
import { site } from '@/config/site';
import { breadcrumb } from '@/lib/schema';

interface Props {
  entry: 'politica-privacidad' | 'terminos-condiciones';
  title: string;
  description: string;
  heading: string;
  /** Norma principal en la que se basa el documento */
  law?: string;
  /** Fecha de la última actualización (AAAA-MM-DD) */
  updated?: string;
}

const { entry, title, description, heading, law, updated = '2026-10-26' } = Astro.props;
const doc = await getEntry('legal', entry);
if (!doc) throw new Error(`Falta el contenido legal: ${entry}`);
const { Content, headings } = await render(doc);
const schema = [breadcrumb([{ name: 'Inicio', path: '/' }, { name: heading, path: `/${entry}.html` }])];

// Índice del documento a partir de sus títulos (“1. Información general” → número + título)
const toc = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => {
    const m = h.text.match(/^(\d+)\.\s*(.+)$/);
    return { slug: h.slug, num: m ? m[1].padStart(2, '0') : '', text: m ? m[2] : h.text, group: !m };
  });
const items = toc.filter((t) => !t.group).length;
const minutes = Math.max(1, Math.round((doc.body ?? '').split(/\s+/).length / 200));
const updatedLabel = new Intl.DateTimeFormat('es-PE', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(updated));
---

<Base title={title} description={description} schema={schema}>
  <LegalHero heading={heading} description={description} meta={[
    ...(law ? [{ icon: 'institution', text: law }] : []),
    { icon: 'calendar', text: `Actualizado el ${updatedLabel}`, datetime: updated },
    { icon: 'clock', text: `Lectura de ${minutes} min` },
  ]} />

  <div class="page l-body">
    {items >= 3 && (
      <aside class="l-side">
        <details class="toc" open>
          <summary><Icon name="list" size="1rem" />Índice del documento</summary>
          <ol role="list">
            {toc.map((t) => t.group
              ? <li class="toc-group"><a href={`#${t.slug}`} data-toc={t.slug}>{t.text}</a></li>
              : <li><a href={`#${t.slug}`} data-toc={t.slug}><span class="toc-num">{t.num}</span><span>{t.text}</span></a></li>)}
          </ol>
        </details>
        <div class="help">
          <p class="help-title">¿Dudas sobre este documento?</p>
          <p>Escríbenos y te responde el área encargada.</p>
          <a href={`mailto:${site.email}`}><Icon name="mail" size="1rem" />Escribir un correo</a>
          <small>{site.email}</small>
        </div>
      </aside>
    )}

    <article class:list={['sheet', { solo: items < 3 }]}>
      <Prose><Content /></Prose>
      <footer class="sign">
        <Image src={logoColor} alt={site.name} height={96} class="sign-logo" />
        <div>
          <p class="sign-name">{site.legalName}</p>
          <p>RUC {site.ruc} · Lima, Perú · Vigente desde el {updatedLabel}</p>
        </div>
      </footer>
    </article>
  </div>
</Base>

<script>
  // Resaltado del apartado que se está leyendo en el índice
  // En celular el índice empieza cerrado para no empujar el texto hacia abajo
  if (matchMedia('(max-width: 63.99em)').matches) document.querySelector('.toc')?.removeAttribute('open');
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc!, a]));
  if (links.size && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a) => a.removeAttribute('aria-current'));
        links.get(e.target.id)?.setAttribute('aria-current', 'true');
      }
    }, { rootMargin: '-20% 0px -70% 0px' });
    links.forEach((_, id) => { const h = document.getElementById(id); if (h) io.observe(h); });
  }
</script>

<style>
  /* Cuerpo: índice fijo a la izquierda y el documento como una hoja */
  .l-body { display: grid; gap: var(--space-l); padding-block: var(--space-l) var(--section-gap); }
  .l-side { display: grid; gap: var(--space-s); align-content: start; }
  .toc { border-radius: var(--radius-card); background-color: var(--paper-0); box-shadow: inset 0 0 0 1px var(--paper-2); }
  .toc summary { display: flex; align-items: center; gap: 0.5em; padding: var(--space-s) var(--space-m); color: var(--navy-700); font-size: var(--step-small); font-weight: var(--weight-bold); letter-spacing: 0.06em; text-transform: uppercase; cursor: pointer; list-style: none; }
  .toc summary::-webkit-details-marker { display: none; }
  .toc summary :global(svg) { color: var(--orange-500); }
  .toc ol { display: grid; padding: 0 var(--space-xs) var(--space-s); }
  .toc a { display: grid; grid-template-columns: 2rem minmax(0, 1fr); align-items: baseline; gap: 0.25rem; padding: 0.45rem 0.6rem; border-radius: 0.6rem; color: var(--ink-600); font-size: var(--step-small); line-height: 1.35; text-decoration: none; transition: background-color var(--duration-hover) ease, color var(--duration-hover) ease; }
  .toc-group a { display: block; margin-block-start: var(--space-xs); color: var(--navy-700); font-weight: var(--weight-bold); }
  .toc-group:first-child a { margin-block-start: 0; }
  .toc-num { color: var(--orange-600); font-weight: var(--weight-bold); font-variant-numeric: tabular-nums; }
  .toc a[aria-current] { background-color: var(--navy-50); color: var(--navy-700); font-weight: var(--weight-semibold); }
  .help { display: grid; gap: 0.35rem; padding: var(--space-m); border-radius: var(--radius-card); background-color: var(--navy-50); font-size: var(--step-small); color: var(--ink-600); }
  .help small { color: var(--ink-600); font-size: 0.75rem; overflow-wrap: anywhere; }
  .help-title { color: var(--navy-700); font-weight: var(--weight-bold); }
  .help a { display: inline-flex; align-items: center; gap: 0.45em; margin-block-start: 0.2rem; color: var(--navy-600); font-weight: var(--weight-bold); overflow-wrap: anywhere; }

  .sheet { min-inline-size: 0; padding: var(--space-m); border-radius: calc(var(--radius-card) + 0.4rem); background-color: var(--paper-0); box-shadow: 0 30px 60px -40px rgb(20 31 102 / 0.45), inset 0 0 0 1px var(--paper-2); }
  .sheet :global(.prose) { max-inline-size: 48rem; color: var(--ink-700, var(--ink-600)); line-height: 1.75; }
  .sheet :global(.prose > p:first-child) { padding: var(--space-s) var(--space-m); border-inline-start: 4px solid var(--orange-500); border-radius: 0 var(--radius-card) var(--radius-card) 0; background-color: var(--paper-1); color: var(--ink-900); }
  .sheet :global(.prose h2) { scroll-margin-block-start: calc(var(--header-height) + var(--space-m)); margin-block-start: var(--space-l); padding-block-start: var(--space-m); border-block-start: 1px solid var(--paper-2); color: var(--navy-700); font-family: var(--font-display); font-size: clamp(1.3rem, 1.1rem + 0.5vw, 1.6rem); }
  .sheet :global(.prose :is(p, li)) { max-inline-size: none; }
  .sheet :global(.prose ul) { gap: var(--space-2xs); padding-inline-start: 1.4em; }
  .sheet :global(.prose h3) { scroll-margin-block-start: calc(var(--header-height) + var(--space-m)); margin-block-start: var(--space-s); color: var(--navy-700); font-size: var(--step-ui); font-weight: var(--weight-bold); }
  .sheet :global(.prose strong) { color: var(--navy-700); }
  .sheet :global(.prose li::marker) { color: var(--orange-500); font-weight: var(--weight-bold); }
  .sheet :global(.prose a) { color: var(--navy-600); font-weight: var(--weight-semibold); }

  .sign { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: var(--space-s) var(--space-m); margin-block-start: var(--space-l); padding-block-start: var(--space-m); border-block-start: 2px solid var(--navy-700); font-size: var(--step-small); color: var(--ink-600); }
  .sign :global(.sign-logo) { block-size: 3rem; inline-size: auto; }
  .sign-name { color: var(--navy-700); font-weight: var(--weight-bold); font-size: var(--step-ui); }

  @media (min-width: 48em) {
    .sheet { padding: var(--space-l) var(--space-xl); }
    }
  @media (min-width: 64em) {
    .l-body { grid-template-columns: minmax(0, 18rem) minmax(0, 1fr); gap: var(--space-xl); }
    .l-side { align-self: start; position: sticky; inset-block-start: calc(var(--header-height) + var(--space-m)); }
    .sheet.solo { grid-column: 1 / -1; max-inline-size: 56rem; justify-self: center; }
  }
  @media (hover: hover) and (pointer: fine) {
    .toc a:hover { background-color: var(--paper-1); color: var(--navy-700); }
  }
  /* Impresión: solo el documento, sin banner ni menús */
  @media print {
    .l-side { display: none; }
    .sheet { box-shadow: none; padding: 0; }
  }
</style>
