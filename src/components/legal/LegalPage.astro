---
import { getEntry, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Prose from '@/components/ui/Prose.astro';
import { breadcrumb } from '@/lib/schema';

interface Props {
  entry: 'politica-privacidad' | 'terminos-condiciones';
  title: string;
  description: string;
  heading: string;
}

const { entry, title, description, heading } = Astro.props;
const doc = await getEntry('legal', entry);
if (!doc) throw new Error(`Falta el contenido legal: ${entry}`);
const { Content } = await render(doc);
const schema = [breadcrumb([{ name: 'Inicio', path: '/' }, { name: heading, path: `/${entry}.html` }])];
---

<Base title={title} description={description} schema={schema}>
  <Breadcrumbs current={heading} />
  <article class="section page split">
    <header class="stack">
      <h1>{heading}</h1>
      <p class="text-lead">{description}</p>
    </header>
    <Prose><Content /></Prose>
  </article>
</Base>
