---
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import type { ComponentProps } from 'astro/types';
import Icon from '@/components/ui/Icon.astro';
import logoSvg from '@/assets/brand/logo.svg?raw';
import { site } from '@/config/site';

type IconName = ComponentProps<typeof Icon>['name'];

interface Props {
  heading: string;
  description: string;
  eyebrow?: string;
  icon?: IconName;
  meta?: { icon: IconName; text: string; datetime?: string }[];
}

const cubeSvg = logoSvg.replace(/viewBox="[^"]*"/, 'viewBox="0 0 1240 1236"');
const { heading, description, eyebrow = 'Documento legal', icon = 'shield', meta = [] } = Astro.props;
---

<section class="l-hero custom-hero" aria-labelledby="titulo">
  <div class="page l-hero-grid">
    <div class="l-copy">
      <Breadcrumbs current={heading} inline />
      <span class="eyebrow l-eyebrow"><Icon name="document" size="0.95rem" />{eyebrow}</span>
      <h1 id="titulo">{heading}</h1>
      <p class="l-lede">{description}</p>
      {meta.length > 0 && (
        <ul class="l-meta" role="list">
          {meta.map((m) => <li><Icon name={m.icon} size="1rem" />{m.datetime ? <time datetime={m.datetime}>{m.text}</time> : m.text}</li>)}
        </ul>
      )}
    </div>
    <div class="seal" aria-hidden="true">
      <span class="l-mark"><Fragment set:html={cubeSvg} /></span>
      <svg viewBox="0 0 200 200" class="seal-ring">
        <defs><path id="seal-path" d="M100 100 m-78 0 a78 78 0 1 1 156 0 a78 78 0 1 1 -156 0" /></defs>
        <circle cx="100" cy="100" r="96" fill="none" stroke="currentColor" stroke-width="1.5" />
        <circle cx="100" cy="100" r="62" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 5" />
        <text><textPath href="#seal-path">CIENTÍFICA CONSULTORES S.A.C. · RUC {site.ruc} · LIMA, PERÚ ·</textPath></text>
      </svg>
      <span class="seal-core"><Icon name={icon} size="2.4rem" /></span>
    </div>
  </div>
</section>

<style>
  .l-hero { position: relative; overflow: hidden; isolation: isolate; padding-block: var(--space-l) var(--space-xl); background-image: linear-gradient(180deg, #0f1650, var(--navy-700)); color: var(--paper-0); }
  .l-hero::after { content: ''; position: absolute; inset: auto 0 0; block-size: 4px; background-image: linear-gradient(90deg, var(--orange-500), var(--gold-400), var(--sky-500)); }
  .l-mark { position: absolute; z-index: -1; inset-block-start: 50%; inset-inline-start: 50%; translate: -50% -50%; inline-size: 190%; color: rgb(255 255 255 / 0.05); pointer-events: none; }
  .l-mark :global(svg) { display: block; inline-size: 100%; block-size: auto; }
  .l-hero-grid { display: grid; gap: var(--space-l); align-items: center; }
  .l-copy { display: grid; gap: var(--space-s); justify-items: start; }
  .l-eyebrow { background-color: rgb(255 255 255 / 0.1); color: var(--gold-400); }
  .l-eyebrow::before { display: none; }
  .l-copy h1 { color: var(--paper-0); font-size: clamp(2.3rem, 1.4rem + 2vw, 3.4rem); line-height: 1.04; letter-spacing: -0.025em; }
  .l-lede { color: var(--navy-100); font-size: var(--step-lead); max-inline-size: 52ch; }
  .l-meta { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-s); margin-block-start: var(--space-2xs); }
  .l-meta li { display: inline-flex; align-items: center; gap: 0.45em; padding: 0.4em 0.85em; border-radius: var(--radius-pill); background-color: rgb(255 255 255 / 0.07); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14); color: var(--paper-0); font-size: var(--step-small); font-weight: var(--weight-semibold); }
  .l-meta :global(svg) { color: var(--gold-400); }

  .seal { position: relative; isolation: isolate; display: none; place-items: center; inline-size: 13rem; aspect-ratio: 1; justify-self: end; color: rgb(255 255 255 / 0.55); }
  .seal-ring { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; }
  .seal-ring text { fill: var(--gold-400); font-size: 10.5px; font-weight: 700; letter-spacing: 0.16em; }
  .seal-core { display: grid; place-items: center; inline-size: 5.5rem; aspect-ratio: 1; border-radius: 50%; background-image: var(--gradient-warm); color: var(--navy-700); box-shadow: 0 18px 40px -16px rgb(254 143 1 / 0.7); }

  @media (min-width: 64em) {
    .l-hero-grid { grid-template-columns: minmax(0, 1fr) auto; }
    .seal { display: grid; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .seal-ring { animation: seal-spin 60s linear infinite; }
    @keyframes seal-spin { to { rotate: 360deg; } }
  }
</style>
