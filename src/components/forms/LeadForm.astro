---
import Field from '@/components/ui/Field.astro';
import Button from '@/components/ui/Button.astro';
import { countries, endpoints, formsubmit } from '@/config/forms';
import { site } from '@/config/site';

interface Props {
  subject: string;
  variant?: 'short' | 'full';
  submitLabel?: string;
  /** Ejemplo que se muestra en la caja de mensaje, según el servicio */
  hint?: string;
}

const { subject, variant = 'full', submitLabel = 'Enviar mensaje', hint = 'Ej.: empiezo desde cero, tengo observaciones del jurado…' } = Astro.props;
const telRequired: boolean = variant === 'short';
const telLabel = telRequired ? 'WhatsApp' : 'WhatsApp (opcional)';
const uid = `f${Math.random().toString(36).slice(2, 8)}`;
const options = countries.map((c) => ({ value: c.name, name: c.name, code: c.code }));
---

<form
  class:list={['lead-form', { compact: variant === 'short' }]}
  method="POST"
  action={formsubmit(endpoints.leads)}
  data-lead-form
  data-crm={endpoints.crm}
  data-mail={formsubmit(endpoints.leads, true)}
  data-codes={JSON.stringify(Object.fromEntries(countries.map((c) => [c.name, c.code])))}
  data-phone={site.phone.display}
  data-reply={site.replyTime}
>
  <input type="hidden" name="_subject" value={subject} />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <div class="visually-hidden" aria-hidden="true">
    <label for={`${uid}-honey`}>No llenar</label>
    <input id={`${uid}-honey`} type="text" name="_honey" tabindex="-1" autocomplete="off" />
  </div>

  {variant === 'full' ? (
    <>
      <div class="pair">
        <Field id={`${uid}-nombre`} label="Nombres y apellidos" name="nombre" autocomplete="name" required minlength="3" error="Escribe tu nombre y apellido." />
        <Field id={`${uid}-email`} label="Correo electrónico" name="email" type="email" autocomplete="email" inputmode="email" required error="Revisa el formato del correo." />
      </div>
      <div class="field tel-field">
      <label for={`${uid}-telefono`}>{telLabel}{telRequired && <span class="required" aria-hidden="true">*</span>}</label>
      <div class="tel">
        <div class="cc">
          <span class="cc-code" aria-hidden="true" data-cc>{countries[0].code}</span>
          <select id={`${uid}-pais`} name="pais" aria-label="País" autocomplete="country-name" required data-cc-select>
            <button type="button" class="cc-button"><selectedcontent></selectedcontent></button>
            {options.map((o) => (
              <option value={o.value}><span class="cc-name">{o.name}</span> <span class="cc-num"><span class="cc-p">(</span>{o.code}<span class="cc-p">)</span></span></option>
            ))}
          </select>
        </div>
        <input id={`${uid}-telefono`} type="tel" name="telefono" autocomplete="tel-national" inputmode="tel" placeholder=" " required={telRequired} pattern="[0-9 +()-]{7,20}" aria-describedby={`${uid}-telefono-error`} />
      </div>
      <p class="error" id={`${uid}-telefono-error`}>Escribe un teléfono válido (7 a 15 dígitos).</p>
    </div>
      <Field id={`${uid}-mensaje`} label="Cuéntanos qué necesitas" name="mensaje" type="textarea" required error="Cuéntanos brevemente tu caso." />
    </>
  ) : (
    <>
      <div class="pair">
        <Field id={`${uid}-nombre`} label="Nombres y apellidos" name="nombre" autocomplete="name" required minlength="3" error="Escribe tu nombre y apellido." />
        <div class="field tel-field">
      <label for={`${uid}-telefono`}>{telLabel}{telRequired && <span class="required" aria-hidden="true">*</span>}</label>
      <div class="tel">
        <div class="cc">
          <span class="cc-code" aria-hidden="true" data-cc>{countries[0].code}</span>
          <select id={`${uid}-pais`} name="pais" aria-label="País" autocomplete="country-name" required data-cc-select>
            <button type="button" class="cc-button"><selectedcontent></selectedcontent></button>
            {options.map((o) => (
              <option value={o.value}><span class="cc-name">{o.name}</span> <span class="cc-num"><span class="cc-p">(</span>{o.code}<span class="cc-p">)</span></span></option>
            ))}
          </select>
        </div>
        <input id={`${uid}-telefono`} type="tel" name="telefono" autocomplete="tel-national" inputmode="tel" placeholder=" " required={telRequired} pattern="[0-9 +()-]{7,20}" aria-describedby={`${uid}-telefono-error`} />
      </div>
      <p class="error" id={`${uid}-telefono-error`}>Escribe un teléfono válido (7 a 15 dígitos).</p>
    </div>
      </div>
      <Field id={`${uid}-email`} label="Correo electrónico (opcional)" name="email" type="email" autocomplete="email" inputmode="email" error="Revisa el formato del correo." />
      <Field id={`${uid}-mensaje`} label="Cuéntanos tu caso (opcional)" name="mensaje" type="textarea" placeholder={hint} />
    </>
  )}
  <Button type="submit">{submitLabel}</Button>
  <p class="consent">Al enviar, aceptas nuestra <a href="/politica-privacidad.html">Política de privacidad</a>.</p>
  <p class="status" role="status" aria-live="polite" data-status></p>
  <div class="sent" data-sent tabindex="-1">
    <svg class="check" viewBox="0 0 52 52" aria-hidden="true"><circle cx="26" cy="26" r="24" /><path d="M15 27l7 7 15-16" /></svg>
    <p class="sent-title">¡Listo, recibimos tus datos!</p>
    <p class="sent-text">Un asesor se comunicará contigo en {site.replyTime}.</p>
    <button type="button" class="sent-again" data-again>Enviar otra consulta</button>
  </div>
</form>

<script>
  const isTouch = () => window.matchMedia('(pointer: coarse)').matches;

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-lead-form]')) {
    form.noValidate = true;
    const openedAt = Date.now();
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const codes: Record<string, string> = JSON.parse(form.dataset.codes ?? '{}');
    const label = button.textContent;
    const cc = form.querySelector<HTMLElement>('[data-cc]');
    const ccSelect = form.querySelector<HTMLSelectElement>('[data-cc-select]');
    const sent = form.querySelector<HTMLElement>('[data-sent]')!;
    const syncCode = () => {
      if (cc && ccSelect) cc.textContent = codes[ccSelect.value] ?? '';
    };
    ccSelect?.addEventListener('change', syncCode);
    const done = () => {
      form.reset();
      syncCode();
      delete form.dataset.tried;
      form.dataset.state = 'sent';
      sent.focus();
    };
    form.querySelector('[data-again]')?.addEventListener('click', () => {
      delete form.dataset.state;
      form.querySelector<HTMLInputElement>('input[name="nombre"]')?.focus();
    });

    const setStatus = (text: string, tone: 'ok' | 'error' | '') => {
      status.textContent = text;
      status.dataset.tone = tone;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      setStatus('', '');

      if (!form.checkValidity()) {
        form.dataset.tried = 'true';
        form.querySelector<HTMLElement>(':invalid:not(fieldset)')?.focus();
        return;
      }

      const data = new FormData(form);
      if (String(data.get('_honey') ?? '') !== '' || Date.now() - openedAt < 2000) {
        done();
        return;
      }

      const country = String(data.get('pais') ?? '');
      const phone = `${codes[country] ?? ''} ${String(data.get('telefono') ?? '')}`.trim();
      data.set('telefono_completo', phone);

      const payload = {
        social_network: 'google',
        external_id: `google_${Date.now()}`,
        name: String(data.get('nombre') ?? ''),
        email: String(data.get('email') ?? ''),
        phone,
        notes: `${data.get('_subject')} ${isTouch() ? '(Móvil)' : '(PC)'} - ${String(data.get('mensaje') ?? '').trim() || 'Interesado en asesoría'}`,
        page: window.location.href,
      };

      button.disabled = true;
      button.textContent = 'Enviando…';

      try {
        await fetch(form.dataset.crm!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
          keepalive: true,
        }).catch(() => undefined);

        const mail = await fetch(form.dataset.mail!, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        if (!mail.ok) throw new Error(String(mail.status));

        done();
        window.dataLayer?.push({ event: 'lead_form_submit', form_subject: data.get('_subject'), form_id: `lead_formulario_${document.documentElement.dataset.page}`, cta_page: document.documentElement.dataset.page });
      } catch {
        setStatus(`No pudimos enviar el formulario. Inténtalo de nuevo o llámanos al ${form.dataset.phone}.`, 'error');
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  }
</script>

<style>
  .lead-form { display: grid; gap: var(--space-m); container-type: inline-size; }
  .pair { display: grid; gap: var(--space-m); align-items: start; }
  @container (min-width: 24rem) {
    .compact .pair { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @container (min-width: 30rem) {
    .pair { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .lead-form > :global(.button) { justify-self: start; }
  .compact { --input-height: 2.875rem; }
  .compact, .compact .pair { gap: var(--space-xs); }
  .compact :global(.field), .compact .tel-field { gap: 0.3rem; }
  .compact :global(input:not([type='hidden'])), .compact .tel input { padding-block: 0.45rem; }
  .compact :global(textarea) { padding-block: 0.6rem; }
  .compact > :global(.button) { justify-self: stretch; }
  .compact :global(textarea) { field-sizing: content; min-block-size: 4.75rem; block-size: 4.75rem; max-block-size: 14rem; resize: none; overflow-y: auto; }
  @supports (field-sizing: content) {
    .compact :global(textarea) { block-size: auto; }
  }

  .tel-field { display: grid; gap: var(--space-2xs); align-content: start; }
  .tel-field label { font-size: var(--step-small); line-height: var(--leading-small); font-weight: var(--weight-semibold); }
  .required { color: var(--color-error); margin-inline-start: 0.15em; }
  .tel { display: grid; grid-template-columns: auto minmax(0, 1fr); min-block-size: var(--input-height); background-color: var(--input-bg); border-block-end: 2px solid var(--input-border); border-radius: var(--radius); transition: border-color var(--duration-hover) ease; }
  .tel:has(:focus-visible) { outline: var(--focus-ring); outline-offset: 0; border-block-end-color: var(--input-border-focus); }
  .cc { position: relative; display: flex; align-items: center; gap: 0.5rem; padding-inline: var(--space-s) var(--space-xs); border-inline-end: 1px solid color-mix(in srgb, var(--ink-900) 14%, transparent); font-weight: var(--weight-semibold); }
  .cc::after { content: ''; inline-size: 0.4rem; block-size: 0.4rem; border-inline-end: 2px solid currentColor; border-block-end: 2px solid currentColor; transform: translateY(-2px) rotate(45deg); opacity: 0.6; }
  .cc select { position: absolute; inset: 0; inline-size: 100%; opacity: 0; cursor: pointer; font-size: 16px; }
  @supports (appearance: base-select) {
    .cc { padding: 0; }
    .cc-code, .cc::after { display: none; }
    .cc select { position: static; opacity: 1; appearance: base-select; display: flex; align-items: center; gap: 0.5rem; inline-size: auto; block-size: 100%; padding: 0 var(--space-xs) 0 var(--space-s); background: transparent; border: 0; color: inherit; font: inherit; font-weight: var(--weight-semibold); }
    .cc select:focus-visible { outline: none; }
    .cc-button { display: flex; align-items: center; block-size: 100%; }
    .cc select::picker-icon { content: ''; inline-size: 0.4rem; block-size: 0.4rem; border-inline-end: 2px solid currentColor; border-block-end: 2px solid currentColor; transform: translateY(-2px) rotate(45deg); opacity: 0.6; transition: transform var(--duration-ui) var(--ease-out); }
    .cc select:open::picker-icon { transform: translateY(2px) rotate(225deg); }
    .cc selectedcontent .cc-name, .cc selectedcontent .cc-p { display: none; }
    .cc select::picker(select) { appearance: base-select; position-area: block-end span-inline-end; position-try-fallbacks: flip-block; position-try-order: normal; inline-size: 17rem; max-block-size: min(16rem, 40vh); margin-block-start: 0.5rem; padding: 0.375rem; overflow-y: auto; border: 1px solid color-mix(in srgb, var(--ink-900) 10%, transparent); border-radius: var(--radius-card); background-color: var(--paper-0); color: var(--ink-900); box-shadow: 0 24px 48px -16px color-mix(in srgb, var(--navy-700) 35%, transparent); opacity: 1; translate: 0 0; transition: opacity var(--duration-hover) var(--ease-out), translate var(--duration-hover) var(--ease-out), display var(--duration-hover) allow-discrete, overlay var(--duration-hover) allow-discrete; }
    @starting-style { .cc select:open::picker(select) { opacity: 0; translate: 0 -6px; } }
    .cc option { display: flex; align-items: center; justify-content: space-between; gap: var(--space-s); padding: 0.6rem 0.75rem; border-radius: var(--radius); font-weight: var(--weight-regular); cursor: pointer; }
    .cc option::checkmark { display: none; }
    .cc option .cc-p { display: none; }
    .cc option .cc-num { color: var(--ink-600); font-variant-numeric: tabular-nums; }
    .cc option:is(:hover, :focus-visible) { background-color: color-mix(in srgb, var(--navy-600) 8%, transparent); outline: none; }
    .cc option:checked { background-color: color-mix(in srgb, var(--navy-600) 12%, transparent); color: var(--navy-600); font-weight: var(--weight-semibold); }
    .cc option:checked .cc-num { color: var(--navy-600); }
  }
  .tel input { inline-size: 100%; min-inline-size: 0; padding: var(--space-xs) var(--space-s); background: transparent; border: 0; color: var(--color-text); font-size: max(16px, 1em); }
  .tel input:focus-visible { outline: none; }
  .tel-field .error { display: none; font-size: var(--step-small); line-height: var(--leading-small); color: var(--color-error); font-weight: var(--weight-semibold); }
  .tel-field:has(input:user-invalid:not(:placeholder-shown)) .error,
  :global(form[data-tried]) .tel-field:has(input:invalid) .error { display: block; }
  .tel-field:has(input:user-invalid:not(:placeholder-shown)) .tel,
  :global(form[data-tried]) .tel-field:has(input:invalid) .tel { border-block-end-color: var(--color-error); }

  /* Aviso de consentimiento (Ley N.° 29733): breve, bajo el botón */
  .consent { margin-block-start: calc(-1 * var(--space-2xs)); color: var(--color-text-soft, var(--ink-600)); font-size: 0.75rem; line-height: 1.4; text-align: center; }
  .consent a { color: inherit; font-weight: var(--weight-semibold); text-decoration: underline; text-underline-offset: 2px; }
  .status { font-size: var(--step-small); line-height: var(--leading-small); font-weight: var(--weight-semibold); }
  .status:empty { display: none; }
  .status[data-tone='error'] { color: var(--color-error); }

  .sent { display: none; justify-items: center; gap: var(--space-2xs); padding-block: var(--space-m); text-align: center; }
  .sent:focus { outline: none; }
  .lead-form[data-state='sent'] > :not(.sent) { display: none; }
  .lead-form[data-state='sent'] > .sent { display: grid; }
  .check { inline-size: 3.5rem; block-size: 3.5rem; margin-block-end: var(--space-2xs); fill: none; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .check circle { stroke: color-mix(in srgb, var(--color-success) 35%, transparent); }
  .check path { stroke: var(--color-success); }
  .sent-title { font-size: var(--step-title); line-height: var(--leading-head); font-weight: var(--weight-semibold); }
  .sent-text { color: var(--color-text-soft); }
  .sent-again { margin-block-start: var(--space-xs); padding: var(--space-2xs) var(--space-s); background: none; border: 0; border-radius: var(--radius); color: var(--color-link); font: inherit; font-size: var(--step-small); font-weight: var(--weight-semibold); cursor: pointer; }

  @media (prefers-reduced-motion: no-preference) {
    .lead-form[data-state='sent'] .check circle { stroke-dasharray: 151; animation: draw-ring 600ms var(--ease-out) both; }
    .lead-form[data-state='sent'] .check path { stroke-dasharray: 36; animation: draw-tick 400ms var(--ease-out) 450ms both; }
    .lead-form[data-state='sent'] :is(.sent-title, .sent-text) { animation: sent-in 500ms var(--ease-out) 300ms both; }
    @keyframes draw-ring { from { stroke-dashoffset: 151; } to { stroke-dashoffset: 0; } }
    @keyframes draw-tick { from { stroke-dashoffset: 36; } to { stroke-dashoffset: 0; } }
    @keyframes sent-in { from { opacity: 0; transform: translateY(8px); } }
  }
</style>
