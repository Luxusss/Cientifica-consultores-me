---
import { intro } from '@/data/home';

const words = intro.split(' ');
---

<section class="section page intro" aria-label="Presentación">
  <p class="statement">
    {words.map((w) => <span class="w">{w} </span>)}
  </p>
</section>

<style>
  .intro { padding-block: var(--space-2xl); }
  .statement { max-inline-size: 46ch; margin-inline: auto; font-size: clamp(1.375rem, 1.1rem + 1.1vw, 2.125rem); line-height: 1.35; letter-spacing: -0.01em; font-weight: var(--weight-medium); text-align: center; text-wrap: pretty; }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .w { animation: light-up linear both; animation-timeline: view(); animation-range: cover 18% cover 42%; }
      @keyframes light-up { from { opacity: 0.2; } to { opacity: 1; } }
    }
  }
</style>
