---
import { intro } from '@/data/home';
---

<section class="section page intro" aria-label="Presentación">
  <p class="standfirst" data-reveal>{intro}</p>
</section>

<style>
  .intro { padding-block: var(--space-xl); }
  .standfirst { max-inline-size: none; padding-inline-start: var(--space-m); border-inline-start: 3px solid var(--orange-500); font-size: var(--step-lead); line-height: var(--leading-lead); }

  @media (min-width: 64em) {
    .standfirst { columns: 2; column-gap: var(--space-2xl); }
  }
</style>
