---
import { Image } from 'astro:assets';
import { services } from '@/data/services';
import { servicesSection } from '@/data/home';
---

<section class="services theme-surface section-wide" aria-labelledby="servicios">
  <div class="page stack stack-xl">
    <header class="split head" data-reveal>
      <h2 id="servicios">{servicesSection.title}</h2>
      <p class="text-lead">{servicesSection.text}</p>
    </header>

    <ul class="gallery" role="list" data-reveal="stagger">
      {services.map((s) => (
        <li class="tile">
          <a class="frame" href={s.href} tabindex="-1" aria-hidden="true">
            <Image src={s.image} alt={s.imageAlt} widths={[180, 360, 540, 720]} sizes="(min-width: 64em) 30vw, (min-width: 40em) 50vw, 6rem" class="portrait parallax-img" />
          </a>
          <h3 class="name"><a href={s.href}>{s.title}<span class="arrow" aria-hidden="true">→</span></a></h3>
          <p class="hook">{s.summary}</p>
          <p class="summary">{s.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head { --axis: 5; }
  .head .text-lead { max-inline-size: 60ch; }
  .gallery { display: grid; gap: var(--space-xl) var(--gutter); grid-template-columns: 1fr; }
  .tile { display: grid; gap: var(--space-s); align-content: start; }
  .frame { display: block; overflow: hidden; background-color: var(--navy-600); border-radius: var(--radius-card); }
  .portrait { inline-size: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 22%; transition: transform var(--duration-reveal) var(--ease-out); }

  .name { font-size: var(--step-lead); line-height: var(--leading-head); font-weight: var(--weight-medium); letter-spacing: var(--tracking-head); }
  .name a { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-s); color: var(--color-text); text-decoration: none; }
  .arrow { color: var(--color-accent-strong); transition: transform var(--duration-hover) var(--ease-out); }
  .hook { color: var(--navy-600); font-weight: var(--weight-semibold); line-height: var(--leading-lead); }
  .summary { color: var(--color-text-soft); font-size: var(--step-small); line-height: var(--leading-body); }

  @media (max-width: 39.99em) {
    .tile { grid-template-columns: 5.5rem minmax(0, 1fr); column-gap: var(--space-s); row-gap: var(--space-2xs); }
    .frame { grid-row: 1 / span 2; align-self: start; }
    .portrait { aspect-ratio: 1; }
    .hook { grid-column: 2; font-size: var(--step-small); }
    .summary { grid-column: 1 / -1; }
  }
  @media (min-width: 40em) {
    .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64em) {
    .gallery { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .gallery { row-gap: var(--space-2xl); }
    .portrait { aspect-ratio: 3 / 2; object-position: 50% 18%; }
  }

  @media (hover: hover) and (pointer: fine) {
    .tile:hover .portrait { transform: scale(1.04); }
    .tile:hover .arrow { transform: translateX(4px); }
    .name a:hover { text-decoration: underline; text-decoration-thickness: 0.06em; text-underline-offset: 0.18em; }
  }
</style>
