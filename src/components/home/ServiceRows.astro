---
import { Image } from 'astro:assets';
import { services } from '@/data/services';
import { servicesSection, serviceTeasers } from '@/data/home';
---

<section class="services section-wide band-soft" aria-labelledby="servicios">
  <div class="page stack stack-xl">
    <header class="section-head center" data-reveal>
      <span class="eyebrow">Servicios</span>
      <h2 id="servicios">{servicesSection.title}</h2>
      <p>{servicesSection.text}</p>
    </header>

    <ul class="gallery" role="list" data-reveal="stagger">
      {services.map((s, i) => (
        <li class:list={['tile', i % 2 ? 'tone-6' : 'tone-1']}>
          <a class="frame" href={s.href} tabindex="-1" aria-hidden="true">
            <Image src={s.image} alt={s.imageAlt} widths={[400, 600, 800]} sizes="(min-width: 64em) 28vw, (min-width: 40em) 50vw, 100vw" class="portrait" />
            <span class="level">{s.name}</span>
          </a>
          <div class="body">
            <h3 class="name"><a href={s.href}>{s.title}</a></h3>
            <p class="summary">{serviceTeasers[s.id] ?? s.summary}</p>
          </div>
          <div class="foot" aria-hidden="true">
            <span class="go">Ver servicio</span>
            <span class="go-btn"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .gallery { display: grid; gap: var(--space-m) var(--gutter); grid-template-columns: 1fr; }

  /* Ficha del asesor: foto enmarcada dentro de una tarjeta blanca, texto y pie con botón */
  .tile {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 0.6rem;
    border-radius: calc(var(--radius-card) + 0.35rem);
    background-color: var(--paper-0);
    box-shadow: var(--shadow-card);
    transition: opacity var(--duration-reveal) var(--ease-expo), transform var(--duration-reveal) var(--ease-expo), translate var(--duration-ui) var(--ease-out), box-shadow var(--duration-ui) var(--ease-out);
  }
  .frame { position: relative; display: block; overflow: hidden; border-radius: var(--radius-card); background-color: var(--navy-50); }
  .portrait { display: block; inline-size: 100%; block-size: auto; aspect-ratio: 1 / 1; object-fit: cover; object-position: 50% 0; transition: transform var(--duration-reveal) var(--ease-out); }
  .level { position: absolute; inset-block-end: var(--space-xs); inset-inline-start: var(--space-xs); padding: 0.35em 0.85em; border-radius: var(--radius-pill); background-color: var(--paper-0); color: var(--tone); font-size: var(--step-small); font-weight: var(--weight-bold); box-shadow: 0 6px 16px -6px rgb(0 0 0 / 0.35); }

  .body { display: grid; gap: var(--space-2xs); align-content: start; padding: var(--space-s) var(--space-xs) var(--space-xs); }
  .name { font-family: var(--font-display); font-size: var(--step-title); line-height: 1.2; }
  .name a { color: var(--color-text); text-decoration: none; }
  .name a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .tile:has(.name a:focus-visible) { outline: var(--focus-ring); outline-offset: var(--focus-offset); }
  .name a:focus-visible { outline: none; }
  .summary { color: var(--color-text-soft); font-size: var(--step-ui); line-height: var(--leading-body); }

  .foot { display: flex; align-items: center; justify-content: space-between; gap: var(--space-s); margin: 0 var(--space-xs) var(--space-2xs); padding-block-start: var(--space-xs); border-block-start: 1px solid var(--paper-2); }
  .go { color: var(--tone); font-size: var(--step-ui); font-weight: var(--weight-bold); }
  .go-btn { display: grid; place-items: center; inline-size: 2.4rem; block-size: 2.4rem; border-radius: 50%; background-color: var(--tone-soft); color: var(--tone); transition: background-color var(--duration-ui) ease, color var(--duration-ui) ease, transform var(--duration-ui) var(--ease-out); }

  @media (min-width: 40em) {
    .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64em) {
    .gallery { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (hover: hover) and (pointer: fine) {
    .tile:hover { translate: 0 -6px; box-shadow: var(--shadow-lift); }
    .tile:hover .portrait { transform: scale(1.04); }
    .tile:hover .go-btn { background-image: var(--tone-grad); color: var(--paper-0); transform: translateX(3px); }
  }
</style>
