---
import { Image } from 'astro:assets';
import { toolsSection } from '@/data/home';
import turnitin from '@/assets/images/tools/turnitin.png';
import mendeley from '@/assets/images/tools/mendeley.png';
import atlasti from '@/assets/images/tools/atlasti.png';
import spss from '@/assets/images/tools/spss.png';

const logos = { Turnitin: turnitin, Mendeley: mendeley, 'Atlas.ti': atlasti, SPSS: spss } as const;
---

<section class="section-wide band-soft" aria-labelledby="herramientas">
  <div class="page stack stack-xl">
    <header class="section-head center" data-reveal>
      <span class="eyebrow">Herramientas</span>
      <h2 id="herramientas">{toolsSection.title}</h2>
      <p>{toolsSection.text}</p>
    </header>
    <ul class="tools" role="list" data-reveal="stagger">
      {toolsSection.items.map((t) => (
        <li class="tool lift">
          <div class="logo"><Image src={logos[t.tool as keyof typeof logos]} alt={t.tool} height={144} format="webp" quality={90} class:list={['logo-img', t.tool === 'SPSS' && 'is-wide']} /></div>
          <h3>{t.name}</h3>
          <p>{t.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tools { display: grid; gap: var(--space-s); }
  .tool { display: grid; grid-template-rows: auto auto 1fr; gap: var(--space-xs); align-content: start; padding: var(--space-2xs) var(--space-2xs) var(--space-m); background-color: var(--color-surface); border-radius: var(--radius-card); }
  .logo { display: grid; place-items: center; block-size: 6.5rem; margin-block-end: var(--space-xs); background-color: var(--paper-0); border-radius: calc(var(--radius-card) - 0.25rem); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink-900) 6%, transparent); }
  .logo-img { block-size: 3.5rem; inline-size: auto; max-inline-size: 70%; object-fit: contain; }
  .logo-img.is-wide { block-size: 2.5rem; }
  .tool h3, .tool p { padding-inline: var(--space-s); }
  h3 { font-size: var(--step-title); line-height: var(--leading-head); font-weight: var(--weight-medium); }
  .tool p { color: var(--color-text-soft); }

  @media (min-width: 40em) {
    .tools { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64em) {
    .tools { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .logo { block-size: 9rem; }
    .logo-img { block-size: 4.5rem; }
    .logo-img.is-wide { block-size: 3.25rem; }
  }
</style>
