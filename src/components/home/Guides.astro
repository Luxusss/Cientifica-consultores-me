---
import { resources } from '@/data/home';
---

<section class="section-wide page split split-sticky guides" aria-labelledby="guias">
  <header class="stack stack-l head" data-reveal>
    <h2 id="guias">{resources.title}</h2>
    <p>{resources.text}</p>
    <a href="/blog.html">Ver el blog académico</a>
  </header>

  <ul class="stack stack-xl" role="list" data-reveal="stagger">
    {resources.items.map((g) => (
      <li class="stack stack-s">
        <h3>{g.title}</h3>
        <p>{g.text}</p>
        {g.link && <p>Lee nuestro artículo: <a href={g.link.href}>{g.link.label}</a></p>}
      </li>
    ))}
  </ul>
</section>

<style>
  .guides { --axis: 6; }
  .head { justify-items: start; }
  .head h2 { font-size: min(var(--step-head), 2.5rem); }
  h3 { font-size: var(--step-lead); line-height: var(--leading-head); font-weight: var(--weight-medium); letter-spacing: var(--tracking-head); }
</style>
