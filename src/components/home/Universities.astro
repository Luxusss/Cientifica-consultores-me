---
import { universities } from '@/data/proof';
---

<section class="section page split" aria-labelledby="universidades">
  <h2 id="universidades" data-reveal>Dónde sustentaron</h2>
  <div class="columns" data-reveal="stagger">
    {universities.map((group) => (
      <ul role="list" aria-label={group.country}>
        <li class="text-soft">{group.country}</li>
        {group.names.map((name) => <li>{name}</li>)}
      </ul>
    ))}
  </div>
</section>

<style>
  .columns { columns: 2 14rem; column-gap: var(--gutter); }
  .columns ul { break-inside: avoid-column; display: grid; gap: var(--space-3xs); margin-block-end: var(--space-l); line-height: var(--leading-small); }
</style>
