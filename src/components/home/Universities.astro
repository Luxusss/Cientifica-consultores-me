---
import { universities } from '@/data/proof';
import { whatsappUrl } from '@/config/site';
import Icon from '@/components/ui/Icon.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { universityLogos } from '@/data/logos';

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/clients/*', { eager: true });
const logos = universityLogos.map((l) => ({ ...l, src: files[`/src/assets/images/clients/${l.file}`]?.default })).filter((l) => l.src);

const total = universities.reduce((n, g) => n + g.names.length, 0);
const index = universities.flatMap((g) => g.names.map((name) => ({ name, country: g.country })));
---

<section class="section-wide universities" aria-labelledby="universidades">
  <div class="page stack stack-xl">
    <header class="split split-end" data-reveal>
      <h2 id="universidades">Dónde sustentaron</h2>
      <p class="text-lead">Clientes de {total} universidades en {universities.length} países.</p>
    </header>

    <div class="marquee" aria-label="Universidades de nuestros clientes">
      <ul class="track" role="list">
        {logos.map((l) => (
          <li class="logo"><Image src={l.src!} alt={l.name} height={64} class="logo-img" /></li>
        ))}
      </ul>
      <ul class="track" role="list" aria-hidden="true">
        {logos.map((l) => (
          <li class="logo"><Image src={l.src!} alt="" height={64} class="logo-img" /></li>
        ))}
      </ul>
    </div>

    <div class="finder" data-finder hidden>
      <label class="finder-label" for="buscar-universidad">¿Ya asesoramos a alguien de tu universidad?</label>
      <input
        id="buscar-universidad"
        class="finder-input"
        type="search"
        autocomplete="off"
        enterkeyhint="search"
        placeholder="Escribe tu universidad"
        list="universidades-lista"
        data-finder-input
      />
      <datalist id="universidades-lista">
        {index.map((u) => <option value={u.name} />)}
      </datalist>
      <div class="finder-result" aria-live="polite">
        <p class="finder-answer" data-finder-answer>Escribe al menos tres letras.</p>
        <a class="button-whatsapp finder-cta" href={whatsappUrl()} target="_blank" rel="noopener" data-finder-cta data-base={whatsappUrl('MSG')}>
          <Icon name="whatsapp" />
          <span>Pedir asesoría por WhatsApp</span>
        </a>
      </div>
      <script type="application/json" data-finder-data set:html={JSON.stringify(index).replaceAll('<', String.fromCharCode(92) + 'u003c')} />
    </div>

    <details class="all">
      <summary>Ver las {total} universidades</summary>
    <div class="rows">
      {universities.map((group) => (
        <div class="row">
          <p class="country"><span class="count">{group.names.length}</span> {group.country}</p>
          <ul class="names" role="list" aria-label={group.country}>
            {group.names.map((name) => <li>{name}</li>)}
          </ul>
        </div>
      ))}
    </div>
    </details>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-finder]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('[data-finder-input]')!;
    const answer = root.querySelector<HTMLElement>('[data-finder-answer]')!;
    const cta = root.querySelector<HTMLAnchorElement>('[data-finder-cta]')!;
    const data: { name: string; country: string }[] = JSON.parse(root.querySelector('[data-finder-data]')!.textContent ?? '[]');
    const fold = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
    const base = cta.dataset.base ?? cta.href;
    const link = (text: string) => base.replace('MSG', encodeURIComponent(text));

    const update = () => {
      const q = fold(input.value);
      if (q.length < 3) {
        answer.textContent = 'Escribe al menos tres letras.';
        root.dataset.state = '';
        cta.href = link('Hola, quiero asesoría para mi tesis.');
        return;
      }
      const hit = data.find((u) => fold(u.name) === q) ?? data.find((u) => fold(u.name).includes(q));
      if (hit) {
        const of = /^(Universidad|Pontificia)/.test(hit.name) ? `la ${hit.name}` : hit.name;
        answer.textContent = `Sí. Hemos acompañado a tesistas de ${of}, en ${hit.country}.`;
        root.dataset.state = 'hit';
        cta.href = link(`Hola, estudio en ${of} y quiero asesoría para mi tesis.`);
      } else {
        answer.textContent = 'Aún no está en nuestra lista, pero asesoramos a estudiantes de cualquier universidad de habla hispana.';
        root.dataset.state = 'miss';
        cta.href = link(`Hola, estudio en ${input.value.trim()} y quiero asesoría para mi tesis.`);
      }
    };

    root.hidden = false;
    input.addEventListener('input', update);
    update();
  }
</script>

<style>
  .universities { overflow: hidden; }
  .marquee { display: flex; gap: var(--space-s); overflow-x: auto; scrollbar-width: none; mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .track { display: flex; gap: var(--space-s); flex-shrink: 0; }
  .track[aria-hidden='true'] { display: none; }
  .logo { display: grid; place-items: center; inline-size: 9.5rem; block-size: 5.5rem; padding: var(--space-xs); background-color: #fff; border-radius: var(--radius-card); flex-shrink: 0; }
  .logo-img { max-inline-size: 100%; max-block-size: 100%; inline-size: auto; block-size: auto; object-fit: contain; }

  @media (prefers-reduced-motion: no-preference) {
    .marquee { overflow: hidden; }
    .track[aria-hidden='true'] { display: flex; }
    .track { animation: marquee 70s linear infinite; }
    .marquee:hover .track { animation-play-state: paused; }
    @keyframes marquee { to { transform: translateX(calc(-100% - var(--space-s))); } }
  }

  .finder {
    display: grid;
    gap: var(--space-m) var(--gutter);
    padding: var(--space-xl) var(--space-l);
    background-color: var(--color-field);
    color: var(--color-on-field);
  }
  .finder[hidden] { display: none; }
  .finder-label { font-size: var(--step-lead); line-height: var(--leading-head); font-weight: var(--weight-medium); letter-spacing: var(--tracking-head); }
  .finder-input {
    inline-size: 100%;
    min-block-size: 4rem;
    padding-inline: var(--space-s);
    border: 0;
    border-block-end: 3px solid var(--orange-500);
    background-color: var(--navy-700);
    color: var(--paper-0);
    font: inherit;
    font-size: var(--step-lead);
  }
  .finder-input::placeholder { color: var(--navy-100); }
  .finder-input:focus-visible { outline: var(--focus-ring); outline-color: var(--orange-500); outline-offset: 2px; }
  .finder-result { display: grid; gap: var(--space-m); justify-items: start; }
  .finder-answer { font-size: var(--step-lead); line-height: var(--leading-lead); color: var(--navy-100); }
  [data-state='hit'] .finder-answer, [data-state='miss'] .finder-answer { color: var(--paper-0); }
  .finder-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-block-size: var(--button-height);
    padding-inline: var(--button-padding-inline);
    background-color: var(--button-bg);
    color: var(--button-text);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition: background-color var(--duration-hover) ease, transform var(--duration-press) var(--ease-out);
  }
  .finder-cta:active { transform: scale(0.97); }

  @media (prefers-reduced-motion: no-preference) {
    .finder-answer { transition: color var(--duration-ui) var(--ease-out); }
  }
  @media (hover: hover) and (pointer: fine) {
    .finder-cta:hover { background-color: var(--button-bg-hover); }
  }

  @media (min-width: 64em) {
    .finder { grid-template-columns: repeat(12, minmax(0, 1fr)); padding: var(--space-2xl) var(--space-xl); align-items: end; }
    .finder-label { grid-column: 1 / -1; font-size: min(var(--step-head), 2.75rem); }
    .finder-input { grid-column: 1 / span 6; }
    .finder-result { grid-column: 7 / -1; }
  }

  .all summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-block-size: var(--hit-min);
    font-size: var(--step-lead);
    font-weight: var(--weight-medium);
    color: var(--color-link);
    cursor: pointer;
    list-style: none;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 2px;
  }
  .all summary::-webkit-details-marker { display: none; }
  .all summary::after { content: '+'; color: var(--color-accent-strong); font-weight: var(--weight-semibold); }
  .all[open] summary::after { content: '−'; }
  .all[open] summary { margin-block-end: var(--space-l); }
  .rows { display: grid; gap: var(--space-l); }
  .row { display: grid; gap: var(--space-s) var(--gutter); }
  .country { font-size: var(--step-lead); line-height: var(--leading-head); font-weight: var(--weight-medium); letter-spacing: var(--tracking-head); }
  .count { color: var(--color-accent-strong); font-weight: var(--weight-semibold); }
  .names { display: flex; flex-wrap: wrap; gap: var(--space-3xs) 0; color: var(--color-text-soft); line-height: var(--leading-small); }
  .names li:not(:last-child)::after { content: '·'; padding-inline: 0.6em; color: var(--color-accent-strong); }

  @media (min-width: 64em) {
    .row { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: baseline; }
    .country { grid-column: 1 / span 3; }
    .names { grid-column: 4 / -1; }
  }
</style>
