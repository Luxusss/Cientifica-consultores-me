---
import { Image } from 'astro:assets';
import { feature } from 'topojson-client';
import { geoMercator, geoPath } from 'd3-geo';
import type { Feature, FeatureCollection, Geometry } from 'geojson';
import topology from 'world-atlas/countries-110m.json';
import type { ImageMetadata } from 'astro';
import { universities } from '@/data/proof';
import { logoByUniversity } from '@/data/logos';
import peru from '@/assets/images/paises/peru.jpg';
import colombia from '@/assets/images/paises/colombia.jpg';
import mexico from '@/assets/images/paises/mexico.jpg';
import bolivia from '@/assets/images/paises/bolivia.jpg';
import ecuador from '@/assets/images/paises/ecuador.jpg';
import venezuela from '@/assets/images/paises/venezuela.jpg';
import chile from '@/assets/images/paises/chile.jpg';
import espana from '@/assets/images/paises/espana.jpg';

const region = ['032', '152', '332', '214', '044', '238', '484', '858', '076', '068', '604', '170', '591', '188', '558', '340', '222', '320', '084', '862', '328', '740', '218', '630', '388', '192', '600', '780'];

const served = [
  { id: '604', name: 'Perú', flag: peru },
  { id: '170', name: 'Colombia', flag: colombia },
  { id: '484', name: 'México', flag: mexico },
  { id: '068', name: 'Bolivia', flag: bolivia },
  { id: '218', name: 'Ecuador', flag: ecuador },
  { id: '862', name: 'Venezuela', flag: venezuela },
  { id: '152', name: 'Chile', flag: chile },
];

const spainInfo = { id: '724', name: 'España', flag: espana };

const count = (name: string) => universities.find((g) => g.country === name)?.names.length ?? 0;

const width = 520;
const height = 640;
const world = feature(topology as never, (topology as never as { objects: { countries: never } }).objects.countries) as unknown as FeatureCollection<Geometry, { name: string }>;
const latam = world.features.filter((f) => region.includes(String(f.id)));
const projection = geoMercator().fitExtent([[8, 8], [width - 8, height - 8]], { type: 'FeatureCollection', features: latam });
const path = geoPath(projection);

const servedIds = served.map((s) => s.id);
const shapes = latam.map((f: Feature<Geometry, { name: string }>) => ({ id: String(f.id), d: path(f) ?? '', on: servedIds.includes(String(f.id)) }));
const pins = served.map((s, i) => {
  const f = latam.find((x) => String(x.id) === s.id)!;
  const [x, y] = path.centroid(f);
  return { ...s, x: Math.round(x), y: Math.round(y), n: count(s.name), i };
});

const inset = { x: 16, y: height - 150, w: 150, h: 120 };
const spainRaw = world.features.find((f) => String(f.id) === spainInfo.id)!;
const spainGeo = spainRaw.geometry.type === 'MultiPolygon'
  ? { ...spainRaw, geometry: { ...spainRaw.geometry, coordinates: spainRaw.geometry.coordinates.filter((poly) => poly[0].some(([lon]) => lon > -10)) } }
  : spainRaw;
const spainProjection = geoMercator().fitExtent([[inset.x + 18, inset.y + 30], [inset.x + inset.w - 18, inset.y + inset.h - 14]], spainGeo as Feature<Geometry>);
const spainPath = geoPath(spainProjection);
const [sx, sy] = spainPath.centroid(spainGeo as Feature<Geometry>);
const spain = { ...spainInfo, d: spainPath(spainGeo as Feature<Geometry>) ?? '', x: Math.round(sx), y: Math.round(sy), n: count(spainInfo.name) };
const legend = [...pins, spain];

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/clients/*', { eager: true });
const skip = new Set(['Universidad', 'Pontificia', 'de', 'del', 'la', 'los', 'las', 'y', 'en']);
const initials = (name: string) => name.split(/\s+/).filter((w) => !skip.has(w)).map((w) => w[0]).join('').slice(0, 3).toUpperCase();
const groups = legend.map((c) => ({
  id: c.id,
  name: c.name,
  flag: c.flag,
  unis: (universities.find((g) => g.country === c.name)?.names ?? []).map((name) => {
    const logoFile = logoByUniversity[name];
    return { name, initials: initials(name), logo: logoFile ? logoFiles['/src/assets/images/clients/' + logoFile]?.default : undefined };
  }),
}));
---

<div class="map-block" data-map>
  <div class="map" data-reveal>
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="mapa-titulo">
      <title id="mapa-titulo">Mapa de Latinoamérica y España con los ocho países donde atiende Científica Consultores</title>
      <g class="land">
        {shapes.map((s) => <path d={s.d} class:list={{ on: s.on }} data-country={s.on ? s.id : undefined} />)}
      </g>
      <g class="inset">
        <rect x={inset.x} y={inset.y} width={inset.w} height={inset.h} rx="14" />
        <text x={inset.x + 14} y={inset.y + 22}>España</text>
        <path d={spain.d} class="on" data-country={spain.id} />
      </g>
      <g class="pins">
        {pins.map((p) => (
          <g class="pin" data-country={p.id} transform={`translate(${p.x} ${p.y})`}>
            <circle class="ring" r="6" />
            <circle class="dot" r="6" />
          </g>
        ))}
        <g class="pin" data-country={spain.id} transform={`translate(${spain.x} ${spain.y})`}>
          <circle class="ring" r="6" />
          <circle class="dot" r="6" />
        </g>
      </g>
    </svg>
    <p class="map-hint">Pasa el mouse o toca un país para ver sus universidades</p>
  </div>

  <div class="side" data-reveal>
    <div class="tabs" role="group" aria-label="Elige un país">
      {legend.map((p, i) => (
        <button type="button" class="tab" data-country={p.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          <Image src={p.flag} alt="" width={36} height={24} class="flag" />
          <span>{p.name}</span>
        </button>
      ))}
    </div>

    <div class="panels" aria-live="polite">
      {groups.map((g, i) => (
        <section class="panel" data-panel={g.id} hidden={i !== 0} aria-label={`Universidades en ${g.name}`}>
          <header class="panel-head">
            <Image src={g.flag} alt="" width={48} height={32} class="flag flag-lg" />
            <div>
              <h3>{g.name}</h3>
              <p>{g.unis.length > 0 ? `${g.unis.length} ${g.unis.length === 1 ? 'universidad' : 'universidades'} con tesistas asesorados` : 'Atención online para todas las universidades'}</p>
            </div>
          </header>
          {g.unis.length > 0 ? (
            <ul class="unis" role="list">
              {g.unis.map((u) => (
                <li class="uni">
                  <span class="uni-logo">
                    {u.logo ? <Image src={u.logo} alt="" height={96} class="uni-img" loading="lazy" /> : <span class="mono" aria-hidden="true">{u.initials}</span>}
                  </span>
                  <span class="uni-name">{u.name}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty">Acompañamos a estudiantes de cualquier universidad de {g.name} con asesoría 100 % online, adaptada a su reglamento y su terminología.</p>
          )}
        </section>
      ))}
    </div>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-map]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.tab')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const shapes = [...root.querySelectorAll<SVGElement>('svg [data-country]')];
    let current = tabs[0]?.dataset.country ?? '';
    const paint = () => {
      for (const el of shapes) el.classList.toggle('is-active', el.dataset.country === current);
      for (const t of tabs) t.setAttribute('aria-pressed', String(t.dataset.country === current));
      for (const p of panels) p.hidden = p.dataset.panel !== current;
    };
    const set = (id: string) => {
      if (!id || id === current) return;
      current = id;
      paint();
    };
    paint();
    for (const t of tabs) {
      t.addEventListener('click', () => set(t.dataset.country ?? ''));
      t.addEventListener('mouseenter', () => set(t.dataset.country ?? ''));
    }
    for (const shape of shapes) {
      shape.addEventListener('mouseenter', () => set(shape.dataset.country ?? ''));
      shape.addEventListener('click', () => set(shape.dataset.country ?? ''));
    }
  }
</script>

<style>
  .map-block { display: grid; gap: var(--space-l) var(--gutter); align-items: start; }
  .map { display: grid; gap: var(--space-2xs); }
  .map svg { display: block; inline-size: 100%; block-size: auto; max-block-size: 34rem; margin-inline: auto; overflow: visible; }
  .map-hint { color: var(--color-text-soft); font-size: var(--step-small); text-align: center; max-inline-size: none; }
  .land path { fill: color-mix(in srgb, var(--navy-600) 14%, var(--paper-1)); stroke: var(--paper-0); stroke-width: 0.8; transition: fill var(--duration-ui) var(--ease-out); }
  .land path.on { fill: var(--navy-600); cursor: pointer; }
  .land path.on.is-active { fill: var(--orange-500); }
  .dot { fill: var(--orange-500); stroke: var(--paper-0); stroke-width: 2; pointer-events: none; }
  .ring { fill: var(--orange-500); opacity: 0; transform-box: fill-box; transform-origin: center; pointer-events: none; }
  .pin.is-active .dot { fill: var(--paper-0); stroke: var(--orange-500); stroke-width: 3; }
  .inset rect { fill: var(--paper-0); stroke: color-mix(in srgb, var(--navy-600) 18%, transparent); }
  .inset text { font-size: 13px; font-weight: 600; fill: var(--ink-600); }
  .inset path { fill: var(--navy-600); cursor: pointer; }
  .inset path.is-active { fill: var(--orange-500); }

  .side { display: grid; gap: var(--space-s); align-content: start; }
  .tabs { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tab { display: inline-flex; align-items: center; gap: 0.45em; padding: 0.4em 0.85em 0.4em 0.45em; border: 0; border-radius: var(--radius-pill); background-color: var(--paper-0); color: var(--ink-600); font: inherit; font-size: var(--step-small); font-weight: var(--weight-semibold); cursor: pointer; box-shadow: var(--shadow-card); transition: background-color var(--duration-hover) ease, color var(--duration-hover) ease; }
  .tab .flag { inline-size: 1.5rem; block-size: 1rem; }
  .tab[aria-pressed='true'] { background-color: var(--navy-600); color: var(--paper-0); }
  .tab:focus-visible { outline: var(--focus-ring); outline-offset: 2px; }
  .flag { object-fit: cover; border-radius: 3px; box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink-900) 12%, transparent); }
  .flag-lg { inline-size: 3rem; block-size: 2rem; border-radius: 5px; }

  .panel { display: grid; gap: var(--space-s); padding: var(--space-m); border-radius: var(--radius-card); background-color: var(--paper-0); box-shadow: var(--shadow-card); }
  .panel[hidden] { display: none; }
  .panel-head { display: flex; align-items: center; gap: var(--space-s); padding-block-end: var(--space-s); border-block-end: 1px solid var(--paper-2); }
  .panel-head h3 { font-family: var(--font-display); font-size: var(--step-title); line-height: 1.2; }
  .panel-head p { color: var(--color-text-soft); font-size: var(--step-small); }
  .unis { display: grid; grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr)); gap: var(--space-xs); max-block-size: 26rem; overflow-y: auto; padding: 0.25rem; margin: -0.25rem; scrollbar-width: thin; }
  .uni { display: grid; grid-template-rows: auto 1fr; gap: 0.35rem; justify-items: center; text-align: center; }
  .uni-logo { display: grid; place-items: center; inline-size: 100%; block-size: 4.25rem; padding: 0.45rem; border-radius: 0.8rem; background-color: #fff; box-shadow: inset 0 0 0 1px var(--paper-2); }
  .uni-img { display: block; max-inline-size: 100%; max-block-size: 3.3rem; inline-size: auto; block-size: auto; object-fit: contain; }
  .mono { display: grid; place-items: center; inline-size: 2.75rem; block-size: 2.75rem; border-radius: 50%; background-image: var(--gradient-brand); color: var(--paper-0); font-size: var(--step-small); font-weight: var(--weight-bold); letter-spacing: 0.03em; }
  .uni-name { color: var(--ink-600); font-size: 0.72rem; line-height: 1.25; font-weight: var(--weight-medium); }
  .empty { color: var(--color-text-soft); font-size: var(--step-ui); }

  @media (min-width: 64em) {
    .map-block { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); }
  }
  @media (hover: hover) and (pointer: fine) {
    .tab:not([aria-pressed='true']):hover { background-color: var(--orange-50); color: var(--orange-600); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .ring { animation: ping 2.4s var(--ease-out) infinite; }
    .pin:nth-child(2) .ring { animation-delay: 0.4s; }
    .pin:nth-child(3) .ring { animation-delay: 0.8s; }
    .pin:nth-child(4) .ring { animation-delay: 1.2s; }
    .pin:nth-child(5) .ring { animation-delay: 1.6s; }
    .pin:nth-child(6) .ring { animation-delay: 2s; }
    .pin:nth-child(7) .ring { animation-delay: 2.4s; }
    .pin:nth-child(8) .ring { animation-delay: 2.8s; }
    @keyframes ping { 0% { opacity: 0.55; transform: scale(1); } 100% { opacity: 0; transform: scale(4); } }
    .panel:not([hidden]) .uni { animation: uni-in 420ms var(--ease-out) both; }
    @keyframes uni-in { from { opacity: 0; transform: translateY(6px); } }
    :global(.js) .map .land path.on { fill: color-mix(in srgb, var(--navy-600) 14%, var(--paper-1)); }
    :global(.js) .map.is-in .land path.on { fill: var(--navy-600); transition: fill 900ms var(--ease-out); }
    :global(.js) .map.is-in .land path.on.is-active { fill: var(--orange-500); transition-duration: var(--duration-ui); }
  }
</style>
