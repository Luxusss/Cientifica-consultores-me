---
import { Image } from 'astro:assets';
import { feature } from 'topojson-client';
import { geoMercator, geoPath } from 'd3-geo';
import type { Feature, FeatureCollection, Geometry } from 'geojson';
import topology from 'world-atlas/countries-110m.json';
import { universities } from '@/data/proof';
import peru from '@/assets/images/paises/peru.jpg';
import colombia from '@/assets/images/paises/colombia.jpg';
import mexico from '@/assets/images/paises/mexico.jpg';
import bolivia from '@/assets/images/paises/bolivia.jpg';
import ecuador from '@/assets/images/paises/ecuador.jpg';
import venezuela from '@/assets/images/paises/venezuela.jpg';

const region = ['032', '152', '332', '214', '044', '238', '484', '858', '076', '068', '604', '170', '591', '188', '558', '340', '222', '320', '084', '862', '328', '740', '218', '630', '388', '192', '600', '780'];

const served = [
  { id: '604', name: 'Perú', flag: peru },
  { id: '170', name: 'Colombia', flag: colombia },
  { id: '484', name: 'México', flag: mexico },
  { id: '068', name: 'Bolivia', flag: bolivia },
  { id: '218', name: 'Ecuador', flag: ecuador },
  { id: '862', name: 'Venezuela', flag: venezuela },
];

const count = (name: string) => universities.find((g) => g.country === name)?.names.length ?? 0;

const width = 520;
const height = 640;
const world = feature(topology as never, (topology as never as { objects: { countries: never } }).objects.countries) as unknown as FeatureCollection<Geometry, { name: string }>;
const latam = world.features.filter((f) => region.includes(String(f.id)));
const projection = geoMercator().fitExtent([[8, 8], [width - 8, height - 8]], { type: 'FeatureCollection', features: latam });
const path = geoPath(projection);

const servedIds = served.map((s) => s.id);
const shapes = latam.map((f: Feature<Geometry, { name: string }>) => ({ id: String(f.id), d: path(f) ?? '', on: servedIds.includes(String(f.id)), client: String(f.id) === '152' }));
const pins = served.map((s, i) => {
  const f = latam.find((x) => String(x.id) === s.id)!;
  const [x, y] = path.centroid(f);
  return { ...s, x: Math.round(x), y: Math.round(y), n: count(s.name), i };
});
---

<div class="map-block" data-map>
  <div class="map" data-reveal>
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="mapa-titulo">
      <title id="mapa-titulo">Mapa de Latinoamérica con los seis países donde atiende Científica Consultores</title>
      <g class="land">
        {shapes.map((s) => <path d={s.d} class:list={{ on: s.on, client: s.client }} data-country={s.on ? s.id : undefined} />)}
      </g>
      <g class="pins">
        {pins.map((p) => (
          <g class="pin" data-country={p.id} transform={`translate(${p.x} ${p.y})`}>
            <circle class="ring" r="6" />
            <circle class="dot" r="6" />
          </g>
        ))}
      </g>
    </svg>
  </div>

  <ul class="legend" role="list" data-reveal="stagger">
    {pins.map((p) => (
      <li class="item" data-country={p.id} tabindex="0">
        <Image src={p.flag} alt="" width={36} height={24} class="flag" />
        <span class="name">{p.name}</span>
        <span class="meta">{p.n > 0 ? `${p.n} ${p.n === 1 ? 'universidad' : 'universidades'}` : 'Atención online'}</span>
      </li>
    ))}
    <li class="item extra">
      <span class="name">Chile y España</span>
      <span class="meta">También tenemos clientes de {count('Chile') + count('España')} universidades</span>
    </li>
  </ul>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-map]')) {
    const items = root.querySelectorAll<HTMLElement>('.item[data-country]');
    const set = (id: string | null) => {
      for (const el of root.querySelectorAll<SVGElement>('[data-country]')) el.classList.toggle('is-active', el.dataset.country === id);
    };
    for (const item of items) {
      item.addEventListener('mouseenter', () => set(item.dataset.country ?? null));
      item.addEventListener('focus', () => set(item.dataset.country ?? null));
      item.addEventListener('mouseleave', () => set(null));
      item.addEventListener('blur', () => set(null));
    }
    for (const shape of root.querySelectorAll<SVGElement>('svg [data-country]')) {
      shape.addEventListener('mouseenter', () => set(shape.dataset.country ?? null));
      shape.addEventListener('mouseleave', () => set(null));
    }
  }
</script>

<style>
  .map-block { display: grid; gap: var(--space-xl) var(--gutter); align-items: center; }
  .map svg { display: block; inline-size: 100%; block-size: auto; max-block-size: 36rem; margin-inline: auto; overflow: visible; }
  .land path { fill: color-mix(in srgb, var(--navy-600) 14%, var(--paper-1)); stroke: var(--paper-0); stroke-width: 0.8; transition: fill var(--duration-ui) var(--ease-out); }
  .land path.on { fill: var(--navy-600); cursor: pointer; }
  .land path.client { fill: color-mix(in srgb, var(--navy-600) 45%, var(--paper-1)); }
  .land path.on.is-active { fill: var(--orange-500); }
  .dot { fill: var(--orange-500); stroke: var(--paper-0); stroke-width: 2; }
  .ring { fill: var(--orange-500); opacity: 0; transform-box: fill-box; transform-origin: center; }
  .pin.is-active .dot { fill: var(--paper-0); stroke: var(--orange-500); stroke-width: 3; }

  .legend { display: grid; gap: var(--space-2xs); }
  .item { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--space-s); padding: var(--space-s) var(--space-m); background-color: var(--paper-0); border-radius: var(--radius-card); cursor: default; transition: background-color var(--duration-hover) ease, transform var(--duration-hover) var(--ease-out); }
  .item:focus-visible { outline: var(--focus-ring); outline-offset: 2px; }
  .flag { inline-size: 2.25rem; block-size: 1.5rem; object-fit: cover; border-radius: 4px; box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink-900) 12%, transparent); }
  .name { font-size: var(--step-title); font-weight: var(--weight-medium); letter-spacing: var(--tracking-head); }
  .meta { color: var(--color-text-soft); font-size: var(--step-small); text-align: end; }
  .extra { grid-template-columns: 1fr; background-color: transparent; padding-block: var(--space-xs); }
  .extra .meta { text-align: start; }

  @media (hover: hover) and (pointer: fine) {
    .item[data-country]:hover { background-color: color-mix(in srgb, var(--orange-500) 14%, var(--paper-0)); transform: translateX(4px); }
  }

  @media (min-width: 64em) {
    .map-block { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .ring { animation: ping 2.4s var(--ease-out) infinite; }
    .pin:nth-child(2) .ring { animation-delay: 0.4s; }
    .pin:nth-child(3) .ring { animation-delay: 0.8s; }
    .pin:nth-child(4) .ring { animation-delay: 1.2s; }
    .pin:nth-child(5) .ring { animation-delay: 1.6s; }
    .pin:nth-child(6) .ring { animation-delay: 2s; }
    @keyframes ping { 0% { opacity: 0.55; transform: scale(1); } 100% { opacity: 0; transform: scale(4); } }
    :global(.js) .map .land path.on { fill: color-mix(in srgb, var(--navy-600) 14%, var(--paper-1)); }
    :global(.js) .map.is-in .land path.on { fill: var(--navy-600); transition: fill 900ms var(--ease-out); }
    :global(.js) .map.is-in .land path.on.is-active { fill: var(--orange-500); transition-duration: var(--duration-ui); }
  }
</style>
