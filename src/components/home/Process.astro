---
import { processSection } from '@/data/home';

const { title, text, steps } = processSection;
---

<section class="process theme-field section-wide" aria-labelledby="como-trabajamos">
  <div class="page stack stack-xl">
    <header class="split split-wide head" data-reveal>
      <h2 id="como-trabajamos">{title}</h2>
      <p class="text-lead">{text}</p>
    </header>

    <ol class="steps" role="list" data-reveal="stagger">
      {steps.map((step, i) => (
        <li class="step">
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{step.name}</h3>
          <p class="text">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { display: grid; gap: var(--space-xl) var(--gutter); }
  .step { position: relative; display: grid; gap: var(--space-s); align-content: start; padding-block-start: var(--space-m); border-block-start: 1px solid color-mix(in srgb, var(--paper-0) 22%, transparent); }
  .step::before { content: ''; position: absolute; inset-block-start: -1px; inset-inline-start: 0; inline-size: 3rem; block-size: 3px; background-color: var(--orange-500); }
  .num { font-size: var(--step-display); line-height: 1; font-weight: var(--weight-semibold); letter-spacing: -0.03em; color: var(--orange-500); font-variant-numeric: lining-nums tabular-nums; }
  .step h3 { font-size: var(--step-title); line-height: var(--leading-head); font-weight: var(--weight-medium); letter-spacing: var(--tracking-head); text-wrap: balance; }
  .step .text { color: var(--navy-100); }

  @media (min-width: 40em) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64em) {
    .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: var(--space-2xl); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .step::before { transform-origin: left; transition: transform var(--duration-reveal) var(--ease-out) var(--duration-ui); }
    :global(.js) [data-reveal='stagger']:not(.is-in) .step::before { transform: scaleX(0); }
  }
</style>
