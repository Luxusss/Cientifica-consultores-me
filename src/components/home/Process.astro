---
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';

const steps = [
  {
    name: 'Nos cuentas tu caso',
    text: 'Nos escribes por WhatsApp, correo o formulario, con tu universidad, tu tipo de trabajo y tus fechas. Te ayudamos a elegir el formato correcto: tesis, tesina, TFG, TFM o TSP.',
  },
  {
    name: 'Diagnóstico y presupuesto',
    text: 'Revisamos tu tema, tus avances y el reglamento para trazar una ruta realista. Recibes una propuesta con el alcance, los entregables y la forma de pago.',
  },
  {
    name: 'Contrato y asesor',
    text: 'Firmamos un contrato digital que asegura confidencialidad y plazos. Te asignamos un asesor de tu área, que te acompaña capítulo por capítulo hasta la sustentación.',
  },
];
---

<section class="theme-field section-wide" aria-labelledby="como-trabajamos">
  <div class="page stack stack-xl">
    <header class="split split-end" data-reveal>
      <h2 id="como-trabajamos">Cómo trabajamos</h2>
      <p class="text-lead">Del primer mensaje a tu asesor asignado, en tres momentos claros.</p>
    </header>

    <ol class="steps" role="list" data-reveal="stagger">
      {steps.map((step) => (
        <li class="accent-mark">
          <h3>{step.name}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>

    <div data-reveal><WhatsAppButton label="Empezar ahora por WhatsApp" /></div>
  </div>
</section>

<style>
  .steps { display: grid; gap: var(--space-xl) var(--gutter); }
  .steps li { display: grid; gap: var(--space-s); align-content: start; }
  .steps h3 { font-size: var(--step-lead); line-height: var(--leading-head); font-weight: var(--weight-medium); letter-spacing: var(--tracking-head); }
  .steps p { color: var(--color-text-soft); }

  @media (min-width: 48em) {
    .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
