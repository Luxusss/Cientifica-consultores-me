---
import Icon from '@/components/ui/Icon.astro';
import { processSection } from '@/data/home';

const { title, text, steps } = processSection;
const icons = ['chat', 'list', 'search', 'coin', 'pen', 'user'] as const;
---

<section class="process theme-field section-wide" aria-labelledby="como-trabajamos" data-flow>
  <div class="page stack stack-xl">
    <header class="section-head center" data-reveal>
      <span class="eyebrow">Paso a paso</span>
      <h2 id="como-trabajamos">{title}</h2>
      <p>{text}</p>
    </header>

    <div class="board">
      <ol class="flow" role="list">
        {steps.map((step, i) => (
          <li class:list={['step', `tone-${(i % 6) + 1}`]} data-flow-step>
            <span class="bubble" aria-hidden="true">
              <Icon name={icons[i % icons.length]} size="1.6rem" />
              <span class="num">{i + 1}</span>
            </span>
            <h3>{step.name}</h3>
            <p>{step.short}</p>
          </li>
        ))}
      </ol>
      <div class="meter" aria-hidden="true"><span data-flow-bar></span></div>
    </div>
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-flow]')) {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-flow-step]')];
    const bar = root.querySelector<HTMLElement>('[data-flow-bar]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let timer = 0;
    let visible = false;
    let paused = false;
    const show = (n: number) => {
      i = n % steps.length;
      steps.forEach((s, j) => {
        s.classList.toggle('is-active', j === i);
        s.classList.toggle('is-done', j < i);
      });
      bar.style.transform = `scaleX(${(i + 1) / steps.length})`;
    };
    const stop = () => window.clearInterval(timer);
    const start = () => {
      stop();
      if (reduce || paused || !visible || document.hidden) return;
      timer = window.setInterval(() => show(i + 1), 2600);
    };
    root.classList.add('is-live');
    show(0);
    steps.forEach((s, j) => {
      s.addEventListener('pointerenter', () => { paused = true; stop(); show(j); });
      s.addEventListener('pointerleave', () => { paused = false; start(); });
    });
    document.addEventListener('visibilitychange', start);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) show(0); start(); }, { threshold: 0.35 }).observe(root);
  }
</script>

<style>
  .board { display: grid; gap: var(--space-m); padding: var(--space-l) var(--space-m); border-radius: calc(var(--radius-card) + 0.5rem); background-color: rgb(255 255 255 / 0.06); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1); }
  .flow { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-m) var(--space-s); }

  .step { position: relative; display: grid; justify-items: center; align-content: start; gap: var(--space-2xs); text-align: center; transition: opacity var(--duration-ui) ease; }
  .bubble {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 4.5rem;
    block-size: 4.5rem;
    margin-block-end: var(--space-2xs);
    border-radius: 1.4rem;
    background-color: rgb(255 255 255 / 0.08);
    color: var(--navy-100);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16);
    transition: background var(--duration-reveal) var(--ease-out), color var(--duration-ui) ease, transform var(--duration-reveal) var(--ease-expo), box-shadow var(--duration-reveal) var(--ease-out);
  }
  .num { position: absolute; inset-block-start: -0.5rem; inset-inline-end: -0.5rem; display: grid; place-items: center; inline-size: 1.6rem; block-size: 1.6rem; border-radius: 50%; background-color: var(--paper-0); color: var(--navy-700); font-size: var(--step-small); font-weight: var(--weight-bold); box-shadow: 0 4px 10px rgb(0 0 0 / 0.3); }
  .step h3 { font-size: var(--step-body); line-height: 1.25; }
  .step p { color: var(--navy-100); font-size: var(--step-small); line-height: var(--leading-small); max-inline-size: 22ch; }

  .is-live .step { opacity: 0.55; }
  .is-live .step.is-done { opacity: 0.85; }
  .is-live .step.is-active { opacity: 1; }
  .step.is-done .bubble { background-image: var(--tone-grad); color: var(--paper-0); box-shadow: none; }
  .step.is-active .bubble, :not(.is-live) > .page .bubble { background-image: var(--tone-grad); color: var(--paper-0); transform: translateY(-6px) scale(1.08); box-shadow: 0 0 0 6px rgb(255 255 255 / 0.1), 0 18px 34px -14px rgb(0 0 0 / 0.7); }

  .meter { block-size: 6px; border-radius: 6px; background-color: rgb(255 255 255 / 0.12); overflow: hidden; }
  .meter span { display: block; block-size: 100%; border-radius: inherit; background-image: linear-gradient(90deg, var(--orange-500), var(--gold-400), var(--sky-500)); transform: scaleX(0); transform-origin: left; transition: transform 900ms var(--ease-out); }

  @media (min-width: 48em) {
    .flow { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 64em) {
    .board { padding: var(--space-xl) var(--space-l) var(--space-l); }
    .flow { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--space-s); }
    .step:not(:last-child)::after {
      content: '';
      position: absolute;
      inset-block-start: calc(2.25rem - 1px);
      inset-inline-start: calc(50% + 2.75rem);
      inline-size: calc(100% + var(--space-s) - 5.5rem - 8px);
      block-size: 2px;
      background-image: linear-gradient(90deg, rgb(255 255 255 / 0.5) 50%, transparent 50%);
      background-size: 10px 2px;
    }
    .step:not(:last-child)::before {
      content: '';
      position: absolute;
      inset-block-start: calc(2.25rem - 5px);
      inset-inline-start: calc(150% + var(--space-s) - 2.75rem - 8px);
      border-block: 5px solid transparent;
      border-inline-start: 8px solid rgb(255 255 255 / 0.6);
    }
  }
  @media (min-width: 64em) and (prefers-reduced-motion: no-preference) {
    .step:not(:last-child)::after { animation: dash 900ms linear infinite; }
    @keyframes dash { to { background-position: 10px 0; } }
  }
</style>
