---
import { Image } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import oficina from '@/assets/images/banner/hero/oficina-asesores.jpg';
import original from '@/assets/images/banner/asesores-de-tesis-cientifica-consultores.jpg';
import izquierda from '@/assets/images/banner/hero/asesora-izquierda.png';
import centro from '@/assets/images/banner/hero/asesor-centro.png';
import derecha from '@/assets/images/banner/hero/asesora-derecha.png';

const people = [
  { src: izquierda, alt: 'Asesora de tesis de Científica Consultores', cls: 'p1' },
  { src: centro, alt: 'Asesor de tesis de Científica Consultores', cls: 'p2' },
  { src: derecha, alt: 'Asesora de tesis de Científica Consultores', cls: 'p3' },
];

const badges = [
  { icon: 'user', title: 'Asesor de tu área', text: 'Contigo hasta la sustentación' },
  { icon: 'shield', title: 'Contrato digital', text: 'Confidencialidad garantizada' },
  { icon: 'document', title: 'Reporte Turnitin', text: 'IA y similitud en cada entrega' },
] as const;
---

<section class="hero theme-field" aria-labelledby="hero-title" data-hero data-parallax>
  <div class="media">
    <div class="frame">
      <Image src={oficina} alt="" widths={[640, 960, 1280, 1570]} sizes="100vw" format="webp" quality={72} loading="eager" class="oficina" />
      {people.map((person) => (
        <Image src={person.src} alt="" widths={[200, 320, 480]} sizes="(min-width: 64em) 22vw, 30vw" format="webp" quality={82} loading="eager" fetchpriority="high" class:list={['person', person.cls]} />
      ))}
      <Image src={original} alt="Tres asesores de tesis de Científica Consultores en su oficina de Lima" widths={[640, 960, 1280, 1570]} sizes="100vw" format="webp" quality={72} loading="eager" class="final" />
    </div>
    <span class="spot" aria-hidden="true"></span>
    <span class="sheen" aria-hidden="true"></span>
  </div>
  <ul class="badges" role="list" aria-label="Lo que incluye tu asesoría">
    {badges.map((b, i) => (
      <li class:list={['badge', `badge-${i + 1}`]}>
        <span class="badge-icon"><Icon name={b.icon} size="1.25rem" /></span>
        <span class="badge-text"><strong>{b.title}</strong><span>{b.text}</span></span>
      </li>
    ))}
  </ul>
  <div class="edge-frame content">
    <div class="text">
      <h1 id="hero-title"><span class="line"><span>Asesoría de</span></span> <span class="line"><span>tesis online</span></span> <span class="tail">con expertos en investigación académica</span></h1>
      <p class="lede">Un asesor especialista de tu carrera te acompaña en tu tesis de pregrado, maestría, doctorado o TSP, desde el proyecto hasta la sustentación. Más de 10 años y +4000 tesistas nos respaldan.</p>
      <div class="actions">
        <Button href="/contactanos.html#formulario">Quiero mi primera asesoría gratis</Button>
      </div>
    </div>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>('[data-parallax]');
  const fine = matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) and (min-width: 64em)');
  if (stage && fine.matches) {
    let frame = 0;
    stage.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = stage.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        stage.style.setProperty('--px', x.toFixed(3));
        stage.style.setProperty('--py', y.toFixed(3));
      });
    });
    stage.addEventListener('pointerleave', () => {
      stage.style.setProperty('--px', '0');
      stage.style.setProperty('--py', '0');
    });
  }
</script>

<style>
  .hero { display: grid; overflow: hidden; }

  .media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; container-type: size; }
  .frame { position: absolute; inset-inline-end: 0; inset-block-start: calc((100cqh - max(100cqh, 100cqw * 883 / 1570)) * 0.22); inline-size: max(100cqw, 100cqh * 1570 / 883); aspect-ratio: 1570 / 883; }
  .frame :global(.oficina), .frame :global(.final) { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; }
  .frame :global(.final) { z-index: 2; }
  .frame :global(.person) { position: absolute; block-size: auto; }
  .frame :global(.p1) { inset-inline-start: 41.6561%; inset-block-start: 21.1778%; inline-size: 20%; }
  .frame :global(.p2) { inset-inline-start: 60.8917%; inset-block-start: 20.2718%; inline-size: 21.2102%; z-index: 1; }
  .frame :global(.p3) { inset-inline-start: 81.3376%; inset-block-start: 19.8188%; inline-size: 18.6624%; }

  .content { display: grid; gap: var(--space-xl); padding-block: var(--space-xl) var(--space-2xl); }
  .text { display: grid; gap: var(--space-m); justify-items: start; }
  h1 { color: var(--color-text); max-inline-size: none; }
  .line { display: block; overflow: hidden; padding-block-end: 0.08em; margin-block-end: -0.08em; }
  .line > span { display: block; }
  .tail { display: block; margin-block-start: var(--space-xs); font-size: var(--step-title); line-height: var(--leading-head); letter-spacing: -0.01em; font-weight: var(--weight-medium); color: var(--orange-500); }
  .lede { font-size: var(--step-body); line-height: var(--leading-body); max-inline-size: 38ch; color: var(--color-text-soft); }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-s) var(--space-l); }

  .spot, .sheen { display: none; }
  .badges { display: none; }
  .badge { display: flex; flex-direction: column; align-items: center; gap: var(--space-2xs); text-align: center; color: var(--paper-0); text-shadow: 0 1px 12px color-mix(in srgb, var(--ink-900) 90%, transparent), 0 1px 2px var(--ink-900); }
  .badge-icon { display: grid; place-items: center; inline-size: 2.25rem; block-size: 2.25rem; border-radius: 50%; background-color: var(--orange-500); color: var(--ink-900); flex-shrink: 0; }
  .badge-text { display: grid; gap: 0.15rem; line-height: 1.25; }
  .badge-icon { box-shadow: 0 0 0 6px color-mix(in srgb, var(--orange-500) 25%, transparent); }
  .badge-text strong { font-size: var(--step-ui); font-weight: var(--weight-semibold); }
  .badge-text span { font-size: var(--step-small); color: var(--navy-100); }


  @media (min-width: 64em) {
    .hero { grid-template-areas: 'stack'; block-size: clamp(36rem, 80svh, 46rem); }
    .media, .content { grid-area: stack; }
    .media { aspect-ratio: auto; }
    .media::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, var(--scrim-soft) 0%, transparent 22%),
        linear-gradient(0deg, color-mix(in srgb, var(--ink-900) 70%, transparent) 0%, transparent 34%),
        linear-gradient(90deg, var(--scrim-strong) 0%, var(--scrim-strong) 22%, transparent 58%);
    }
    .content { position: relative; grid-template-rows: 1fr auto; padding-block: calc(var(--header-height) + var(--space-l)) var(--space-l); }
    .text { align-self: center; max-inline-size: min(52%, 46rem); }
    h1 { font-size: min(var(--step-display), 4vw); }
    .line { display: inline-block; }
    .badges { display: block; grid-area: stack; position: relative; z-index: 1; pointer-events: none; translate: calc(var(--px, 0) * -18px) calc(var(--py, 0) * -12px); transition: translate 600ms var(--ease-out); }
    .frame { translate: calc(var(--px, 0) * 14px) calc(var(--py, 0) * 8px); transition: translate 700ms var(--ease-out); }
    .badge { position: absolute; inset-block-end: 13%; translate: -50% 0; inline-size: max-content; max-inline-size: 15vw; text-wrap: balance; }
    .badge-1 { inset-inline-start: 54%; }
    .badge-2 { inset-inline-start: 71.5%; }
    .badge-3 { inset-inline-start: 88.5%; }
    .spot { display: block; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: radial-gradient(circle 26rem at calc((var(--px, 0.3) + 0.5) * 100%) calc((var(--py, -0.1) + 0.5) * 100%), color-mix(in srgb, var(--paper-0) 16%, transparent), transparent 70%); mix-blend-mode: soft-light; opacity: 0; transition: opacity 600ms var(--ease-out); }
    .hero:hover .spot { opacity: 1; }
    .sheen { display: block; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(105deg, transparent 35%, color-mix(in srgb, var(--paper-0) 22%, transparent) 50%, transparent 65%); transform: translateX(-120%); }
    .tail { position: relative; inline-size: fit-content; padding-block-end: 0.35rem; }
    .tail::after { content: ''; position: absolute; inset-inline-start: 0; inset-block-end: 0; inline-size: 100%; block-size: 3px; border-radius: 3px; background-color: var(--orange-500); transform-origin: left; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .frame :global(.person) { animation: descend 1200ms var(--ease-expo) both; }
    .frame :global(.p1) { animation-delay: 250ms; }
    .frame :global(.p2) { animation-delay: 520ms; }
    .frame :global(.p3) { animation-delay: 790ms; }
    .frame :global(.oficina) { animation: settle 1800ms var(--ease-expo) both; }
    @keyframes settle { from { opacity: 0; transform: scale(1.06); } }
    .frame :global(.final) { animation: reveal-final 400ms ease 1900ms both; }
    @keyframes reveal-final { from { opacity: 0; } }
    @keyframes descend { from { opacity: 0; transform: translateY(-16%); filter: blur(12px); } 60% { opacity: 1; } to { transform: translateY(0); filter: blur(0); } }
    .sheen { animation: sheen 1600ms var(--ease-out) 1700ms both; }
    .tail::after { animation: draw 900ms var(--ease-expo) 700ms both; }
    @keyframes sheen { from { transform: translateX(-120%); } to { transform: translateX(120%); } }
    @keyframes draw { from { transform: scaleX(0); } }
    .line > span { animation: line-up var(--duration-reveal) var(--ease-expo) 100ms both; }
    .line + .line > span { animation-delay: calc(100ms + var(--stagger)); }
    .tail, .lede { animation: rise 500ms var(--ease-out) 420ms both; }
    .actions { animation: rise 500ms var(--ease-out) 600ms both; }
    .badge { animation: badge-in 700ms var(--ease-expo) both, float 6s ease-in-out 1.6s infinite; }
    .badge-1 { animation-delay: 800ms, 1.6s; }
    .badge-2 { animation-delay: 1000ms, 2.4s; }
    .badge-3 { animation-delay: 1200ms, 3.2s; }
    @keyframes badge-in { from { opacity: 0; transform: translateY(24px) scale(0.96); } }
    @keyframes float { 50% { transform: translateY(-8px); } }
    @keyframes line-up { from { transform: translateY(105%); } }
    @keyframes rise { from { opacity: 0; transform: translateY(12px); } }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 64em) {
      .frame { animation: hero-push linear both; animation-timeline: view(); animation-range: exit 0% exit 100%; }
      .content { animation: hero-leave linear both; animation-timeline: view(); animation-range: exit 0% exit 70%; }
      @keyframes hero-push { to { transform: scale(1.14); } }
      @keyframes hero-leave { to { opacity: 0; transform: translateY(-80px); } }
    }
  }
</style>
