---
import { Picture } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/config/site';
import { universities } from '@/data/proof';
import heroImg from '@/assets/images/banner/asesores-de-tesis-cientifica-consultores.jpg';

const facts = [
  { value: '+10 años', count: 10, label: 'asesorando tesis' },
  { value: `${site.countries.length} países`, count: site.countries.length, label: 'con atención online' },
  { value: `+${universities.reduce((n, g) => n + g.names.length, 0)} universidades`, count: universities.reduce((n, g) => n + g.names.length, 0), label: 'de nuestros clientes' },
];

const shortcuts = [
  { label: 'Pregrado', href: '/tesis.html' },
  { label: 'Maestría', href: '/tesis-maestria.html' },
  { label: 'Doctorado', href: '/tesis-doctoral.html' },
  { label: 'TSP', href: '/trabajo-de-suficiencia-profesional.html' },
  { label: 'Artículos', href: '/articulos_cientificos.html' },
];

const badges = [
  { icon: 'user', title: 'Asesor de tu área', text: 'Contigo hasta la sustentación' },
  { icon: 'shield', title: 'Contrato digital', text: 'Confidencialidad garantizada' },
  { icon: 'document', title: 'Reporte Turnitin', text: 'IA y similitud en cada entrega' },
] as const;
---

<section class="hero theme-field" aria-labelledby="hero-title" data-hero data-parallax>
  <div class="media">
    <Picture
      src={heroImg}
      formats={['avif', 'webp']}
      alt="Tres asesores de tesis de Científica Consultores en su oficina de Lima"
      widths={[480, 720, 960, 1280, 1600]}
      sizes="100vw"
      quality={72}
      loading="eager"
      fetchpriority="high"
      class="photo"
    />
  </div>
  <ul class="badges" role="list" aria-label="Lo que incluye tu asesoría">
    {badges.map((b, i) => (
      <li class:list={['badge', `badge-${i + 1}`]}>
        <span class="badge-icon"><Icon name={b.icon} size="1.25rem" /></span>
        <span class="badge-text"><strong>{b.title}</strong><span>{b.text}</span></span>
      </li>
    ))}
  </ul>
  <div class="frame content">
    <div class="text">
      <h1 id="hero-title"><span class="line"><span>Asesoría de</span></span> <span class="line"><span>tesis online</span></span> <span class="tail">con expertos en investigación académica</span></h1>
      <p class="lede">Un asesor especialista te acompaña en tu tesis de pregrado, maestría, doctorado o TSP, desde el proyecto hasta la sustentación.</p>
      <nav class="shortcuts" aria-label="Asesoría por grado">
        <ul role="list">
          {shortcuts.map((s) => <li><a href={s.href}>{s.label}<span aria-hidden="true">→</span></a></li>)}
        </ul>
      </nav>
    </div>
    <dl class="facts">
      {facts.map((f) => (
        <div>
          <dt data-count={f.count}>{f.value}</dt>
          <dd>{f.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>('[data-parallax]');
  const fine = matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) and (min-width: 64em)');
  if (stage && fine.matches) {
    let frame = 0;
    stage.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = stage.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        stage.style.setProperty('--px', x.toFixed(3));
        stage.style.setProperty('--py', y.toFixed(3));
      });
    });
    stage.addEventListener('pointerleave', () => {
      stage.style.setProperty('--px', '0');
      stage.style.setProperty('--py', '0');
    });
  }

  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const el of counters) {
      const target = Number(el.dataset.count);
      const text = el.textContent ?? '';
      const start = performance.now() + 600;
      const tick = (now: number) => {
        const t = Math.min(1, Math.max(0, (now - start) / 1200));
        const value = Math.round(target * (1 - Math.pow(1 - t, 3)));
        el.textContent = text.replace(String(target), String(value));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }
</script>

<style>
  .hero { display: grid; overflow: hidden; }

  .media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; }
  .media > :global(picture) { display: block; block-size: 100%; }
  .photo { inline-size: 100%; block-size: 100%; object-fit: cover; object-position: 100% 22%; transform-origin: 100% 40%; }

  .content { display: grid; gap: var(--space-xl); padding-block: var(--space-xl) var(--space-2xl); }
  .text { display: grid; gap: var(--space-m); justify-items: start; }
  h1 { color: var(--color-text); max-inline-size: none; }
  .line { display: block; overflow: hidden; padding-block-end: 0.08em; margin-block-end: -0.08em; }
  .line > span { display: block; }
  .tail { display: block; margin-block-start: var(--space-xs); font-size: var(--step-title); line-height: var(--leading-head); letter-spacing: -0.01em; font-weight: var(--weight-medium); color: var(--orange-500); }
  .lede { font-size: var(--step-body); line-height: var(--leading-body); max-inline-size: 38ch; color: var(--color-text-soft); }

  .shortcuts ul { display: flex; flex-wrap: wrap; gap: var(--space-2xs); }
  .shortcuts a { display: inline-flex; align-items: center; gap: 0.4em; min-block-size: 2.5rem; padding-inline: var(--space-s); border-radius: 999px; background-color: color-mix(in srgb, var(--paper-0) 12%, transparent); color: var(--paper-0); font-size: var(--step-ui); text-decoration: none; transition: background-color var(--duration-hover) ease, color var(--duration-hover) ease, transform var(--duration-press) var(--ease-out); }
  .shortcuts a span { transition: transform var(--duration-hover) var(--ease-out); }
  .shortcuts a:active { transform: scale(0.96); }
  @media (hover: hover) and (pointer: fine) {
    .shortcuts a:hover { background-color: var(--orange-500); color: var(--ink-900); }
    .shortcuts a:hover span { transform: translateX(3px); }
  }

  .badges { display: none; }
  .badge { display: flex; flex-direction: column; align-items: center; gap: var(--space-2xs); text-align: center; color: var(--paper-0); text-shadow: 0 1px 12px color-mix(in srgb, var(--ink-900) 90%, transparent), 0 1px 2px var(--ink-900); }
  .badge-icon { display: grid; place-items: center; inline-size: 2.25rem; block-size: 2.25rem; border-radius: 50%; background-color: var(--orange-500); color: var(--ink-900); flex-shrink: 0; }
  .badge-text { display: grid; gap: 0.15rem; line-height: 1.25; }
  .badge-icon { box-shadow: 0 0 0 6px color-mix(in srgb, var(--orange-500) 25%, transparent); }
  .badge-text strong { font-size: var(--step-ui); font-weight: var(--weight-semibold); }
  .badge-text span { font-size: var(--step-small); color: var(--navy-100); }

  .facts { display: flex; flex-wrap: wrap; gap: var(--space-m) var(--space-xl); }
  .facts dt { white-space: nowrap; }
  .facts div { display: grid; gap: var(--space-3xs); }
  .facts dt { font-size: var(--step-lead); line-height: var(--leading-head); font-weight: var(--weight-semibold); }
  .facts dd { font-size: var(--step-small); line-height: var(--leading-small); color: var(--color-text-soft); }

  @media (min-width: 64em) {
    .hero { grid-template-areas: 'stack'; block-size: clamp(36rem, 80svh, 46rem); }
    .media, .content { grid-area: stack; }
    .media { aspect-ratio: auto; }
    .media::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, var(--scrim-soft) 0%, transparent 22%),
        linear-gradient(0deg, color-mix(in srgb, var(--ink-900) 70%, transparent) 0%, transparent 34%),
        linear-gradient(90deg, var(--scrim-strong) 0%, var(--scrim-strong) 22%, transparent 58%);
    }
    .content { position: relative; grid-template-rows: 1fr auto; padding-block: calc(var(--header-height) + var(--space-l)) var(--space-l); }
    .text { align-self: center; max-inline-size: min(52%, 46rem); }
    h1 { font-size: min(var(--step-display), 4vw); }
    .line { display: inline-block; }
    .facts { max-inline-size: none; }
    .badges { display: block; grid-area: stack; position: relative; z-index: 1; pointer-events: none; translate: calc(var(--px, 0) * -18px) calc(var(--py, 0) * -12px); transition: translate 600ms var(--ease-out); }
    .media .photo { translate: calc(var(--px, 0) * 14px) calc(var(--py, 0) * 10px); scale: 1.04; transition: translate 600ms var(--ease-out); }
    .badge { position: absolute; inset-block-end: 13%; translate: -50% 0; white-space: nowrap; }
    .badge-1 { inset-inline-start: 54%; }
    .badge-2 { inset-inline-start: 71.5%; }
    .badge-3 { inset-inline-start: 88.5%; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .photo { animation: drift 24s var(--ease-soft) both; }
    .line > span { animation: line-up var(--duration-reveal) var(--ease-expo) 100ms both; }
    .line + .line > span { animation-delay: calc(100ms + var(--stagger)); }
    .tail, .lede { animation: rise 500ms var(--ease-out) 420ms both; }
    .shortcuts li { animation: rise 500ms var(--ease-out) both; }
    .shortcuts li:nth-child(1) { animation-delay: 560ms; }
    .shortcuts li:nth-child(2) { animation-delay: 620ms; }
    .shortcuts li:nth-child(3) { animation-delay: 680ms; }
    .shortcuts li:nth-child(4) { animation-delay: 740ms; }
    .shortcuts li:nth-child(5) { animation-delay: 800ms; }
    .facts { animation: rise 600ms var(--ease-out) 600ms both; }
    .badge { animation: badge-in 700ms var(--ease-expo) both, float 6s ease-in-out 1.6s infinite; }
    .badge-1 { animation-delay: 800ms, 1.6s; }
    .badge-2 { animation-delay: 1000ms, 2.4s; }
    .badge-3 { animation-delay: 1200ms, 3.2s; }
    @keyframes badge-in { from { opacity: 0; transform: translateY(24px) scale(0.96); } }
    @keyframes float { 50% { transform: translateY(-8px); } }
    @keyframes drift { from { transform: scale(1.06); } to { transform: scale(1); } }
    @keyframes line-up { from { transform: translateY(105%); } }
    @keyframes rise { from { opacity: 0; transform: translateY(12px); } }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 64em) {
      .media > :global(picture) { animation: hero-push linear both; animation-timeline: view(); animation-range: exit 0% exit 100%; }
      .content { animation: hero-leave linear both; animation-timeline: view(); animation-range: exit 0% exit 70%; }
      @keyframes hero-push { to { transform: scale(1.14); } }
      @keyframes hero-leave { to { opacity: 0; transform: translateY(-80px); } }
    }
  }
</style>
