---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Carousel from '@/components/ui/Carousel.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 8);
const fmt = new Intl.DateTimeFormat('es-PE', { day: 'numeric', month: 'long', year: 'numeric' });
const day = new Intl.DateTimeFormat('es-PE', { day: '2-digit' });
const mon = new Intl.DateTimeFormat('es-PE', { month: 'short' });
const minutes = (body = '') => Math.max(1, Math.round(body.split(/\s+/).length / 200));
---

<section class="section-wide blog-band band-soft" aria-labelledby="blog-academico">
  <div class="page stack stack-xl">
    <header class="head" data-reveal>
      <div class="section-head">
        <span class="eyebrow">Blog</span>
        <h2 id="blog-academico">Blog <span class="accent">académico</span></h2>
        <p>Guías, consejos y novedades para avanzar con tu investigación.</p>
      </div>
      <a class="link-pill" href="/blog.html">Ver todos los artículos</a>
    </header>

    <Carousel label="Últimos artículos del blog" perView={3}>
      {posts.map((p, i) => (
        <li class:list={['post', `tone-${(i % 5) + 1}`]}>
          <a class="card" href={`/blog/${p.id}.html`}>
            <span class="media">
              <Image src={p.data.cover} alt={p.data.title} widths={[360, 540, 720]} sizes="(min-width: 64em) 30vw, (min-width: 40em) 50vw, 85vw" class="cover" />
              <span class="tag">Artículo</span>
              <span class="cal" aria-hidden="true"><strong>{day.format(p.data.date)}</strong>{mon.format(p.data.date).replace(".", "")}</span>
            </span>
            <span class="body">
              <span class="meta"><time class="date" datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time><span class="sep" aria-hidden="true">•</span><span>{minutes(p.body)} min de lectura</span></span>
              <span class="title">{p.data.heading}</span>
              <span class="excerpt">{p.data.description}</span>
              <span class="read">Leer artículo <span aria-hidden="true">→</span></span>
            </span>
          </a>
        </li>
      ))}
    </Carousel>
  </div>
</section>

<style>
  .accent { color: var(--navy-600); }
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-s); }
  .cal { position: absolute; inset-block-end: var(--space-xs); inset-inline-end: var(--space-xs); display: grid; justify-items: center; min-inline-size: 3rem; padding: 0.35rem 0.5rem; border-radius: 0.75rem; background-color: var(--paper-0); color: var(--ink-600); font-size: var(--step-small); line-height: 1.1; text-transform: uppercase; box-shadow: var(--shadow-card); }
  .cal strong { color: var(--tone-ink, var(--tone)); font-size: var(--step-title); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5em; font-size: var(--step-small); color: var(--ink-600); }
  .sep { color: var(--tone); }

  .post { display: flex; }
  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    inline-size: 100%;
    overflow: hidden;
    border-radius: var(--radius-card);
    background-color: var(--paper-0);
    color: var(--color-text);
    text-decoration: none;
    box-shadow: var(--shadow-card);
    transition: translate var(--duration-ui) var(--ease-out), box-shadow var(--duration-ui) var(--ease-out);
  }
  .media { position: relative; display: block; overflow: hidden; }
  .cover { inline-size: 100%; aspect-ratio: 16 / 10; object-fit: cover; transition: transform var(--duration-reveal) var(--ease-out); }
  .tag { position: absolute; inset-block-start: var(--space-xs); inset-inline-start: var(--space-xs); padding: 0.25em 0.75em; border-radius: var(--radius-pill); background-image: var(--tone-grad); color: var(--paper-0); font-size: var(--step-small); font-weight: var(--weight-bold); }
  .body { display: flex; flex-direction: column; gap: var(--space-2xs); padding: var(--space-m); }
  .date { color: var(--tone-ink, var(--tone)); font-weight: var(--weight-semibold); }
  .title { font-family: var(--font-display); font-size: var(--step-title); line-height: 1.25; font-weight: var(--weight-semibold); text-wrap: balance; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .excerpt { color: var(--color-text-soft); font-size: var(--step-small); line-height: var(--leading-body); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .read { margin-block-start: auto; padding-block-start: var(--space-2xs); color: var(--navy-600); font-size: var(--step-ui); font-weight: var(--weight-semibold); }

  @media (hover: hover) and (pointer: fine) {
    .card:hover { translate: 0 -6px; box-shadow: var(--shadow-lift); }
    .card:hover .cover { transform: scale(1.06); }
  }
</style>
