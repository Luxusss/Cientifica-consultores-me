---
import { Image } from 'astro:assets';
import type { Testimonial } from '@/data/proof';
import { stats } from '@/data/stats';
import { chatQuotes } from '@/data/captures';
import graduados from '@/assets/images/otros/graduados.jpg';

interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props;
const initials = (name: string) => name.split(' ').filter((w) => /^\p{Lu}/u.test(w)).slice(0, 2).map((w) => w[0]).join('');
const rows = [
  testimonials.map((t) => ({ quote: t.quote, name: t.name, meta: `${t.university}, ${t.country}` })),
  chatQuotes.map((c) => ({ quote: c.quote, name: c.name, meta: `${c.tag} · mensaje de WhatsApp adaptado` })),
];
---

<section class="quote section-wide" aria-labelledby="testimonios-titulo">
  <Image src={graduados} alt="" widths={[960, 1440, 1920]} sizes="100vw" class="bg" />
  <span class="veil" aria-hidden="true"></span>

  <div class="page head-wrap">
    <header class="section-head center" data-reveal>
      <span class="eyebrow">Testimonios</span>
      <h2 id="testimonios-titulo">Lo que dicen nuestros <span class="text-gradient">tesistas</span></h2>
      <p><strong>+{stats.clients}</strong> tesistas de <strong>{stats.countries}</strong> países ya trabajaron con nosotros.</p>
    </header>
  </div>

  <div class="rows">
    {rows.map((list, r) => (
      <div class:list={['marquee', { reverse: r === 1 }]}>
        {[0, 1].map((copy) => (
          <ul class="track" role="list" aria-hidden={copy === 1 ? 'true' : undefined} aria-label={copy === 0 ? (r === 0 ? 'Testimonios de clientes' : 'Mensajes de WhatsApp de nuestros tesistas') : undefined}>
            {list.map((t, i) => (
              <li class:list={['card', `tone-${((i + r * 2) % 5) + 1}`]}>
                <figure>
                  <blockquote><p>“{t.quote}”</p></blockquote>
                  <figcaption>
                    <span class="avatar" aria-hidden="true">{initials(t.name)}</span>
                    <span class="who">
                      <strong>{t.name}</strong>
                      <span>{t.meta}</span>
                    </span>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        ))}
      </div>
    ))}
  </div>

  <div class="page more-wrap">
    <a class="link-pill" href="/testimonios.html">Ver más testimonios</a>
  </div>
</section>

<style>
  .quote { position: relative; overflow: hidden; isolation: isolate; display: grid; gap: var(--space-l); color: var(--paper-0); }
  .bg { position: absolute; inset: 0; z-index: -2; inline-size: 100%; block-size: 100%; object-fit: cover; object-position: 50% 30%; }
  .veil { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(20 31 102 / 0.86) 0%, rgb(29 45 140 / 0.72) 45%, rgb(59 40 170 / 0.84) 100%); }
  .quote .section-head p { color: var(--navy-100); }
  .quote .section-head strong { color: var(--paper-0); }
  .quote .eyebrow { background-color: rgb(255 255 255 / 0.12); color: var(--gold-400); }
  .quote .text-gradient { background-image: linear-gradient(90deg, var(--gold-400), var(--orange-500)); }
  .quote .link-pill { background-color: transparent; color: var(--paper-0); box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.55); }
  .quote .link-pill::after { background-color: var(--orange-500); color: var(--ink-900); }
  @media (hover: hover) and (pointer: fine) { .quote .link-pill:hover { background-color: var(--paper-0); color: var(--navy-700); } }

  .rows { display: grid; gap: var(--space-s); }
  .marquee { display: flex; gap: var(--space-s); overflow-x: auto; scrollbar-width: none; padding-inline: var(--page-margin); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .track { display: flex; gap: var(--space-s); flex-shrink: 0; }
  .track[aria-hidden='true'] { display: none; }

  .card { display: flex; inline-size: min(78vw, 22rem); flex-shrink: 0; }
  figure {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--space-s);
    inline-size: 100%;
    padding: var(--space-m);
    border-radius: var(--radius-card);
    background-color: rgb(255 255 255 / 0.96);
    color: var(--ink-900);
    box-shadow: 0 20px 40px -24px rgb(0 0 0 / 0.6);
    overflow: hidden;
  }
  figure::before { content: ''; position: absolute; inset: 0 0 auto; block-size: 4px; background-image: var(--tone-grad); }
  figure::after { content: '“'; position: absolute; inset-block-start: -0.5rem; inset-inline-end: 0.8rem; font-family: var(--font-display); font-size: 5rem; line-height: 1; color: var(--tone); opacity: 0.18; }
  blockquote p { font-size: var(--step-ui); line-height: var(--leading-body); color: var(--ink-600); }
  figcaption { display: flex; align-items: center; gap: var(--space-xs); padding-block-start: var(--space-xs); border-block-start: 1px solid var(--paper-2); }
  .avatar { display: grid; place-items: center; flex-shrink: 0; inline-size: 2.4rem; block-size: 2.4rem; border-radius: 50%; background-image: var(--tone-grad); color: var(--paper-0); font-weight: var(--weight-bold); font-size: var(--step-small); }
  .who { display: grid; gap: 0.1rem; line-height: 1.3; }
  .who strong { font-size: var(--step-ui); }
  .who span { font-size: var(--step-small); color: var(--ink-600); }


  .more-wrap { display: grid; justify-items: center; }


  @media (prefers-reduced-motion: no-preference) {
    .marquee { overflow: hidden; padding-inline: 0; }
    .track[aria-hidden='true'] { display: flex; }
    .track { animation: slide 60s linear infinite; }
    .reverse .track { animation-direction: reverse; animation-duration: 70s; }
    .marquee:hover .track, .marquee:focus-within .track { animation-play-state: paused; }
    @keyframes slide { to { transform: translateX(calc(-100% - var(--space-s))); } }
  }
</style>
