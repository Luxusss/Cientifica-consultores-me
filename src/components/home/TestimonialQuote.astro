---
import type { Testimonial } from '@/data/proof';

interface Props {
  testimonials: Testimonial[];
}

const [lead, ...rest] = Astro.props.testimonials;
---

<section class="quote theme-field section-wide" aria-label="Testimonios">
  <div class="page stack stack-xl">
    <figure class="lead" data-reveal>
      <span class="mark" aria-hidden="true">“</span>
      <blockquote>
        <p>{lead.highlight ?? lead.quote}</p>
      </blockquote>
      <figcaption class="accent-mark">
        <strong>{lead.name}</strong>
        <span>{lead.university}, {lead.country}</span>
      </figcaption>
    </figure>

    <ul class="others" role="list" data-reveal="stagger">
      {rest.map((t) => (
        <li>
          <figure>
            <blockquote><p>“{t.quote}”</p></blockquote>
            <figcaption>
              <strong>{t.name}</strong>
              <span>{t.university}, {t.country}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <a class="more" href="/testimonios.html">Ver más testimonios</a>
  </div>
</section>

<style>
  .lead { display: grid; gap: var(--space-l); }
  .mark { font-size: var(--step-display); line-height: 0.6; color: var(--color-accent); block-size: 0.45em; }
  .lead blockquote p {
    max-inline-size: 44ch;
    font-size: var(--step-lead);
    line-height: var(--leading-lead);
    letter-spacing: var(--tracking-head);
  }
  figcaption { display: grid; gap: var(--space-3xs); }
  figcaption span { color: var(--color-text-soft); font-size: var(--step-small); }

  .others { display: grid; gap: var(--space-xl) var(--gutter); }
  .others figure { display: grid; gap: var(--space-s); align-content: start; }
  .others blockquote p { color: var(--color-text); }

  @media (min-width: 64em) {
    .lead { padding-inline-start: calc(100% / 12); }
    .lead blockquote p { font-size: min(var(--step-head), 2.25rem); line-height: var(--leading-head); }
    .others { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
