---
import { Image } from 'astro:assets';
import AdvisoryVideo from '@/components/sections/AdvisoryVideo.astro';
import { site } from '@/config/site';
import { tools } from '@/data/proof';
import { listEs } from '@/lib/format';
import team from '@/assets/images/banner/nuestro-equipo-de-asesores-de-tesis.jpg';

const facts = [
  { label: 'Experiencia', value: 'Más de 10 años' },
  { label: 'Oficina', value: `${site.address.district}, ${site.address.city}` },
  { label: 'Modalidad', value: 'Online y presencial' },
  { label: 'Herramientas', value: listEs(tools) },
];
---

<section class="scene grow" aria-labelledby="nosotros">
  <div class="scene-stage">
    <div class="opening on-scene">
      <h2 id="nosotros">Más de 10 años investigando</h2>
      <p class="text-lead">Un equipo real de asesores en Lima, de pregrado a doctorado.</p>
    </div>
    <div class="window on-scene">
      <Image src={team} alt="Equipo de asesores de tesis de Científica Consultores en su oficina de Lima" widths={[640, 960, 1280, 1600, 1920]} sizes="100vw" class="team on-scene" />
    </div>
    <p class="statement on-scene">Cada asesor viene de tu área: ingeniería, salud, ciencias sociales o letras. Trabajamos contigo, no por ti.</p>
  </div>
</section>

<section class="section page about" aria-label="Quiénes somos">
  <div class="text stack stack-l" data-reveal="stagger">
    <p class="text-lead">Acompañamos a estudiantes de pregrado, maestría y doctorado de habla hispana, con asesoría para tesis, tesinas y trabajos de grado, online o en nuestra oficina.</p>
    <dl class="facts accent-mark">
      {facts.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>
    <p class="note">Tu proyecto es confidencial por contrato y revisamos la originalidad con Turnitin en cada entrega.</p>
  </div>
  <div class="video-wrap"><AdvisoryVideo /></div>
</section>

<style>
  .grow { padding-block: var(--section-gap) 0; }
  .scene-stage { display: grid; gap: var(--space-l); }
  .opening { display: grid; gap: var(--space-m); padding-inline: var(--page-margin); }
  .window { overflow: hidden; aspect-ratio: 4 / 3; }
  .team { inline-size: 100%; block-size: 100%; object-fit: cover; object-position: 50% 22%; transform-origin: 50% 22%; }
  .statement { padding-inline: var(--page-margin); font-size: var(--step-lead); line-height: var(--leading-lead); max-inline-size: 34ch; }

  .about { display: grid; gap: var(--space-xl) var(--gutter); align-items: start; }
  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-m) var(--gutter); }
  .facts dt { color: var(--color-text-soft); font-size: var(--step-small); }
  .facts dd { font-size: var(--step-lead); line-height: var(--leading-head); font-weight: var(--weight-medium); letter-spacing: var(--tracking-head); }
  .note { color: var(--color-text-soft); }

  @media (min-width: 64em) {
    .about { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .text { grid-column: 1 / span 5; }
    .video-wrap { grid-column: 7 / -1; }
    .window { aspect-ratio: 21 / 9; margin-inline: var(--page-margin); }
    .opening { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: end; padding-inline: max(var(--page-margin), calc((100vw - var(--page-max)) / 2)); }
    .opening h2 { grid-column: 1 / span 6; }
    .opening p { grid-column: 8 / -1; }
    .statement { padding-inline: max(var(--page-margin), calc((100vw - var(--page-max)) / 2)); font-size: min(var(--step-head), 2.25rem); line-height: var(--leading-head); }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 64em) {
      .grow { --hold: 2; padding-block: 0; }
      .scene-stage { display: block; }
      .opening {
        position: absolute;
        inset-block-start: var(--space-2xl);
        inset-inline: 0;
        z-index: 2;
        animation-name: opening-out;
        animation-range: contain 6% contain 24%;
      }
      .window {
        position: absolute;
        inset: 0;
        margin: 0;
        aspect-ratio: auto;
        animation-name: window-open;
        animation-range: contain 0% contain 55%;
      }
      .team { animation-name: team-settle; animation-range: contain 0% contain 70%; }
      .statement {
        position: absolute;
        inset-block-end: var(--space-2xl);
        inset-inline-start: 0;
        z-index: 2;
        max-inline-size: none;
        inline-size: min(100%, calc(var(--page-max) / 2));
        padding-block: var(--space-l);
        background-color: var(--scrim-strong);
        color: var(--paper-0);
        animation-name: statement-in;
        animation-range: contain 58% contain 78%;
      }
      @keyframes window-open { from { clip-path: inset(46% var(--page-margin) 4% 50%); } to { clip-path: inset(0); } }
      @keyframes team-settle { from { transform: scale(1.3); } to { transform: scale(1); } }
      @keyframes opening-out { to { opacity: 0; visibility: hidden; transform: translateY(-40px); } }
      @keyframes statement-in { from { opacity: 0; visibility: hidden; transform: translateY(40px); } }
    }
  }
</style>
