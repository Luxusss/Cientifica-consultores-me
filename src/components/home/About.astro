---
import AdvisoryVideo from '@/components/sections/AdvisoryVideo.astro';
import Icon from '@/components/ui/Icon.astro';
import { quality, team } from '@/data/home';

const highlights = [
  { icon: 'user', text: 'Asesor de tu área' },
  { icon: 'calendar', text: 'Sesiones programadas' },
  { icon: 'globe', text: 'Atención online' },
] as const;
---

<section class="section-wide video-band" aria-labelledby="asesorias-video">
  <div class="page stack stack-xl">
    <header class="section-head center" data-reveal>
      <span class="eyebrow">{team.kicker}</span>
      <h2 id="asesorias-video">{team.title}</h2>
      <p>{team.text}</p>
    </header>

    <div class="video-wrap">
      <AdvisoryVideo featured />
      <ul class="chips" role="list">
        {highlights.map((h, i) => (
          <li class:list={['chip', `chip-${i + 1}`]}><Icon name={h.icon} size="1rem" />{h.text}</li>
        ))}
      </ul>
    </div>

    <div class="quality" data-reveal="stagger">
      {quality.map((q, i) => (
        <article class:list={['q-card', `tone-${i + 2}`]}>
          <h3>{q.title}</h3>
          <p>{q.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .video-wrap { position: relative; inline-size: min(100%, 60rem); margin-inline: auto; }
  .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2xs); margin-block-start: var(--space-m); }
  .chip { display: inline-flex; align-items: center; gap: 0.5em; padding: 0.55em 1em; border-radius: var(--radius-pill); background-color: var(--paper-0); color: var(--navy-600); font-size: var(--step-ui); font-weight: var(--weight-semibold); box-shadow: var(--shadow-card); }
  .chip :global(svg) { color: var(--orange-500); }

  .quality { display: grid; gap: var(--space-s); }
  .q-card { display: grid; gap: var(--space-2xs); align-content: start; padding: var(--space-m) var(--space-l); border-radius: var(--radius-card); background-color: var(--paper-0); box-shadow: var(--shadow-card); border-block-start: 4px solid var(--tone); }
  .q-card h3 { font-size: var(--step-title); line-height: 1.25; }
  .q-card p { color: var(--color-text-soft); font-size: var(--step-ui); max-inline-size: none; }

  @media (min-width: 48em) {
    .quality { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64em) {
    .chips { position: absolute; inset: auto 0 -1.4rem; margin: 0; }
    .quality { margin-block-start: var(--space-s); }
  }
</style>
