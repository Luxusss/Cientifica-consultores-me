---
import { Image } from 'astro:assets';
import AdvisoryVideo from '@/components/sections/AdvisoryVideo.astro';
import { quality } from '@/data/home';
import team from '@/assets/images/otros/asesores-tesis-peru-cientifica.jpg';
---

<section class="section page team-band" aria-labelledby="nosotros">
  <figure class="photo" data-reveal>
    <Image src={team} alt="Equipo de asesores de tesis de Científica Consultores reunido en su oficina de Lima" widths={[480, 720, 960, 1103]} sizes="(min-width: 64em) 56vw, 100vw" class="team" />
  </figure>
  <div class="copy stack stack-l" data-reveal>
    <h2 id="nosotros">Más de 10 años investigando</h2>
    <p class="text-lead">Un equipo real de asesores en Lima, de pregrado a doctorado.</p>
    <p class="statement">Cada asesor viene de tu área: ingeniería, salud, ciencias sociales o letras. Trabajamos contigo, no por ti.</p>
  </div>
</section>

<section class="section page about" aria-label="Quiénes somos">
  <div class="text stack stack-xl" data-reveal="stagger">
    {quality.map((q) => (
      <div class="stack stack-m">
        <h2 class="minor">{q.title}</h2>
        <p>{q.text}</p>
      </div>
    ))}
  </div>
  <div class="video-wrap stack stack-m">
    <h2 class="minor" id="asesorias-video">Así son nuestras asesorías</h2>
    <AdvisoryVideo />
  </div>
</section>

<style>
  .team-band { display: grid; gap: var(--space-xl) var(--gutter); align-items: center; }
  .photo { overflow: hidden; border-radius: var(--radius-card); background-color: var(--color-surface); }
  .team { inline-size: 100%; aspect-ratio: 3 / 2; object-fit: cover; object-position: 50% 45%; }
  .copy { justify-items: start; }
  .statement { padding-inline-start: var(--space-m); border-inline-start: 3px solid var(--orange-500); font-size: var(--step-lead); line-height: var(--leading-lead); max-inline-size: 34ch; }

  .about { display: grid; gap: var(--space-xl) var(--gutter); align-items: start; }
  .minor { max-inline-size: none; font-size: var(--step-lead); line-height: var(--leading-head); font-weight: var(--weight-medium); letter-spacing: var(--tracking-head); }

  @media (min-width: 64em) {
    .about { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .text { grid-column: 1 / span 7; }
    .minor { font-size: min(var(--step-head), 2rem); }
    .video-wrap { grid-column: 8 / -1; }
    .team-band { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .photo { grid-column: 1 / span 7; }
    .copy { grid-column: 9 / -1; }
  }
</style>
