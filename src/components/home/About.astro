---
import { Image } from 'astro:assets';
import AdvisoryVideo from '@/components/sections/AdvisoryVideo.astro';
import { site } from '@/config/site';
import { tools } from '@/data/proof';
import { listEs } from '@/lib/format';
import office from '@/assets/images/otros/asesores-tesis-peru-cientifica.jpg';
import team from '@/assets/images/banner/nuestro-equipo-de-asesores-de-tesis.jpg';

const slides = [
  { src: office, alt: 'Reunión del equipo de Científica Consultores en su oficina' },
  { src: team, alt: 'Equipo de asesores de tesis de Científica Consultores' },
];

const facts = [
  { label: 'Experiencia', value: 'Más de 10 años' },
  { label: 'Oficina', value: `${site.address.district}, ${site.address.city}` },
  { label: 'Modalidad', value: 'Online y presencial' },
  { label: 'Herramientas', value: listEs(tools) },
];
---

<section class="section-wide page about" aria-labelledby="nosotros">
  <div class="slides" data-reveal="shutter">
    {slides.map((s, i) => (
      <Image src={s.src} alt={i === 0 ? s.alt : ''} widths={[640, 960, 1280, 1600]} sizes="(min-width: 64em) 58vw, 100vw" class="slide" />
    ))}
  </div>

  <div class="text stack stack-l" data-reveal="stagger">
    <h2 id="nosotros">Más de 10 años investigando</h2>
    <p class="text-lead">Somos un equipo multidisciplinario de asesores en Lima. Acompañamos a estudiantes de pregrado, maestría y doctorado de habla hispana, con asesoría para tesis, tesinas y trabajos de grado, online o en nuestra oficina.</p>
    <dl class="facts accent-mark">
      {facts.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <p class="note" data-reveal>Tu proyecto es confidencial por contrato. Revisamos la originalidad con Turnitin en cada entrega y trabajamos en horarios flexibles, por videollamada o en persona.</p>
  <div class="video-wrap"><AdvisoryVideo /></div>
</section>

<style>
  .about { display: grid; gap: var(--space-xl) var(--gutter); }

  .slides { display: grid; aspect-ratio: 4 / 3; overflow: hidden; }
  .slide { grid-area: 1 / 1; inline-size: 100%; block-size: 100%; object-fit: cover; }
  .slide:not(:first-child) { opacity: 0; }

  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-m) var(--gutter); }
  .facts dt { color: var(--color-text-soft); font-size: var(--step-small); }
  .facts dd { font-size: var(--step-lead); line-height: var(--leading-head); font-weight: var(--weight-medium); letter-spacing: var(--tracking-head); }

  .note { font-size: var(--step-lead); line-height: var(--leading-lead); }

  @media (min-width: 64em) {
    .about { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: center; }
    .slides { grid-column: 1 / span 6; aspect-ratio: 5 / 4; }
    .text { grid-column: 7 / -1; padding-inline-start: var(--gutter); }
    .note { grid-column: 1 / span 4; align-self: end; }
    .video-wrap { grid-column: 6 / -1; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .slide { animation: crossfade 15s ease-in-out infinite both; }
    .slide:nth-child(2) { animation-delay: -7.5s; }
    @keyframes crossfade {
      0%, 40% { opacity: 1; }
      50%, 90% { opacity: 0; }
      100% { opacity: 1; }
    }
  }
</style>
