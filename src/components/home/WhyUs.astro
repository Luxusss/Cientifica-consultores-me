---
import { Image } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import { whyUs } from '@/data/home';
import datos from '@/assets/images/home/por-que-datos.jpg';
import integridad from '@/assets/images/home/por-que-integridad.jpg';
import flexibilidad from '@/assets/images/home/por-que-flexibilidad.jpg';
import agil from '@/assets/images/home/por-que-agil.jpg';
import equipo from '@/assets/images/home/por-que-equipo.jpg';

const icons = ['lock', 'badge', 'clock', 'bolt', 'users'] as const;
const images = [datos, integridad, flexibilidad, agil, equipo];
import BrandMark from '@/components/ui/BrandMark.astro';
---

<section class="section-wide why" aria-labelledby="por-que">
  <div class="page stack stack-xl">
    <header class="section-head center" data-reveal>
      <span class="eyebrow">Nuestra diferencia</span>
      <h2 id="por-que">{whyUs.title}</h2>
      <p>{whyUs.text}</p>
    </header>
    <ul class="cards" role="list" data-reveal="stagger">
      {whyUs.items.map((item, i) => (
        <li class:list={['card', `tone-${(i % 5) + 1}`, { wide: i < 2 }]}>
          <span class="media">
            <span class="brand-frame clip"><BrandMark tone="light" /><Image src={images[i % images.length]} alt="" widths={[360, 540, 720]} sizes="(min-width: 64em) 33vw, (min-width: 48em) 50vw, 100vw" class="img" /></span>
            <span class="icon"><Icon name={icons[i % icons.length]} size="1.15rem" /></span>
          </span>
          <div class="body">
            <h3>{item.name}</h3>
            <p>{item.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cards { display: grid; gap: var(--space-s); }
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-card);
    background-color: var(--paper-0);
    box-shadow: var(--shadow-card);
    transition: opacity var(--duration-reveal) var(--ease-expo), transform var(--duration-reveal) var(--ease-expo), translate var(--duration-ui) var(--ease-out), box-shadow var(--duration-ui) var(--ease-out);
  }
  .media { position: relative; display: block; }
  .clip { position: relative; }
  .img { inline-size: 100%; aspect-ratio: 3 / 1; object-fit: cover; transition: transform var(--duration-reveal) var(--ease-out); }
  .card:not(.wide) .img { aspect-ratio: 2 / 1; }
  .icon { position: absolute; z-index: 1; inset-block-end: -1.25rem; inset-inline-start: var(--space-m); display: grid; place-items: center; inline-size: 2.6rem; block-size: 2.6rem; border-radius: 0.8rem; background-image: var(--tone-grad); color: var(--paper-0); box-shadow: 0 0 0 4px var(--paper-0), 0 10px 20px -10px var(--tone); }
  .body { display: grid; gap: var(--space-2xs); align-content: start; padding: calc(var(--space-m) + 0.75rem) var(--space-m) var(--space-m); }
  h3 { font-size: var(--step-title); line-height: 1.25; }
  .body p { color: var(--color-text-soft); font-size: var(--step-ui); }
  .clip { display: block; overflow: hidden; }

  @media (min-width: 48em) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64em) {
    .cards { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .card { grid-column: span 2; }
    .card.wide { grid-column: span 3; }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .card:hover { translate: 0 -5px; box-shadow: var(--shadow-lift); }
    .card:hover .img { transform: scale(1.05); }
  }
</style>
