---
import type { HTMLAttributes } from 'astro/types';
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  label?: string;
  /** Muestra un ícono de calendario antes del texto */
  icon?: boolean;
}

const { label = 'Quiero mi asesoría gratis', icon = false, ...rest } = Astro.props;
const withForm = /^\/(tesis|tesis-maestria|tesis-doctoral|trabajo-de-suficiencia-profesional|articulos_cientificos|contactanos)(\.html)?\/?$/.test(Astro.url.pathname);
---

<Button href={withForm ? '#formulario' : '/contactanos.html#formulario'} {...rest}>{icon && <Icon name="calendar" size="1.1rem" />}{label}</Button>
