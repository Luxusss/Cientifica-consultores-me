---
import { whatsappUrl } from '@/config/site';
import Icon from './Icon.astro';
---

<a class="float" href={whatsappUrl()} target="_blank" rel="noopener">
  <Icon name="whatsapp" size="1.5em" />
  <span>Habla con un asesor</span>
</a>

<style>
  .float {
    position: fixed;
    inset-inline-end: var(--page-margin);
    inset-block-end: calc(var(--page-margin) + env(safe-area-inset-bottom, 0px));
    z-index: var(--z-float);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-block-size: var(--button-height);
    padding-inline: var(--space-s);
    background-color: var(--color-field);
    color: var(--color-on-field);
    font-size: var(--step-small);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    user-select: none;
    -webkit-user-select: none;
    transition:
      background-color var(--duration-hover) ease,
      transform var(--duration-press) var(--ease-out);
  }
  .float:active { transform: scale(0.96); }
  .float:focus-visible { outline-color: var(--orange-500); }

  /* En el celular solo el ícono, para no tapar el contenido. */
  @media (max-width: 47.99em) {
    .float { padding-inline: 0; inline-size: var(--button-height); justify-content: center; }
    .float span { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); }
  }

  @media (hover: hover) and (pointer: fine) {
    .float:hover { background-color: var(--navy-700); }
  }
</style>
