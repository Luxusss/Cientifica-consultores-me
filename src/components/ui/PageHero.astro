---
import Breadcrumbs from './Breadcrumbs.astro';
import type { NavLink } from '@/config/navigation';

interface Props {
  title: string;
  crumb?: string;
  trail?: NavLink[];
  subtitle?: string;
  lede?: string;
  balance?: 'text' | 'media' | 'photo';
  tone?: 'plain' | 'field';
}

const { title, crumb = title, trail, subtitle, lede, balance = 'text', tone = 'plain' } = Astro.props;
const hasMedia = Astro.slots.has('media');
---

<section class:list={['page-hero', balance === 'photo' && hasMedia ? 'photo-hero theme-field' : 'section page', hasMedia && balance !== 'photo' && `with-media favor-${balance}`, tone === 'field' && balance !== 'photo' && 'theme-field field-hero']} aria-labelledby="titulo">
  <div class="stack stack-m text">
    <Breadcrumbs current={crumb} trail={trail} />
    <h1 id="titulo"><slot name="title">{title}</slot></h1>
    {subtitle && <p class="text-lead text-strong">{subtitle}</p>}
    {lede && <p class="text-lead">{lede}</p>}
    <slot />
  </div>
  {hasMedia && <div class="media"><slot name="media" /></div>}
</section>

<style>
  .page-hero { display: grid; gap: var(--space-l); }
  .with-media .media:has(> img) { grid-row: 1; }
  .media :global(img) { inline-size: 100%; block-size: auto; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 25%; }

  .field-hero {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-2xl);
    align-items: center;
    background-color: transparent;
  }
  .field-hero::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline: calc(50% - 50vw);
    z-index: -1;
    background-color: var(--color-bg);
  }

  .photo-hero { gap: 0; overflow: hidden; }
  .photo-hero .text { align-content: center; padding: var(--space-xl) var(--page-margin) var(--space-2xl); position: relative; z-index: 1; }
  .photo-hero .media { aspect-ratio: 16 / 9; overflow: hidden; }
  .photo-hero .media :global(picture) { display: block; block-size: 100%; }
  .photo-hero .media :global(img) { block-size: 100%; aspect-ratio: auto; object-position: 85% 30%; }

  @media (min-width: 64em) {
    .photo-hero { grid-template-areas: 'stack'; min-block-size: min(calc(100svh - var(--header-height)), 46rem); }
    .photo-hero .media, .photo-hero .text { grid-area: stack; }
    .photo-hero .media { aspect-ratio: auto; position: relative; }
    .photo-hero .media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, var(--scrim-strong) 0%, color-mix(in srgb, var(--navy-600) 70%, transparent) 38%, transparent 62%); }
    .photo-hero .text { padding-inline: max(var(--page-margin), calc((100vw - var(--page-max)) / 2)) var(--space-l); padding-block: var(--space-2xl); max-inline-size: calc(max(var(--page-margin), (100vw - var(--page-max)) / 2) + 40rem); }
    .page-hero.photo-hero :global(h1) { font-size: min(var(--step-display), 3.5rem); max-inline-size: 18ch; }
    .page-hero :global(h1) { font-size: min(var(--step-display), 5vw); }
    .favor-media :global(h1) { font-size: min(var(--step-display), 4vw); }
    .field-hero:not(.with-media) .text { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: end; }
    .field-hero:not(.with-media) .text > :global(*) { grid-column: 1 / span 8; }
    .field-hero :global(h1) { font-size: min(var(--step-head), 3.5rem); max-inline-size: 24ch; }
    .field-hero:not(.with-media) .text > p { grid-column: 9 / -1; grid-row: 2; }
    .page-hero.with-media { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start; }
    .favor-text .text { grid-column: 1 / span 7; }
    .favor-text .media { grid-column: 8 / -1; }
    .favor-text .media :global(img) { aspect-ratio: 4 / 5; }
    .favor-media { align-items: end; }
    .favor-media .text { grid-column: 1 / span 5; }
    .favor-media .media { grid-column: 6 / -1; }
    .favor-media .media :global(img) { aspect-ratio: 16 / 10; }
  }
</style>
