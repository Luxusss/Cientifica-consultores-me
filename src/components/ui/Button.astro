---
import type { HTMLAttributes } from 'astro/types';

type Props = (HTMLAttributes<'a'> & { href: string }) | (HTMLAttributes<'button'> & { href?: undefined });

const { href, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag class:list={['button', className]} href={href} {...rest}>
  <slot />
</Tag>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    min-block-size: var(--button-height);
    min-inline-size: var(--hit-min);
    padding-inline: var(--button-padding-inline);
    background-color: var(--button-bg);
    color: var(--button-text);
    border-radius: var(--radius);
    font-size: var(--step-body);
    font-weight: var(--weight-semibold);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    user-select: none;
    -webkit-user-select: none;
    transition:
      background-color var(--duration-hover) ease,
      transform var(--duration-press) var(--ease-out);
  }

  .button:active { transform: scale(0.97); background-color: var(--button-bg-hover); }

  .button:disabled,
  .button[aria-disabled='true'] {
    cursor: not-allowed;
    opacity: 0.55;
    transform: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .button:hover { background-color: var(--button-bg-hover); }
  }
</style>
