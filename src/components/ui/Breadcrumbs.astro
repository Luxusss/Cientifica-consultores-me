---
import type { NavLink } from '@/config/navigation';

interface Props {
  current?: string;
  trail?: NavLink[];
}

const { current, trail = [] } = Astro.props;
const links: NavLink[] = [{ label: 'Inicio', href: '/' }, ...trail];
---

<nav class="crumbs" aria-label="Migas de pan">
  {links.map((link, i) => (
    <>
      {i > 0 && <span aria-hidden="true">/</span>}
      <a href={link.href}>{link.label}</a>
    </>
  ))}
  {current && (
    <>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{current}</span>
    </>
  )}
</nav>

<style>
  .crumbs { display: flex; flex-wrap: wrap; gap: var(--space-2xs); font-size: var(--step-small); color: var(--color-text-soft); }
  .crumbs a { color: var(--color-text-soft); }
</style>
