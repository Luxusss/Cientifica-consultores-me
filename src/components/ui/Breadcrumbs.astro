---
import type { NavLink } from '@/config/navigation';

interface Props {
  current?: string;
  trail?: NavLink[];
}

const { current, trail = [] } = Astro.props;
const links: NavLink[] = [{ label: 'Inicio', href: '/' }, ...trail];
---

<div class="crumb-bar">
  <nav class="page crumbs" aria-label="Migas de pan">
    <ol role="list">
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a><span class="sep" aria-hidden="true">›</span></li>
      ))}
      {current && <li><span aria-current="page">{current}</span></li>}
    </ol>
  </nav>
</div>

<style>
  .crumb-bar { border-block-end: 1px solid color-mix(in srgb, var(--ink-900) 8%, transparent); background-color: var(--paper-0); }
  .crumbs { padding-block: var(--space-2xs); }
  ol { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2xs); font-size: var(--step-small); }
  li { display: inline-flex; align-items: center; gap: var(--space-2xs); }
  a { display: inline-flex; align-items: center; min-block-size: 2.75rem; color: var(--ink-600); text-decoration: none; }
  [aria-current='page'] { display: inline-flex; align-items: center; min-block-size: 2.75rem; }
  .sep { color: var(--ink-600); }
  [aria-current='page'] { color: var(--navy-600); font-weight: var(--weight-semibold); }

  @media (hover: hover) and (pointer: fine) {
    a:hover { color: var(--navy-600); }
  }
</style>
