---
/** Medios de pago en una sola fila compacta (barra inferior del pie de página), con los logos oficiales. */
import { Image } from 'astro:assets';
import { siAmericanexpress, siDinersclub, siMastercard, siPaypal, siVisa, siWesternunion } from 'simple-icons';
import bcp from '@/assets/images/pagos/bcp.png';
import bbva from '@/assets/images/pagos/bbva.png';
import interbank from '@/assets/images/pagos/interbank.png';
import scotiabank from '@/assets/images/pagos/scotiabank.png';
import nacion from '@/assets/images/pagos/banco-de-la-nacion.gif';
import yape from '@/assets/images/pagos/yape.png';

const icons = [
  { name: 'Visa', path: siVisa.path, color: '#1A1F71' },
  { name: 'Mastercard', path: siMastercard.path, color: '#EB001B' },
  { name: 'American Express', path: siAmericanexpress.path, color: '#2E77BC' },
  { name: 'Diners Club', path: siDinersclub.path, color: '#004C97' },
];
const logos = [
  { name: 'Yape', src: yape, square: true },
  { name: 'BCP', src: bcp },
  { name: 'BBVA', src: bbva },
  { name: 'Interbank', src: interbank },
  { name: 'Scotiabank', src: scotiabank },
  { name: 'Banco de la Nación', src: nacion },
];
const intl = [
  { name: 'PayPal', path: siPaypal.path, color: '#003087' },
  { name: 'Western Union', path: siWesternunion.path, color: '#000000' },
];
---

<div class="pay" aria-label="Medios de pago">
  <span class="pay-label">Medios de pago</span>
  <ul class="pay-list" role="list">
    {icons.map((c) => <li class="chip" title={c.name}><svg viewBox="0 0 24 24" role="img" aria-label={c.name}><path d={c.path} fill={c.color} /></svg></li>)}
    {logos.map((l) => <li class:list={['chip', { sq: l.square }]} title={l.name}><Image src={l.src} alt={l.name} height={48} class="logo" /></li>)}
    <li class="chip plin" title="Plin">plin</li>
    {intl.map((c) => <li class="chip" title={c.name}><svg viewBox="0 0 24 24" role="img" aria-label={c.name}><path d={c.path} fill={c.color} /></svg></li>)}
  </ul>
</div>

<style>
  .pay { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
  .pay-label { color: var(--navy-100); font-size: var(--step-small); font-weight: var(--weight-semibold); }
  .pay-list { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .chip { display: grid; place-items: center; block-size: 1.75rem; min-inline-size: 2.6rem; padding-inline: 0.4rem; border-radius: 0.4rem; background-color: #fff; }
  .chip svg { inline-size: 1.15rem; block-size: 1.15rem; }
  .chip :global(.logo) { display: block; inline-size: auto; block-size: 0.95rem; max-inline-size: 4.5rem; object-fit: contain; }
  .chip.sq { min-inline-size: 1.75rem; padding: 0; overflow: hidden; }
  .chip.sq { background-color: #742284; }
  .chip.sq :global(.logo) { block-size: 100%; inline-size: 100%; max-inline-size: none; object-fit: cover; transform: scale(1.35); }
  .plin { background-image: linear-gradient(135deg, #00d1c1, #2b5fd9); color: #fff; font-size: 0.78rem; font-weight: 800; }
</style>
