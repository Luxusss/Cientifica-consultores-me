---
import { Image } from 'astro:assets';
import { fullAddress, site, whatsappUrl } from '@/config/site';
import { legalNav, mainNav, services } from '@/config/navigation';
import Icon from '@/components/ui/Icon.astro';
import Payments from './Payments.astro';
import logo from '@/assets/brand/logo-white.png';

const year = new Date().getFullYear();
const mapQuery = encodeURIComponent(`${site.address.street}, ${site.address.district}, ${site.address.city}, Perú`);
const mapEmbed = `https://www.google.com/maps?q=${mapQuery}&z=16&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
---

<footer class="footer">
  <div class="page">
    <div class="top">
      <div class="brand">
        <Image src={logo} alt={site.name} height={56} class="logo" />
        <p class="about">Asesoría de tesis online con especialistas en investigación para estudiantes de Latinoamérica y España.</p>
        <p class="mini"><a href={`mailto:${site.email}`}><Icon name="mail" size="0.95rem" />{site.email}</a><a href={whatsappUrl()} target="_blank" rel="noopener"><Icon name="phone" size="0.95rem" />{site.phone.display}</a></p>
        <a class="wa" href={whatsappUrl()} target="_blank" rel="noopener"><Icon name="whatsapp" size="1.1rem" /> Escríbenos por WhatsApp</a>
        <ul class="social" role="list" aria-label="Redes sociales">
          {site.social.map((r) => (
            <li><a class={`s-${r.icon}`} href={r.href} target="_blank" rel="noopener" aria-label={`${r.name} de ${site.name}`} title={r.name}><Icon name={r.icon} size="1.05rem" /></a></li>
          ))}
        </ul>
      </div>

      <nav class="col" aria-label="Servicios">
        <p class="links-title">Servicios</p>
        <ul role="list">{services.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <nav class="col" aria-label="Empresa">
        <p class="links-title">Empresa</p>
        <ul role="list">{mainNav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <nav class="col" aria-label="Legal">
        <p class="links-title">Legal</p>
        <ul role="list">{legalNav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>

<address class="col contact">
        <p class="links-title">Visítanos</p>
        <div class="map">
          <iframe src={mapEmbed} title={`Mapa: ${fullAddress}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          <a class="directions" href={mapLink} target="_blank" rel="noopener"><Icon name="map" size="0.9rem" /> Cómo llegar</a>
        </div>
        <span class="row"><Icon name="map" size="0.95rem" />{site.address.street}, {site.address.district}, Lima</span>
        <span class="row"><Icon name="clock" size="0.95rem" /><span>{site.hours.map((h) => <span class="hour">{h.days}: {h.label}</span>)}</span></span>
      </address>
    </div>

    <div class="pay-bar"><Payments /></div>

    <div class="legal">
      <p>© {year} {site.legalName} · RUC {site.ruc}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: var(--space-l) calc(var(--space-m) + var(--button-height) + env(safe-area-inset-bottom, 0px));
    background-image: linear-gradient(180deg, #0f1650, var(--navy-700));
    color: var(--paper-0);
    font-size: var(--step-ui);
  }
  .footer::before { content: ''; position: absolute; inset: 0 0 auto; block-size: 4px; background-image: linear-gradient(90deg, var(--orange-500), var(--gold-400), var(--sky-500)); }

  /* Todo en una sola fila de columnas: marca, enlaces y datos de visita (el mapa va compacto en su columna) */
  .top { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: var(--space-l) var(--gutter); }
  .brand { grid-column: 1 / -1; display: grid; gap: var(--space-s); justify-items: start; align-content: start; }
  .logo { block-size: 3rem; inline-size: auto; }
  .about { color: var(--navy-100); max-inline-size: 36ch; font-size: var(--step-small); }
  .wa { display: inline-flex; align-items: center; gap: 0.5em; padding: 0.55em 1.05em; border-radius: var(--radius-pill); background-color: var(--whatsapp-500); color: var(--ink-900); font-weight: var(--weight-bold); }

  .social { display: flex; flex-wrap: wrap; gap: var(--space-2xs); }
  .social a { display: grid; place-items: center; inline-size: 2.4rem; block-size: 2.4rem; border-radius: 50%; background-color: transparent; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18); transition: background-color var(--duration-hover) ease, box-shadow var(--duration-hover) ease, transform var(--duration-hover) var(--ease-out); }
  /* Colores de cada red, aclarados lo justo para contrastar con el azul oscuro del footer */
  .s-facebook { color: #4b9bff; }
  .s-instagram { color: #ff5a8c; }
  .s-tiktok { color: #fff; }
  .s-tiktok :global(svg) { filter: drop-shadow(1.2px 1.2px 0 #fe2c55) drop-shadow(-1.2px -1.2px 0 #25f4ee); }
  .s-youtube { color: #ff4040; }
  .s-linkedin { color: #4ba3f0; }

  .links-title { margin-block-end: var(--space-xs); color: var(--gold-400); font-size: var(--step-small); font-weight: var(--weight-bold); letter-spacing: 0.08em; text-transform: uppercase; }
  .col ul { display: grid; gap: var(--space-2xs); }
  .col a { color: var(--navy-100); font-weight: var(--weight-regular); line-height: var(--leading-small); transition: color var(--duration-hover) ease, padding var(--duration-hover) var(--ease-out); }

  .contact { grid-column: 1 / -1; display: grid; gap: var(--space-xs); align-content: start; font-style: normal; font-size: var(--step-small); }
  .row { display: flex; align-items: flex-start; gap: 0.55em; color: var(--navy-100); line-height: var(--leading-small); overflow-wrap: anywhere; }
  .row :global(svg) { flex-shrink: 0; margin-block-start: 0.1em; color: var(--gold-400); }
  .mini { display: grid; gap: 0.3rem; font-size: var(--step-small); }
  .mini a { display: inline-flex; align-items: center; gap: 0.5em; color: var(--paper-0); }
  .mini :global(svg) { color: var(--gold-400); }
  /* Mapa compacto dentro de su columna: se ve en todas las páginas sin agrandar el pie */
  .map { position: relative; block-size: 9.5rem; overflow: hidden; border-radius: var(--radius-card); background-color: var(--navy-600); box-shadow: 0 0 0 1px rgb(255 255 255 / 0.14); }
  .map iframe { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; border: 0; }
  .directions { position: absolute; inset-block-end: 0.5rem; inset-inline-end: 0.5rem; display: inline-flex; align-items: center; gap: 0.35em; padding: 0.4em 0.85em; border-radius: var(--radius-pill); background-image: var(--gradient-warm); color: var(--paper-0); font-size: 0.78rem; font-weight: var(--weight-bold); box-shadow: 0 8px 16px -8px rgb(0 0 0 / 0.5); }
  .hour { display: block; }

  /* Franja propia de medios de pago */
  .pay-bar { display: flex; justify-content: center; margin-block-start: var(--space-l); padding: 0.75rem var(--space-m); border-radius: var(--radius-card); background-color: rgb(255 255 255 / 0.05); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1); }

  .legal { display: flex; justify-content: center; padding-block-start: var(--space-s); color: var(--navy-100); font-size: var(--step-small); text-align: center; }
  .legal p { max-inline-size: none; }

  @media (min-width: 64em) {
    .top { grid-template-columns: minmax(0, 3fr) minmax(0, 2.3fr) minmax(0, 1.3fr) minmax(0, 1.9fr) minmax(0, 3.4fr); }
    .brand, .contact { grid-column: auto; }
    .pay-bar { border-radius: var(--radius-pill); }
  }
  @media (hover: hover) and (pointer: fine) {
    .col a:hover { color: var(--paper-0); padding-inline-start: 0.3em; }
    .mini a:hover { color: var(--gold-400); }
    .directions:hover { color: var(--paper-0); filter: brightness(1.05); }
    .social a:hover { background-color: rgb(254 143 1 / 0.14); box-shadow: inset 0 0 0 2px var(--orange-500), 0 8px 18px -8px rgb(254 143 1 / 0.6); transform: translateY(-2px); }
    .wa:hover { background-color: var(--whatsapp-600); color: var(--ink-900); }
  }
</style>
