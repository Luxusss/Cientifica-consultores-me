---
import { Image } from 'astro:assets';
import { fullAddress, site, whatsappUrl } from '@/config/site';
import { legalNav, mainNav, services } from '@/config/navigation';
import Icon from '@/components/ui/Icon.astro';
import logo from '@/assets/brand/logo-white.png';

const year = new Date().getFullYear();
const mapQuery = encodeURIComponent(`${site.address.street}, ${site.address.district}, ${site.address.city}, Perú`);
const mapEmbed = `https://www.google.com/maps?q=${mapQuery}&z=16&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
---

<footer class="footer">
  <div class="page">
    <div class="top">
      <div class="brand">
        <Image src={logo} alt={site.name} height={56} class="logo" />
        <p class="about">Asesoría de tesis online con especialistas en investigación para estudiantes de Latinoamérica y España.</p>
        <a class="wa" href={whatsappUrl()} target="_blank" rel="noopener"><Icon name="whatsapp" size="1.1rem" /> Escríbenos por WhatsApp</a>
        <ul class="social" role="list" aria-label="Redes sociales">
          {site.social.map((r) => (
            <li><a class={`s-${r.icon}`} href={r.href} target="_blank" rel="noopener" aria-label={`${r.name} de ${site.name}`} title={r.name}><Icon name={r.icon} size="1.05rem" /></a></li>
          ))}
        </ul>
      </div>

      <nav class="links" aria-label="Pie de página">
        <div>
          <p class="links-title">Servicios</p>
          <ul role="list">{services.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
        <div>
          <p class="links-title">Empresa</p>
          <ul role="list">{mainNav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
        <div>
          <p class="links-title">Legal</p>
          <ul role="list">{legalNav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
      </nav>
    </div>

    <div class="visit">
      <address class="contact">
        <p class="links-title">Visítanos</p>
        <a class="row" href={whatsappUrl()} target="_blank" rel="noopener"><span class="ico"><Icon name="phone" size="1rem" /></span>{site.phone.display}</a>
        <a class="row" href={`mailto:${site.email}`}><span class="ico"><Icon name="mail" size="1rem" /></span>{site.email}</a>
        <span class="row"><span class="ico"><Icon name="map" size="1rem" /></span><span>{fullAddress}<small>{site.address.reference}</small></span></span>
        <span class="row"><span class="ico"><Icon name="clock" size="1rem" /></span><span>{site.hours.map((h) => <span class="hour">{h.days}: {h.label}</span>)}</span></span>
      </address>

      <div class="map">
        <iframe src={mapEmbed} title={`Mapa: ${fullAddress}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        <a class="directions" href={mapLink} target="_blank" rel="noopener"><Icon name="map" size="1rem" /> Cómo llegar</a>
      </div>
    </div>

    <div class="legal">
      <p>© {year} {site.legalName} · RUC {site.ruc}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: var(--space-xl) calc(var(--space-l) + var(--button-height) + env(safe-area-inset-bottom, 0px));
    background-image: radial-gradient(40rem 24rem at 100% 0%, rgb(31 122 224 / 0.22), transparent 70%), radial-gradient(36rem 20rem at 0% 100%, rgb(254 143 1 / 0.12), transparent 70%), linear-gradient(180deg, #0f1650, var(--navy-700));
    color: var(--paper-0);
    font-size: var(--step-ui);
  }
  .footer::before { content: ''; position: absolute; inset: 0 0 auto; block-size: 4px; background-image: linear-gradient(90deg, var(--orange-500), var(--gold-400), var(--sky-500)); }

  .top { display: grid; gap: var(--space-l) var(--gutter); padding-block-end: var(--space-l); border-block-end: 1px solid rgb(255 255 255 / 0.1); }
  .brand { display: grid; gap: var(--space-s); justify-items: start; align-content: start; }
  .logo { block-size: 3.25rem; inline-size: auto; }
  .about { color: var(--navy-100); max-inline-size: 38ch; }
  .wa { display: inline-flex; align-items: center; gap: 0.5em; padding: 0.6em 1.1em; border-radius: var(--radius-pill); background-color: var(--whatsapp-500); color: var(--ink-900); font-weight: var(--weight-bold); }

  .social { display: flex; flex-wrap: wrap; gap: var(--space-2xs); margin-block-start: var(--space-3xs); }
  .social a { display: grid; place-items: center; inline-size: 2.6rem; block-size: 2.6rem; border-radius: 50%; background-color: transparent; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18); transition: background-color var(--duration-hover) ease, box-shadow var(--duration-hover) ease, transform var(--duration-hover) var(--ease-out); }
  /* Colores de cada red, aclarados lo justo para contrastar con el azul oscuro del footer */
  .s-facebook { color: #4b9bff; }
  .s-instagram { color: #ff5a8c; }
  .s-tiktok { color: #fff; }
  .s-tiktok :global(svg) { filter: drop-shadow(1.2px 1.2px 0 #fe2c55) drop-shadow(-1.2px -1.2px 0 #25f4ee); }
  .s-youtube { color: #ff4040; }
  .s-linkedin { color: #4ba3f0; }
  .links { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: var(--space-l) var(--gutter); }
  .links-title { margin-block-end: var(--space-xs); color: var(--gold-400); font-size: var(--step-small); font-weight: var(--weight-bold); letter-spacing: 0.08em; text-transform: uppercase; }
  .links ul { display: grid; gap: var(--space-2xs); }
  .links a { color: var(--navy-100); font-weight: var(--weight-regular); line-height: var(--leading-small); transition: color var(--duration-hover) ease, padding var(--duration-hover) var(--ease-out); }

  .visit { display: grid; gap: var(--space-l) var(--gutter); padding-block: var(--space-l); align-items: stretch; }
  .contact { display: grid; gap: var(--space-xs); align-content: start; font-style: normal; }
  .row { display: flex; align-items: flex-start; gap: 0.7em; color: var(--paper-0); font-weight: var(--weight-regular); overflow-wrap: anywhere; }
  .row small { display: block; color: var(--navy-100); font-size: var(--step-small); }
  .hour { display: block; }
  .ico { display: grid; place-items: center; flex-shrink: 0; inline-size: 2rem; block-size: 2rem; border-radius: 0.6rem; background-color: rgb(255 255 255 / 0.1); color: var(--gold-400); }

  .map { position: relative; min-block-size: 16rem; overflow: hidden; border-radius: var(--radius-card); background-color: var(--navy-600); box-shadow: 0 0 0 1px rgb(255 255 255 / 0.12), 0 30px 60px -30px rgb(0 0 0 / 0.7); }
  .map iframe { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; border: 0; filter: saturate(0.9); }
  .directions { position: absolute; inset-block-end: var(--space-s); inset-inline-end: var(--space-s); display: inline-flex; align-items: center; gap: 0.4em; padding: 0.55em 1em; border-radius: var(--radius-pill); background-image: var(--gradient-warm); color: var(--paper-0); font-size: var(--step-small); font-weight: var(--weight-bold); box-shadow: 0 10px 20px -8px rgb(0 0 0 / 0.5); }

  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-s); padding-block-start: var(--space-m); border-block-start: 1px solid rgb(255 255 255 / 0.1); color: var(--navy-100); font-size: var(--step-small); }
  .legal p { max-inline-size: none; }
  .legal a { color: var(--paper-0); }

  @media (min-width: 64em) {
    .top { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); }
    .visit { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); }
    .map { min-block-size: 18rem; }
  }
  @media (hover: hover) and (pointer: fine) {
    .links a:hover { color: var(--paper-0); padding-inline-start: 0.3em; }
    .row:is(a):hover { color: var(--gold-400); }
    .social a:hover { background-color: rgb(254 143 1 / 0.14); box-shadow: inset 0 0 0 2px var(--orange-500), 0 8px 18px -8px rgb(254 143 1 / 0.6); transform: translateY(-2px); }
    .wa:hover { background-color: var(--whatsapp-600); color: var(--ink-900); }
    .directions:hover { color: var(--paper-0); filter: brightness(1.05); }
  }
</style>
