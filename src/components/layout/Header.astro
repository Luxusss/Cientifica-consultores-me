---
import { Image } from 'astro:assets';
import logoSvg from '@/assets/brand/logo.svg?raw';
import peru from '@/assets/images/paises/peru.jpg';
import colombia from '@/assets/images/paises/colombia.jpg';
import mexico from '@/assets/images/paises/mexico.jpg';
import bolivia from '@/assets/images/paises/bolivia.jpg';
import ecuador from '@/assets/images/paises/ecuador.jpg';
import venezuela from '@/assets/images/paises/venezuela.jpg';
import chile from '@/assets/images/paises/chile.jpg';
import espana from '@/assets/images/paises/espana.jpg';
import FormButton from '@/components/ui/FormButton.astro';
import Icon from '@/components/ui/Icon.astro';
import { mainNav, services } from '@/config/navigation';
import { services as serviceData } from '@/data/services';

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const current = Astro.url.pathname;
const flags = [
  { src: peru, name: 'Perú' },
  { src: colombia, name: 'Colombia' },
  { src: mexico, name: 'México' },
  { src: bolivia, name: 'Bolivia' },
  { src: ecuador, name: 'Ecuador' },
  { src: venezuela, name: 'Venezuela' },
  { src: chile, name: 'Chile' },
  { src: espana, name: 'España' },
];
const isCurrent = (href: string) => current === href || (href === '/index.html' && current === '/');
const serviceIcon: Record<string, 'user' | 'badge' | 'institution' | 'document' | 'pen'> = { pregrado: 'user', maestria: 'badge', doctorado: 'institution', tsp: 'document', articulos: 'pen' };
---

<header class:list={['header', 'theme-field', { overlay }]} data-header>
  <div class="edge-frame bar">
    <a class="brand" href="/">
      <Fragment set:html={logoSvg} />
    </a>

    <nav class="nav" aria-label="Principal">
      <ul role="list">
        <li><a class="nav-link" href="/" aria-current={current === '/' || current === '/index.html' ? 'page' : undefined}>Inicio</a></li>
        <li data-services-hover>
          <button class="nav-link services-toggle" type="button" popovertarget="menu-servicios" aria-haspopup="true" aria-expanded="false" data-services-toggle>
            Servicios
            <svg class="chev" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </li>
        {mainNav.map((item) => (
          <li>
            <a class="nav-link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <ul class="flags" role="list" aria-label="Países donde atendemos">
      {flags.map((f) => (
        <li><Image src={f.src} alt={f.name} title={f.name} width={26} height={18} class="flag" /></li>
      ))}
    </ul>

    <button class="menu-toggle" type="button" popovertarget="menu-movil" aria-label="Abrir menú">Menú</button>
  </div>

  <div id="menu-servicios" class="panel" popover data-services-panel>
    <div class="panel-grid">
      <div class="panel-list">
        <p class="panel-kicker">Asesoría por grado</p>
        <ul class="services" role="list">
          {serviceData.filter((d) => d.id !== 'proyecto').map((d) => (
            <li>
              <a class="service" href={d.href} aria-current={isCurrent(d.href) ? 'page' : undefined}>
                <span class="service-thumb other-icon" aria-hidden="true"><Icon name={serviceIcon[d.id] ?? 'document'} size="1.25rem" /></span>
                <span class="service-text">
                  <span class="service-name">{d.navLabel}</span>
                  <span class="service-desc">{d.summary}</span>
                </span>
              </a>
            </li>
          ))}
          <li>
            <a class="service service-other" href="/otros_servicios.html" aria-current={isCurrent('/otros_servicios.html') ? 'page' : undefined}>
              <span class="service-thumb other-icon" aria-hidden="true"><Icon name="list" size="1.25rem" /></span>
              <span class="service-text">
                <span class="service-name">Otros servicios</span>
                <span class="service-desc">Revisiones, proyectos, análisis de datos y corrección de estilo.</span>
              </span>
            </a>
          </li>
        </ul>
      </div>
      <aside class="panel-promo">
        <span class="promo-kicker">Primera asesoría gratis</span>
        <p class="promo-title">¿No sabes cuál elegir?</p>
        <p class="promo-text">Cuéntanos tu caso y te recomendamos el servicio y el asesor ideal para tu carrera.</p>
        <a class="promo-cta" href="/contactanos.html#formulario">Pedir asesoría gratis <span class="promo-arrow" aria-hidden="true">→</span></a>
      </aside>
    </div>
  </div>

  <div id="menu-movil" class="drawer" popover>
    <div class="drawer-inner">
      <button class="menu-close" type="button" popovertarget="menu-movil" popovertargetaction="hide">Cerrar</button>
      <nav aria-label="Menú del celular">
        <p class="drawer-label">Servicios</p>
        <ul role="list">
          {services.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
        </ul>
        <ul role="list" class="drawer-main">
          <li><a href="/">Inicio</a></li>
          {mainNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
      <FormButton class="drawer-cta" />
    </div>
  </div>
</header>

<script>
  const hoverZone = document.querySelector<HTMLElement>('[data-services-hover]');
  const panel = document.querySelector<HTMLElement>('[data-services-panel]');
  const toggle = document.querySelector<HTMLElement>('[data-services-toggle]');
  if (hoverZone && panel && toggle && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let timer = 0;
    const open = () => { clearTimeout(timer); if (!panel.matches(':popover-open')) panel.showPopover(); };
    const close = () => { clearTimeout(timer); timer = window.setTimeout(() => { if (panel.matches(':popover-open')) panel.hidePopover(); }, 220); };
    hoverZone.addEventListener('pointerenter', open);
    hoverZone.addEventListener('pointerleave', close);
    panel.addEventListener('pointerenter', open);
    panel.addEventListener('pointerleave', close);
  }
  panel?.addEventListener('toggle', (e) => toggle?.setAttribute('aria-expanded', String((e as ToggleEvent).newState === 'open')));

  const header = document.querySelector<HTMLElement>('[data-header].overlay');
  if (header) {
    const update = () => header.classList.toggle('is-solid', window.scrollY > 24);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
    background-color: var(--color-bg);
    padding-block-start: env(safe-area-inset-top, 0px);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-l);
    min-block-size: var(--header-height);
  }

  .brand { display: block; flex-shrink: 0; }

  @media (min-width: 64em) {
    .overlay { margin-block-end: calc(-1 * var(--header-height)); background-color: transparent; transition: background-color var(--duration-ui) var(--ease-out); }
    .overlay.is-solid { background-color: var(--color-bg); }
  }
  .brand :global(svg) { display: block; inline-size: clamp(8.5rem, 7rem + 4vw, 10.5rem); block-size: auto; color: var(--paper-0); }

  .nav { margin-inline-start: auto; }
  .flags { display: flex; gap: 0.375rem; align-items: center; }
  .flag { inline-size: 1.625rem; block-size: 1.125rem; object-fit: cover; border-radius: 3px; box-shadow: 0 0 0 1px color-mix(in srgb, var(--paper-0) 25%, transparent); }
  .nav ul { display: flex; gap: var(--space-3xs); }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--hit-min);
    color: var(--color-text);
    font-size: var(--step-ui);
    font-weight: var(--weight-medium);
    text-decoration: none;
    border-radius: var(--radius-pill);
    padding-inline: var(--space-s);
    transition: background-color var(--duration-hover) ease, color var(--duration-hover) ease;
  }
  .nav-link[aria-current='page'] { color: var(--orange-500); }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover { background-color: color-mix(in srgb, var(--paper-0) 12%, transparent); }
  }

  .services-toggle { anchor-name: --servicios; }
  .nav-link:focus-visible { outline: 2px solid var(--orange-500); outline-offset: 2px; }
  .header:has(.panel:popover-open) .services-toggle { background-color: color-mix(in srgb, var(--paper-0) 14%, transparent); }
  .chev { margin-inline-start: 0.3em; transition: transform var(--duration-ui) var(--ease-out); }
  .header:has(.panel:popover-open) .chev { transform: rotate(180deg); }
  .panel {
    position-anchor: --servicios;
    inset: auto;
    inset-block-start: calc(anchor(bottom) + 0.6rem);
    inset-inline-start: anchor(center);
    translate: -50% 0;
    inline-size: min(58rem, calc(100vw - 2rem));
    margin: 0;
    padding: var(--space-s);
    border: 0;
    border-radius: calc(var(--radius-card) + 0.25rem);
    background-color: var(--paper-0);
    color: var(--ink-900);
    box-shadow: 0 30px 70px -20px color-mix(in srgb, var(--ink-900) 50%, transparent), 0 0 0 1px rgb(0 0 0 / 0.04);
    overflow: visible;
  }
  .panel::before { content: ''; position: absolute; inset: -0.8rem 0 auto; block-size: 0.8rem; }
  @supports not (anchor-name: --a) {
    .panel { inset-block-start: calc(var(--header-height) + 0.5rem); inset-inline-start: 50%; }
  }
  .panel-grid { display: grid; grid-template-columns: minmax(0, 1fr) 15rem; gap: var(--space-s); }
  .panel-list { display: grid; gap: var(--space-2xs); align-content: start; padding: var(--space-2xs); }
  .panel-kicker { padding-inline: var(--space-2xs); color: var(--orange-600); font-size: var(--step-small); font-weight: var(--weight-bold); letter-spacing: 0.08em; text-transform: uppercase; }
  .services { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3xs) var(--space-2xs); }
  .service { display: flex; align-items: center; gap: var(--space-xs); padding: var(--space-2xs); border-radius: 0.9rem; color: var(--ink-900); text-decoration: none; transition: background-color var(--duration-hover) ease; }
  .service-thumb { flex-shrink: 0; inline-size: 3rem; block-size: 3rem; border-radius: 0.8rem; object-fit: cover; object-position: 50% 20%; background-color: var(--navy-50); }
  .other-icon { display: grid; place-items: center; background-image: var(--gradient-warm); color: var(--paper-0); }
  .service-text { display: grid; gap: 0.1rem; min-inline-size: 0; }
  .service-name { font-size: var(--step-ui); font-weight: var(--weight-semibold); line-height: 1.25; transition: color var(--duration-hover) ease; }
  .service-desc { font-size: var(--step-small); line-height: 1.35; color: var(--ink-600); }
  .service[aria-current='page'] { background-color: var(--orange-50); }
  .service[aria-current='page'] .service-name { color: var(--orange-600); }

  .panel-promo { position: relative; display: grid; align-content: end; gap: var(--space-2xs); padding: var(--space-m); overflow: hidden; border-radius: var(--radius-card); background-image: var(--gradient-brand); color: var(--paper-0); }
  .promo-kicker { inline-size: fit-content; padding: 0.25em 0.7em; border-radius: var(--radius-pill); background-color: rgb(255 255 255 / 0.14); color: var(--gold-400); font-size: var(--step-small); font-weight: var(--weight-bold); }
  .promo-title { font-family: var(--font-display); font-size: var(--step-title); font-weight: var(--weight-semibold); line-height: 1.2; }
  .promo-text { color: var(--navy-100); font-size: var(--step-small); line-height: 1.45; }
  .promo-cta { display: flex; align-items: center; justify-content: center; gap: 0.5em; inline-size: 100%; min-block-size: 2.75rem; white-space: nowrap; margin-block-start: var(--space-xs); padding: 0.6em 1.1em; box-shadow: 0 10px 22px -10px rgb(254 143 1 / 0.8); border-radius: var(--radius-pill); background-color: var(--orange-500); color: var(--ink-900); font-size: var(--step-small); font-weight: var(--weight-bold); text-decoration: none; transition: transform var(--duration-hover) var(--ease-out); }
  .promo-arrow { transition: transform var(--duration-hover) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .service:hover { background-color: var(--paper-1); }
    .service:hover .service-name { color: var(--navy-600); }
    .promo-cta:hover { transform: translateY(-2px); color: var(--ink-900); }
    .promo-cta:hover .promo-arrow { transform: translateX(3px); }
  }

  .menu-toggle, .menu-close {
    min-block-size: var(--hit-min);
    padding-inline: var(--space-s);
    background-color: var(--color-field);
    color: var(--color-on-field);
    font-weight: var(--weight-semibold);
    user-select: none;
    -webkit-user-select: none;
  }
  .menu-toggle { display: none; margin-inline-start: auto; }

  .drawer {
    inset: 0;
    inline-size: 100%;
    block-size: 100dvh;
    max-inline-size: none;
    max-block-size: none;
    margin: 0;
    padding: 0;
    border: 0;
    background-color: var(--color-field);
    color: var(--color-on-field);
    overscroll-behavior: contain;
  }
  .drawer-inner {
    display: grid;
    align-content: start;
    gap: var(--space-l);
    padding: calc(var(--space-s) + env(safe-area-inset-top, 0px)) var(--page-margin) calc(var(--space-l) + env(safe-area-inset-bottom, 0px));
  }
  .menu-close { justify-self: end; background-color: var(--navy-700); }
  .drawer-label { color: var(--color-on-field-soft); font-size: var(--step-small); }
  .drawer ul { display: grid; gap: var(--space-3xs); }
  .drawer a {
    display: block;
    padding-block: var(--space-2xs);
    color: var(--color-on-field);
    font-size: var(--step-lead);
    text-decoration: none;
  }
  .drawer-main { margin-block-start: var(--space-m); }
  .drawer-main a { font-size: var(--step-head); line-height: var(--leading-head); }

  @media (prefers-reduced-motion: no-preference) {
    .panel, .drawer {
      transition:
        opacity var(--duration-ui) var(--ease-out),
        transform var(--duration-ui) var(--ease-out),
        overlay var(--duration-ui) allow-discrete,
        display var(--duration-ui) allow-discrete;
    }
    .panel:not(:popover-open), .drawer:not(:popover-open) { opacity: 0; transform: translateY(-8px); }
    .panel:popover-open, .drawer:popover-open { opacity: 1; transform: none; }
    @starting-style {
      .panel:popover-open, .drawer:popover-open { opacity: 0; transform: translateY(-8px); }
    }
  }

  @media (max-width: 63.99em) {
    .nav, .flags { display: none; }
    .menu-toggle { display: inline-flex; align-items: center; }
  }
</style>
