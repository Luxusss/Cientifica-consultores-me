---
import { Image } from 'astro:assets';
import type { Block } from '@/data/servicePages';

interface Props {
  block: Block;
  eyebrow?: string;
  band?: boolean;
  /** @deprecated se mantiene por compatibilidad */
  surface?: boolean;
}

const { block, eyebrow, band = false } = Astro.props;
const introOnly = block.points.length === 0;
const pictured = block.points.some((p) => p.image);
const count = block.points.length;
const overlay = block.variant === 'overlay' && pictured;
---

<section class:list={['section-wide', { 'band-soft': band }]} aria-labelledby={block.id}>
  <div class="page stack stack-xl">
    <header class="section-head center" data-reveal>
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2 id={block.id}>{block.title}</h2>
      {block.intro && !introOnly && <p>{block.intro}</p>}
      {introOnly && block.intro && <p>{block.intro}</p>}
    </header>

    {!introOnly && (
      <ul class:list={['cards', `n-${count}`, { plain: !pictured, overlay }]} role="list" data-reveal="stagger">
        {block.points.map((p, i) => (
          <li id={p.id} class:list={['card', i % 2 ? 'tone-6' : 'tone-1']}>
            {p.image && (
              <div class="frame">
                <Image src={p.image} alt={p.imageAlt ?? ''} widths={[360, 540, 720]} sizes="(min-width: 64em) 30vw, (min-width: 40em) 45vw, 100vw" class="photo" />
              </div>
            )}
            <div class="body">
              <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {p.tag && <span class="tag">{p.tag}</span>}
              {p.title && <h3>{p.title}</h3>}
              <p>{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .cards { display: grid; gap: var(--space-m) var(--gutter); grid-template-columns: 1fr; }
  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border-radius: var(--radius-card);
    background-color: var(--paper-0);
    box-shadow: var(--shadow-card);
    transition: opacity var(--duration-reveal) var(--ease-expo), transform var(--duration-reveal) var(--ease-expo), translate var(--duration-ui) var(--ease-out), box-shadow var(--duration-ui) var(--ease-out);
  }
  .frame { overflow: hidden; background-color: var(--navy-50); }
  .frame :global(.photo) { display: block; inline-size: 100%; block-size: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: 50% 30%; transition: transform var(--duration-reveal) var(--ease-out); }
  .body { position: relative; display: grid; gap: var(--space-2xs); align-content: start; padding: var(--space-l) var(--space-m) var(--space-m); }
  .num { position: absolute; inset-block-start: -1.3rem; inset-inline-start: var(--space-m); display: grid; place-items: center; inline-size: 2.6rem; block-size: 2.6rem; border-radius: 0.85rem; background-image: var(--tone-grad); color: var(--paper-0); font-size: var(--step-small); font-weight: var(--weight-bold); box-shadow: 0 0 0 4px var(--paper-0), 0 10px 20px -10px rgb(0 0 0 / 0.4); }
  .plain .body { padding-block-start: var(--space-m); }
  .plain .num { position: static; box-shadow: none; margin-block-end: var(--space-2xs); }
  .card h3 { font-size: var(--step-title); line-height: 1.25; }
  .card p { color: var(--color-text-soft); font-size: var(--step-ui); line-height: var(--leading-body); }

  /* Variante con foto completa de fondo y texto encima */
  .tag { display: none; }
  .overlay .card { position: relative; grid-template-rows: none; min-block-size: 24rem; isolation: isolate; align-content: end; }
  .overlay .frame { position: absolute; inset: 0; z-index: -2; }
  .overlay .frame :global(.photo) { block-size: 100%; aspect-ratio: auto; }
  .overlay .card::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(20 31 102 / 0.05) 15%, rgb(20 31 102 / 0.72) 55%, rgb(15 22 80 / 0.96) 100%); transition: background var(--duration-ui) ease; }
  .overlay .body { align-self: end; padding: var(--space-m); color: var(--paper-0); }
  .overlay .num { position: static; margin-block-end: var(--space-2xs); box-shadow: 0 8px 18px -8px rgb(0 0 0 / 0.6); }
  .overlay .tag { display: inline-block; inline-size: fit-content; padding: 0.25em 0.7em; border-radius: var(--radius-pill); background-color: rgb(255 255 255 / 0.16); color: var(--gold-400); font-size: var(--step-small); font-weight: var(--weight-bold); backdrop-filter: blur(6px); }
  .overlay .card h3 { color: var(--paper-0); font-size: var(--step-title); }
  .overlay .card p { color: var(--navy-100); }

  @media (min-width: 40em) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64em) {
    .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .cards.n-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    /* Cinco tarjetas: 3 arriba y 2 más anchas abajo */
    .cards.n-5 { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .cards.n-5 > .card { grid-column: span 2; }
    .cards.n-5 > .card:nth-child(n + 4) { grid-column: span 3; }
    .cards.n-5 > .card:nth-child(n + 4) .frame :global(.photo) { aspect-ratio: 21 / 9; }
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover { translate: 0 -5px; box-shadow: var(--shadow-lift); }
    .card:hover .frame :global(.photo) { transform: scale(1.05); }
    .overlay .card:hover::after { background: linear-gradient(180deg, rgb(20 31 102 / 0.15) 0%, rgb(20 31 102 / 0.8) 45%, rgb(15 22 80 / 0.97) 100%); }
  }
</style>
