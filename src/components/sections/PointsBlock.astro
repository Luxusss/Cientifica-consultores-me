---
import type { Block } from '@/data/servicePages';

interface Props {
  block: Block;
  surface?: boolean;
}

const { block, surface = false } = Astro.props;
const titled = block.points.some((p) => p.title);
const introOnly = block.points.length === 0;
---

<section class:list={['points', { 'theme-surface': surface, 'intro-only': introOnly }]} aria-labelledby={block.id}>
  <div class="page grid">
    <header class="head">
      <h2 id={block.id}>{block.title}</h2>
      {block.intro && <p class="intro">{block.intro}</p>}
    </header>
    {block.points.length > 0 && (
      <ul class:list={['list', { titled }]} role="list">
        {block.points.map((p) => (
          <li id={p.id}>
            {p.title && <h3>{p.title}</h3>}
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .points { padding-block: calc(var(--section-gap) / 2); }
  .theme-surface { padding-block: var(--section-gap); }
  .head { grid-column: 1 / -1; display: grid; gap: var(--space-s); align-content: start; }
  .intro { font-size: var(--step-lead); line-height: var(--leading-lead); max-inline-size: 44ch; }

  .list { grid-column: 1 / -1; display: grid; gap: var(--space-s); margin-block-start: var(--space-l); }
  .list li { max-inline-size: none; font-size: var(--step-lead); line-height: var(--leading-lead); }
  .titled { gap: var(--space-l); }
  .titled li { font-size: var(--step-body); line-height: var(--leading-body); }
  .titled h3 { font-weight: var(--weight-semibold); margin-block-end: var(--space-3xs); }

  @media (min-width: 64em) {
    .head { grid-column: 1 / span var(--axis); }
    .list { grid-column: calc(var(--axis) + 1) / -1; margin-block-start: 0; }
    .titled { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--gutter); }
    .intro-only .head { grid-column: 1 / -1; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .intro-only h2 { grid-column: 1 / span var(--axis); }
    .intro-only .intro { grid-column: calc(var(--axis) + 1) / -1; }
  }
</style>
