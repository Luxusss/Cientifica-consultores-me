---
import type { Block } from '@/data/servicePages';

interface Props {
  block: Block;
  surface?: boolean;
}

const { block, surface = false } = Astro.props;
const titled = block.points.some((p) => p.title);
const introOnly = block.points.length === 0;
const wide = block.title.length > 40;
---

<section class:list={[surface ? 'theme-surface section-wide' : 'section']} aria-labelledby={block.id}>
  <div class:list={['page split', { 'split-wide': wide }]}>
    <header class="stack" data-reveal>
      <h2 id={block.id}>{block.title}</h2>
      {block.intro && !introOnly && <p class="text-lead">{block.intro}</p>}
    </header>
    {introOnly ? (
      <p class="text-lead" data-reveal>{block.intro}</p>
    ) : (
      <ul class:list={['list', { titled }]} role="list" data-reveal="stagger">
        {block.points.map((p) => (
          <li id={p.id}>
            {p.title && <h3>{p.title}</h3>}
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .list { display: grid; gap: var(--space-s); }
  .list li { font-size: var(--step-lead); line-height: var(--leading-lead); }
  .titled { gap: var(--space-l); }
  .titled li { font-size: var(--step-body); line-height: var(--leading-body); }
  .titled h3 { font-weight: var(--weight-semibold); margin-block-end: var(--space-3xs); }

  @media (min-width: 64em) {
    .titled { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--gutter); }
  }
</style>
