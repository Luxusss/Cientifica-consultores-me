---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  title: string;
  text: string[];
  eyebrow?: string;
  band?: boolean;
  /** Foto de fondo a todo el ancho, con velo azul */
  image?: ImageMetadata;
  /** @deprecated se mantiene por compatibilidad */
  surface?: boolean;
}

const { id, title, text, eyebrow, band = false, image } = Astro.props;
---

<section class:list={['section-wide', { 'band-soft': band && !image, photo: image }]} aria-labelledby={id}>
  {image && <Image src={image} alt="" widths={[960, 1440, 1920]} sizes="100vw" class="bg" />}
  <div class="page">
    <div class="box" data-reveal>
      <span class="mark" aria-hidden="true"></span>
      <header class="section-head">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h2 id={id}>{title}</h2>
      </header>
      <div class="copy">
        {text.map((t) => <p>{t}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  .photo { position: relative; isolation: isolate; overflow: hidden; }
  .photo { min-block-size: 28rem; display: grid; align-items: center; }
  .photo :global(.bg) { position: absolute; inset: 0; z-index: -2; inline-size: 100%; block-size: 100%; object-fit: cover; object-position: 60% 16%; }
  .photo::after { content: ''; position: absolute; inset: auto 0 0; z-index: -1; block-size: 26%; background: linear-gradient(0deg, rgb(15 22 80 / 1) 0%, rgb(15 22 80 / 0.9) 50%, transparent 100%); pointer-events: none; }
  .photo::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(20 31 102 / 0.95) 0%, rgb(20 31 102 / 0.85) 38%, rgb(29 45 140 / 0.35) 75%, rgb(29 45 140 / 0.2) 100%); }
  .photo .box { grid-template-columns: 1fr; max-inline-size: 36rem; background-color: transparent; box-shadow: none; padding-inline: 0; }
  .photo .mark { display: none; }
  .photo h2 { color: var(--paper-0); }
  .photo .eyebrow { background-color: rgb(255 255 255 / 0.14); color: var(--gold-400); }
  .photo .copy p { color: var(--navy-100); }
  .box {
    position: relative;
    display: grid;
    gap: var(--space-m) var(--gutter);
    padding: var(--space-l);
    overflow: hidden;
    border-radius: calc(var(--radius-card) + 0.35rem);
    background-color: var(--paper-0);
    box-shadow: var(--shadow-card);
  }
  .mark { position: absolute; inset: 0 auto 0 0; inline-size: 5px; background-image: var(--gradient-warm); }
  .section-head { max-inline-size: none; }
  .section-head h2 { max-inline-size: 26ch; }
  .copy { display: grid; gap: var(--space-s); }
  .copy p { color: var(--color-text-soft); font-size: var(--step-lead); line-height: var(--leading-lead); max-inline-size: 68ch; }

  @media (min-width: 64em) {
    .box { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; padding: var(--space-xl); }
  }
</style>
