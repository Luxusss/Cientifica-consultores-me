---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FormButton from '@/components/ui/FormButton.astro';

interface Props {
  id: string;
  title: string;
  text: string[];
  eyebrow?: string;
  band?: boolean;
  /** Foto de fondo a todo el ancho, con velo azul */
  image?: ImageMetadata;
  imageAlt?: string;
  /** Botón al formulario debajo del texto */
  cta?: string;
  /** @deprecated se mantiene por compatibilidad */
  surface?: boolean;
}

const { id, title, text, eyebrow, band = false, image, imageAlt = '', cta } = Astro.props;
import BrandPhoto from '@/components/ui/BrandPhoto.astro';
---

<section class:list={['section-wide', { 'band-soft': band && !image, photo: image }]} aria-labelledby={id}>
  <div class="page">
    <div class="box" data-reveal>
      <span class="mark" aria-hidden="true"></span>
      <header class="section-head">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h2 id={id}>{title}</h2>
      </header>
      <div class="copy">
        {text.map((t) => <p>{t}</p>)}
        {cta && <FormButton label={cta} icon />}
      </div>
      {image && (
        <div class="shot"><BrandPhoto src={image} alt={imageAlt} caption={eyebrow} ratio="3/2" /></div>
      )}
    </div>
  </div>
</section>

<style>
  /* Con foto: fondo azul de la marca, texto a la izquierda y la foto completa en tarjeta (sin recortes ni ampliar) */
  .photo { position: relative; isolation: isolate; overflow: hidden; background-image: var(--gradient-brand); }
  .photo .box { background-color: transparent; box-shadow: none; padding: 0; overflow: visible; }
  .photo .mark { display: none; }
  .photo h2 { color: var(--paper-0); }
  .photo .eyebrow { background-color: rgb(255 255 255 / 0.14); color: var(--gold-400); }
  .photo .copy p { color: var(--navy-100); }
  .shot { position: relative; margin: 0; }
  .shot :global(img) { position: relative; z-index: 1; display: block; inline-size: 100%; block-size: auto; aspect-ratio: 1103 / 730; object-fit: cover; border-radius: calc(var(--radius-card) + 0.35rem); box-shadow: 0 34px 70px -30px rgb(0 0 0 / 0.7); }
  /* Marco fino desplazado detrás de la foto y una etiqueta flotante, en lugar del bloque naranja */
  .shot::before { content: ''; position: absolute; inset: 1.1rem -1.1rem -1.1rem 1.1rem; border-radius: calc(var(--radius-card) + 0.35rem); border: 1.5px solid rgb(255 255 255 / 0.28); }
  .shot figcaption { position: absolute; z-index: 2; inset-block-end: 1.1rem; inset-inline-start: -1rem; display: inline-flex; align-items: center; gap: 0.55em; padding: 0.55em 1em; border-radius: var(--radius-pill); background-color: var(--paper-0); color: var(--navy-700); font-size: var(--step-small); font-weight: var(--weight-bold); box-shadow: 0 16px 34px -14px rgb(0 0 0 / 0.55); }
  @media (max-width: 63.99em) {
    .shot { margin-inline-end: 0.6rem; }
    .shot::before { inset: 0.6rem -0.6rem -0.6rem 0.6rem; }
    .shot figcaption { inset-inline-start: 0.75rem; inset-block-end: 0.75rem; }
  }
  .shot figcaption::before { content: ''; inline-size: 0.55rem; block-size: 0.55rem; border-radius: 50%; background-color: var(--orange-500); box-shadow: 0 0 0 4px rgb(254 143 1 / 0.22); }
  .box {
    position: relative;
    display: grid;
    gap: var(--space-m) var(--gutter);
    padding: var(--space-l);
    overflow: hidden;
    border-radius: calc(var(--radius-card) + 0.35rem);
    background-color: var(--paper-0);
    box-shadow: var(--shadow-card);
  }
  .mark { position: absolute; inset: 0 auto 0 0; inline-size: 5px; background-image: var(--gradient-warm); }
  .section-head { max-inline-size: none; }
  .section-head h2 { max-inline-size: 26ch; }
  .copy { display: grid; gap: var(--space-s); justify-items: start; }
  .copy :global(.button) { gap: 0.55em; margin-block-start: var(--space-2xs); border-radius: var(--radius-pill); }
  .copy p { color: var(--color-text-soft); font-size: var(--step-lead); line-height: var(--leading-lead); max-inline-size: 68ch; }

  @media (min-width: 64em) {
    .box { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; padding: var(--space-xl); }
    .photo .box { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); grid-template-rows: auto auto; column-gap: var(--space-2xl); padding: 0; }
    .photo .section-head { grid-column: 1; grid-row: 1; align-self: end; }
    .photo .copy { grid-column: 1; grid-row: 2; align-self: start; }
    .photo .shot { grid-column: 2; grid-row: 1 / span 2; }
  }
</style>
