---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  title: string;
  text: string[];
  eyebrow?: string;
  band?: boolean;
  /** Foto de fondo a todo el ancho, con velo azul */
  image?: ImageMetadata;
  imageAlt?: string;
  /** @deprecated se mantiene por compatibilidad */
  surface?: boolean;
}

const { id, title, text, eyebrow, band = false, image, imageAlt = '' } = Astro.props;
---

<section class:list={['section-wide', { 'band-soft': band && !image, photo: image }]} aria-labelledby={id}>
  <div class="page">
    <div class="box" data-reveal>
      <span class="mark" aria-hidden="true"></span>
      <header class="section-head">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h2 id={id}>{title}</h2>
      </header>
      <div class="copy">
        {text.map((t) => <p>{t}</p>)}
      </div>
      {image && (
        <figure class="shot">
          <Image src={image} alt={imageAlt} widths={[560, 800, 1103]} sizes="(min-width: 64em) 45vw, 100vw" quality={88} />
        </figure>
      )}
    </div>
  </div>
</section>

<style>
  /* Con foto: fondo azul de la marca, texto a la izquierda y la foto completa en tarjeta (sin recortes ni ampliar) */
  .photo { position: relative; isolation: isolate; overflow: hidden; background-image: radial-gradient(40rem 26rem at 85% 30%, rgb(254 143 1 / 0.18), transparent 70%), var(--gradient-brand); }
  .photo .box { background-color: transparent; box-shadow: none; padding: 0; overflow: visible; }
  .photo .mark { display: none; }
  .photo h2 { color: var(--paper-0); }
  .photo .eyebrow { background-color: rgb(255 255 255 / 0.14); color: var(--gold-400); }
  .photo .copy p { color: var(--navy-100); }
  .shot { position: relative; margin: 0; }
  .shot :global(img) { display: block; inline-size: 100%; block-size: auto; aspect-ratio: 1103 / 730; object-fit: cover; border-radius: calc(var(--radius-card) + 0.35rem); box-shadow: 0 30px 60px -24px rgb(0 0 0 / 0.6), 0 0 0 6px rgb(255 255 255 / 0.08); }
  .shot::before { content: ''; position: absolute; inset: -0.9rem auto auto -0.9rem; z-index: -1; inline-size: 40%; block-size: 50%; border-radius: var(--radius-card); background-image: var(--gradient-warm); opacity: 0.9; }
  .box {
    position: relative;
    display: grid;
    gap: var(--space-m) var(--gutter);
    padding: var(--space-l);
    overflow: hidden;
    border-radius: calc(var(--radius-card) + 0.35rem);
    background-color: var(--paper-0);
    box-shadow: var(--shadow-card);
  }
  .mark { position: absolute; inset: 0 auto 0 0; inline-size: 5px; background-image: var(--gradient-warm); }
  .section-head { max-inline-size: none; }
  .section-head h2 { max-inline-size: 26ch; }
  .copy { display: grid; gap: var(--space-s); }
  .copy p { color: var(--color-text-soft); font-size: var(--step-lead); line-height: var(--leading-lead); max-inline-size: 68ch; }

  @media (min-width: 64em) {
    .box { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; padding: var(--space-xl); }
    .photo .box { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); grid-template-rows: auto auto; column-gap: var(--space-2xl); padding: 0; }
    .photo .section-head { grid-column: 1; grid-row: 1; align-self: end; }
    .photo .copy { grid-column: 1; grid-row: 2; align-self: start; }
    .photo .shot { grid-column: 2; grid-row: 1 / span 2; }
  }
</style>
