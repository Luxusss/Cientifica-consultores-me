---
import type { Faq } from '@/data/faq';

interface Props {
  items: Faq[];
  title?: string;
  id?: string;
  intro?: string;
}

const { items, title = 'Preguntas frecuentes', id = 'preguntas', intro } = Astro.props;
---

<section class="section-wide page stack stack-xl" aria-labelledby={id}>
  <header class:list={['split split-end', { 'split-wide': title.length > 30 }]} data-reveal>
    <h2 id={id}>{title}</h2>
    {intro && <p class="text-lead">{intro}</p>}
  </header>
  <dl class="answers" data-reveal="stagger">
    {items.map((item) => (
      <div>
        <dt>{item.question}</dt>
        <dd>{item.answer}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .answers { columns: 3 22rem; column-gap: var(--gutter); }
  .answers div { display: grid; gap: var(--space-xs); break-inside: avoid; margin-block-end: var(--space-xl); }
  dt { font-size: var(--step-lead); line-height: var(--leading-head); font-weight: var(--weight-medium); letter-spacing: var(--tracking-head); }
  dd { color: var(--color-text-soft); }
</style>
