---
import Icon from '@/components/ui/Icon.astro';
import FormButton from '@/components/ui/FormButton.astro';

interface Props {
  id: string;
  title: string;
  intro?: string;
  items: string[];
  eyebrow?: string;
  band?: boolean;
  /** Panel a la izquierda con una pregunta y su respuesta (la lista va a la derecha) */
  aside?: { title: string; text: string };
  /** Tarjetas grandes con ícono, en fila */
  variant?: 'icons';
  /** @deprecated se mantiene por compatibilidad */
  surface?: boolean;
}

const { id, title, intro, items, eyebrow, band = false, aside, variant } = Astro.props;
const icons = ['badge', 'shield', 'clock', 'user', 'check', 'chat'] as const;
---

<section class:list={['section-wide', { 'band-soft': band }]} aria-labelledby={id}>
  {aside ? (
    <div class="page split-list">
      <div class="aside" data-reveal>
        <span class="eyebrow">Para empezar</span>
        <h2 class="aside-title">{aside.title}</h2>
        <p>{aside.text}</p>
        <FormButton label="Quiero mi asesoría gratis" icon />
      </div>
      <div class="list-side">
        <h2 id={id} class="list-title" data-reveal>{title}</h2>
        {intro && <p class="list-intro">{intro}</p>}
        <ul class="items stacked" role="list" data-reveal="stagger">
          {items.map((item, i) => (
            <li class:list={['item', i % 2 ? 'tone-6' : 'tone-1']}>
              <span class="check" aria-hidden="true"><Icon name="check" size="1.1rem" /></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  ) : (
    <div class="page stack stack-xl">
      <header class="section-head center" data-reveal>
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h2 id={id}>{title}</h2>
        {intro && <p>{intro}</p>}
      </header>
      {variant === 'icons' ? (
        <ul class:list={['tiles', `n-${items.length}`]} role="list" data-reveal="stagger">
          {items.map((item, i) => (
            <li class:list={['tile', i % 2 ? 'tone-6' : 'tone-1']}>
              <span class="tile-icon" aria-hidden="true"><Icon name={icons[i % icons.length]} size="1.5rem" /></span>
              <p>{item}</p>
              <span class="tile-bar" aria-hidden="true"></span>
            </li>
          ))}
        </ul>
      ) : (
        <ul class="items" role="list" data-reveal="stagger">
          {items.map((item, i) => (
            <li class:list={['item', i % 2 ? 'tone-6' : 'tone-1']}>
              <span class="check" aria-hidden="true"><Icon name="check" size="1.1rem" /></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  )}
</section>

<style>
  .items { display: grid; gap: var(--space-s); grid-template-columns: 1fr; }
  .item { display: flex; align-items: center; gap: var(--space-s); padding: var(--space-s) var(--space-m); border-radius: var(--radius-card); background-color: var(--paper-0); box-shadow: var(--shadow-card); font-size: var(--step-body); font-weight: var(--weight-medium); line-height: var(--leading-body); transition: opacity var(--duration-reveal) var(--ease-expo), transform var(--duration-reveal) var(--ease-expo), translate var(--duration-ui) var(--ease-out); }
  .check { display: grid; place-items: center; flex-shrink: 0; inline-size: 2.2rem; block-size: 2.2rem; border-radius: 50%; background-image: var(--tone-grad); color: var(--paper-0); }
  @media (min-width: 48em) { .items:not(.stacked) { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* Variante con íconos: tarjetas en fila */
  .tiles { display: grid; gap: var(--space-s); grid-template-columns: 1fr; }
  .tile { position: relative; display: grid; gap: var(--space-s); align-content: start; padding: var(--space-l) var(--space-m) var(--space-m); overflow: hidden; border-radius: calc(var(--radius-card) + 0.25rem); background-color: var(--paper-0); box-shadow: var(--shadow-card); transition: opacity var(--duration-reveal) var(--ease-expo), transform var(--duration-reveal) var(--ease-expo), translate var(--duration-ui) var(--ease-out), box-shadow var(--duration-ui) ease; }
  .tile-icon { display: grid; place-items: center; inline-size: 3.4rem; block-size: 3.4rem; border-radius: 1rem; background-image: var(--tone-grad); color: var(--paper-0); box-shadow: 0 12px 24px -12px var(--tone); }
  .tile p { font-size: var(--step-title); font-weight: var(--weight-semibold); line-height: 1.3; color: var(--ink-900); }
  .tile-bar { position: absolute; inset: auto 0 0; block-size: 4px; background-image: var(--tone-grad); transform: scaleX(0.3); transform-origin: left; transition: transform var(--duration-reveal) var(--ease-out); }
  @media (min-width: 40em) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64em) { .tiles.n-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); } .tiles.n-3, .tiles.n-6 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (hover: hover) and (pointer: fine) {
    .tile:hover { translate: 0 -5px; box-shadow: var(--shadow-lift); }
    .tile:hover .tile-bar { transform: scaleX(1); }
  }

  /* Variante con panel: pregunta a la izquierda, lo que incluye a la derecha */
  .split-list { display: grid; gap: var(--space-l) var(--gutter); align-items: center; }
  .aside { position: relative; display: grid; gap: var(--space-s); justify-items: start; padding: var(--space-l); overflow: hidden; border-radius: calc(var(--radius-card) + 0.5rem); background-image: radial-gradient(24rem 16rem at 100% 100%, rgb(254 143 1 / 0.3), transparent 70%), var(--gradient-brand); color: var(--paper-0); box-shadow: var(--shadow-lift); }
  .aside::after { content: ''; position: absolute; inset: -6rem -6rem auto auto; inline-size: 16rem; block-size: 16rem; border-radius: 50%; border: 2px solid rgb(255 255 255 / 0.08); }
  .aside .eyebrow { background-color: rgb(255 255 255 / 0.12); color: var(--gold-400); }
  .aside-title { color: var(--paper-0); font-size: var(--step-head); line-height: 1.12; }
  .aside p { color: var(--navy-100); font-size: var(--step-lead); line-height: var(--leading-lead); }
  .aside :global(.button) { gap: 0.55em; margin-block-start: var(--space-2xs); border-radius: var(--radius-pill); }
  .list-side { display: grid; gap: var(--space-s); }
  .list-title { font-size: var(--step-head); line-height: 1.15; }
  .list-intro { color: var(--color-text-soft); }
  .stacked { gap: var(--space-xs); }
  .stacked .item { padding-block: 0.7rem; }

  @media (min-width: 64em) {
    .split-list { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .aside { padding: var(--space-xl); }
    .stacked { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (hover: hover) and (pointer: fine) {
    .item:hover { translate: 4px 0; }
  }
</style>
