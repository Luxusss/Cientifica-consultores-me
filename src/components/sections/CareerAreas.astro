---
import { careerAreas } from '@/data/servicePages';
---

<section class="section page split" aria-labelledby="carreras">
  <header class="stack" data-reveal>
    <h2 id="carreras">Un asesor de tu carrera</h2>
    <p>Accede a asesoría personalizada según tu disciplina, con especialistas para cada carrera.</p>
  </header>
  <div class="cols" data-reveal="stagger">
    {careerAreas.map((area) => (
      <div>
        <h3>{area.name}</h3>
        <p class="text-soft">{area.careers.join(', ')}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .cols { display: grid; gap: var(--space-l) var(--gutter); grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  .cols h3 { font-weight: var(--weight-semibold); margin-block-end: var(--space-2xs); }
</style>
