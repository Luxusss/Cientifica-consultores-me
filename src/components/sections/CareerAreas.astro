---
import Icon from '@/components/ui/Icon.astro';
import { careerAreas } from '@/data/servicePages';

interface Props {
  title?: string;
  intro?: string;
  prefix?: string;
  eyebrow?: string;
  band?: boolean;
}

const { title = 'Un asesor de tu carrera', intro = 'Accede a asesoría personalizada según tu disciplina, con especialistas para cada carrera.', prefix = '', eyebrow = 'Por carrera', band = false } = Astro.props;
const icons = ['bolt', 'pen', 'users', 'shield'] as const;
---

<section class:list={['section-wide', { 'band-soft': band }]} aria-labelledby="carreras">
  <div class="page stack stack-xl">
    <header class="section-head center" data-reveal>
      <span class="eyebrow">{eyebrow}</span>
      <h2 id="carreras">{title}</h2>
      <p>{intro}</p>
    </header>
    <ul class="cols" role="list" data-reveal="stagger">
      {careerAreas.map((area, i) => (
        <li class:list={['area', i % 2 ? 'tone-6' : 'tone-1']}>
          <span class="icon" aria-hidden="true"><Icon name={icons[i % icons.length]} size="1.3rem" /></span>
          <h3>{prefix}{prefix ? area.name.toLowerCase() : area.name}</h3>
          <ul class="chips" role="list">
            {area.careers.map((c) => <li>{c}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cols { display: grid; gap: var(--space-s); grid-template-columns: 1fr; }
  .area { position: relative; display: grid; gap: var(--space-s); align-content: start; padding: var(--space-m); overflow: hidden; border-radius: var(--radius-card); background-color: var(--paper-0); box-shadow: var(--shadow-card); transition: opacity var(--duration-reveal) var(--ease-expo), transform var(--duration-reveal) var(--ease-expo), translate var(--duration-ui) var(--ease-out), box-shadow var(--duration-ui) var(--ease-out); }
  .area::before { content: ''; position: absolute; inset: 0 0 auto; block-size: 4px; background-image: var(--tone-grad); }
  .icon { display: grid; place-items: center; inline-size: 2.75rem; block-size: 2.75rem; border-radius: 0.9rem; background-image: var(--tone-grad); color: var(--paper-0); }
  h3 { font-size: var(--step-title); line-height: 1.25; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .chips li { padding: 0.35em 0.75em; border-radius: var(--radius-pill); background-color: var(--tone-soft); color: var(--ink-600); font-size: var(--step-small); font-weight: var(--weight-semibold); }

  @media (min-width: 40em) { .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64em) { .cols { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (hover: hover) and (pointer: fine) {
    .area:hover { translate: 0 -4px; box-shadow: var(--shadow-lift); }
  }
</style>
