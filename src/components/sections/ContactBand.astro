---
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';
import { site } from '@/config/site';

interface Props {
  title?: string;
  text?: string;
}

const { title = '¿Empezamos tu tesis?', text = `Cuéntanos tu universidad, tu grado y tu fecha de entrega, y te decimos cómo podemos ayudarte. Respondemos en ${site.replyTime}.` } = Astro.props;
---

<section class="contact theme-surface section-wide" aria-labelledby="contacto">
  <div class="page inner">
    <div class="pitch stack stack-l" data-reveal>
      <h2 class="statement" id="contacto">{title}</h2>
      <p class="text-lead">{text}</p>
      <WhatsAppButton />
    </div>
    <div class="card" data-reveal>
      <div class="reach">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <p class="meta">WhatsApp {site.phone.display} · {site.address.district}, {site.address.city}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .inner { display: grid; gap: var(--space-xl) var(--gutter); align-items: end; }
  .pitch { justify-items: start; }
  .statement {
    max-inline-size: none;
    font-size: var(--step-head);
    line-height: var(--leading-head);
    letter-spacing: var(--tracking-head);
    font-weight: var(--weight-medium);
  }
  .card { display: grid; gap: var(--space-s); padding: var(--space-l); border-inline-start: 3px solid var(--orange-500); background-color: var(--color-surface); border-radius: var(--radius); }
  .reach { display: grid; gap: var(--space-3xs); }
  .reach a { font-size: var(--step-lead); overflow-wrap: anywhere; }
  .meta { color: var(--color-text-soft); font-size: var(--step-small); }

  @media (min-width: 64em) {
    .inner { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .pitch { grid-column: 1 / span 7; }
    .card { grid-column: 8 / -1; }
  }
</style>
