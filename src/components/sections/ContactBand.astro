---
import { Image } from 'astro:assets';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';
import { site } from '@/config/site';
import portrait from '@/assets/images/otros/asesor-de-tesis-de-maestria-cientifica-consultores.jpg';
---

<section class="contact theme-surface section-wide" aria-labelledby="contacto">
  <div class="page inner">
    <div class="pitch stack stack-l" data-reveal>
      <p class="statement" id="contacto">¿Empezamos tu tesis?</p>
      <p class="text-lead">Cuéntanos tu universidad, tu grado y tu fecha de entrega, y te decimos cómo podemos ayudarte. Respondemos en {site.replyTime}.</p>
      <WhatsAppButton />
    </div>
    <div class="card" data-reveal>
      <Image src={portrait} alt="Asesor de Científica Consultores en la biblioteca" widths={[360, 540, 720]} sizes="(min-width: 64em) 28vw, 100vw" class="portrait" />
      <div class="reach">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <p class="meta">WhatsApp {site.phone.display} · {site.address.district}, {site.address.city}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .inner { display: grid; gap: var(--space-xl) var(--gutter); align-items: end; }
  .pitch { justify-items: start; }
  .statement {
    max-inline-size: none;
    font-size: var(--step-head);
    line-height: var(--leading-head);
    letter-spacing: var(--tracking-head);
    font-weight: var(--weight-medium);
  }
  .card { display: grid; gap: var(--space-s); }
  .portrait { inline-size: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 25%; }
  .reach { display: grid; gap: var(--space-3xs); }
  .reach a { font-size: var(--step-body); overflow-wrap: anywhere; }
  .meta { color: var(--color-text-soft); font-size: var(--step-small); }

  @media (min-width: 64em) {
    .inner { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .pitch { grid-column: 1 / span 7; }
    .card { grid-column: 8 / -1; }
  }
</style>
