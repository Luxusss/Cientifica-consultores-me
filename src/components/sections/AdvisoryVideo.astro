---
interface Props {
  featured?: boolean;
}
const { featured = false } = Astro.props;
---

<figure class:list={['video', { featured }]} data-reveal data-video>
  <div class="frame">
    <video controls={!featured} preload="none" playsinline poster="/videos/thumbnail-asesorias.jpg" width="1280" height="720" data-video-el>
      <source src="/videos/Asi-son-nuestras-asesorias.mp4" type="video/mp4" />
    </video>
    {featured && (
      <button type="button" class="play" aria-label="Reproducir el video: Así son nuestras asesorías" data-video-play>
        <span class="ring" aria-hidden="true"></span>
        <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
      </button>
    )}
  </div>
  {!featured && <figcaption>Así son nuestras asesorías</figcaption>}
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-video]')) {
    const video = root.querySelector<HTMLVideoElement>('[data-video-el]');
    const play = root.querySelector<HTMLButtonElement>('[data-video-play]');
    if (!video || !play) continue;
    play.addEventListener('click', () => {
      video.controls = true;
      root.classList.add('is-playing');
      void video.play();
      video.focus();
    });
  }
</script>

<style>
  .video { display: grid; gap: var(--space-2xs); }
  .frame { position: relative; overflow: hidden; border-radius: var(--radius-card); background-color: var(--ink-900); }
  .video video { display: block; inline-size: 100%; block-size: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .video figcaption { font-size: var(--step-small); color: var(--color-text-soft); }

  .featured .frame { box-shadow: 0 0 0 6px var(--paper-0), 0 40px 80px -30px rgb(29 45 140 / 0.55); }
  .featured .frame::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgb(19 24 61 / 0.55)); pointer-events: none; transition: opacity var(--duration-ui) ease; }
  .featured.is-playing .frame::after { opacity: 0; }
  .play {
    position: absolute;
    z-index: 1;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    inline-size: 5rem;
    block-size: 5rem;
    border-radius: 50%;
    background-image: var(--gradient-warm);
    color: var(--paper-0);
    box-shadow: 0 16px 40px -12px rgb(254 143 1 / 0.7);
    transition: transform var(--duration-ui) var(--ease-out);
  }
  .play svg { translate: 2px 0; }
  .ring { position: absolute; inset: -10px; border-radius: 50%; border: 2px solid rgb(255 255 255 / 0.7); }
  .is-playing .play { display: none; }

  @media (prefers-reduced-motion: no-preference) {
    .ring { animation: ring 2.4s ease-out infinite; }
    @keyframes ring { from { transform: scale(0.85); opacity: 1; } to { transform: scale(1.35); opacity: 0; } }
  }
  @media (hover: hover) and (pointer: fine) {
    .play:hover { transform: scale(1.08); }
  }
</style>
