---
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';

interface Props {
  id: string;
  title: string;
  text?: string;
}

const { id, title, text } = Astro.props;
---

<section class="theme-field section-wide" aria-labelledby={id}>
  <div class="page inner" data-reveal="stagger">
    <h2 id={id}>{title}</h2>
    <div class="side stack stack-m">
      {text && <p class="text-lead">{text}</p>}
      <WhatsAppButton label="Solicitar presupuesto gratuito" />
    </div>
  </div>
</section>

<style>
  .inner { display: grid; gap: var(--space-l) var(--gutter); align-items: end; }
  h2 { max-inline-size: 24ch; }
  .side { justify-items: start; }

  @media (min-width: 64em) {
    .inner { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    h2 { grid-column: 1 / span 8; }
    .side { grid-column: 9 / -1; }
  }
</style>
