---
import FormButton from '@/components/ui/FormButton.astro';

interface Props {
  id: string;
  title: string;
  text?: string;
  band?: boolean;
}

const { id, title, text, band = false } = Astro.props;
---

<section class:list={['section-wide', { 'band-soft': band }]} aria-labelledby={id}>
  <div class="page">
    <div class="panel" data-reveal>
      <div class="copy">
        <span class="eyebrow">Presupuesto sin costo</span>
        <h2 id={id}>{title}</h2>
        {text && <p>{text}</p>}
      </div>
      <FormButton label="Solicitar presupuesto gratuito" icon />
    </div>
  </div>
</section>

<style>
  .panel { display: grid; gap: var(--space-m) var(--gutter); align-items: center; padding: var(--space-l); border-radius: calc(var(--radius-card) + 0.5rem); background-image: var(--gradient-brand); color: var(--paper-0); box-shadow: var(--shadow-lift); }
  .copy { display: grid; gap: var(--space-xs); justify-items: start; }
  .copy .eyebrow { background-color: rgb(255 255 255 / 0.12); color: var(--gold-400); }
  h2 { color: var(--paper-0); max-inline-size: 26ch; }
  p { color: var(--navy-100); font-size: var(--step-lead); max-inline-size: 56ch; }
  .panel :global(.button) { gap: 0.55em; justify-self: start; border-radius: var(--radius-pill); }
  @media (min-width: 64em) {
    .panel { grid-template-columns: minmax(0, 1fr) auto; padding: var(--space-xl); }
  }
</style>
